{% doc %}
  @prompt
    cire um liquid personalizado de avaliação , customizado, é obrigadtorio ter
    
    <div data-neverx-reviews data-mode="summary" data-channel="shopify" data-external="{{ product.id }}"></div>
    <script async src="https://app.neverxcrm.online/api/public/reviews/feed/u9etWTHEwp28nOEx85T-aqpb/widget"></script>
    
    quero extremamente bonito e bem feito. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-review-summary-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: {{ block.settings.padding }}px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-review-summary-{{ ai_gen_id }}__inner {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ai-review-summary-{{ ai_gen_id }}__mark {
    display: grid;
    place-items: center;
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: {{ block.settings.accent_color }};
    background: {{ block.settings.icon_background }};
  }

  .ai-review-summary-{{ ai_gen_id }}__mark svg {
    width: 21px;
    height: 21px;
  }

  .ai-review-summary-{{ ai_gen_id }}__copy {
    min-width: 0;
  }

  .ai-review-summary-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 4px;
    color: {{ block.settings.muted_color }};
    font: 600 10px/1.4 {{ settings.type_body_font.family }}, sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .ai-review-summary-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font: 500 {{ block.settings.heading_size }}px/1.25 {{ settings.type_display_font.family }}, serif;
  }

  .ai-review-summary-{{ ai_gen_id }}__description {
    margin-top: 5px;
    color: {{ block.settings.muted_color }};
    font: 400 13px/1.5 {{ settings.type_body_font.family }}, sans-serif;
  }

  .ai-review-summary-{{ ai_gen_id }}__widget {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid {{ block.settings.border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-review-summary-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px;
      width: 100%;
    }

    .ai-review-summary-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }
  }
{% endstyle %}

<div class="ai-review-summary-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-review-summary-{{ ai_gen_id }}__inner">
    <span class="ai-review-summary-{{ ai_gen_id }}__mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="m12 3 2.7 5.47 6.03.88-4.36 4.25 1.03 6.01L12 16.77l-5.4 2.84 1.03-6.01L3.27 9.35l6.03-.88L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <div class="ai-review-summary-{{ ai_gen_id }}__copy">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-review-summary-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 class="ai-review-summary-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
      {% if block.settings.description != blank %}
        <div class="ai-review-summary-{{ ai_gen_id }}__description">{{ block.settings.description | escape }}</div>
      {% endif %}
    </div>
  </div>
  <div class="ai-review-summary-{{ ai_gen_id }}__widget">
    <div data-neverx-reviews data-mode="summary" data-channel="shopify" data-external="{{ product.id }}"></div>
    <script async src="https://app.neverxcrm.online/api/public/reviews/feed/u9etWTHEwp28nOEx85T-aqpb/widget"></script>
  </div>
</div>

{% schema %}
{
  "name": "Resumo de avaliações",
  "settings": [
    { "type": "header", "content": "Conteúdo" },
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "OPINIÕES DE CLIENTES" },
    { "type": "text", "id": "heading", "label": "Título", "default": "O que dizem sobre esta peça" },
    { "type": "text", "id": "description", "label": "Descrição", "default": "Avaliações de quem já escolheu este produto." },
    { "type": "header", "content": "Aparência" },
    { "type": "range", "id": "desktop_width_percent", "label": "Largura no desktop", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size", "label": "Título no desktop", "min": 16, "max": 32, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "mobile_heading_size", "label": "Título no celular", "min": 14, "max": 26, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "padding", "label": "Espaçamento interno", "min": 12, "max": 40, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_padding", "label": "Espaçamento no celular", "min": 8, "max": 28, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "corner_radius", "label": "Arredondamento", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "color", "id": "background_color", "label": "Fundo", "default": "#F7F7F5" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#0A0A0A" },
    { "type": "color", "id": "muted_color", "label": "Texto secundário", "default": "#4A4A46" },
    { "type": "color", "id": "border_color", "label": "Borda", "default": "#E4E4E0" },
    { "type": "color", "id": "accent_color", "label": "Ícone", "default": "#80631F" },
    { "type": "color", "id": "icon_background", "label": "Fundo do ícone", "default": "#EFEFEC" }
  ],
  "presets": [{ "name": "Resumo de avaliações" }],
  "tag": null,
  "class": "review-summary-block"
}
{% endschema %}