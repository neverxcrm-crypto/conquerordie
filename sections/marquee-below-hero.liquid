{%- comment -%}
  ============================================================
  MARQUEE BELOW HERO — Barra de Anúncios Infinita (Corrigida)
  ============================================================
{%- endcomment -%}

{%- liquid
  assign avisos = section.blocks
  assign total = avisos.size
  assign velocidade = section.settings.speed | default: 25

  # Multiplicador inteligente: mantém o tamanho físico da faixa parecido
  # independentemente de quantos blocos você cadastrou, o que garante 
  # que a "velocidade visual" do texto seja sempre consistente.
  assign repeat_count = 2
  if total == 1
    assign repeat_count = 12
  elsif total == 2
    assign repeat_count = 6
  elsif total == 3
    assign repeat_count = 4
  elsif total == 4
    assign repeat_count = 3
  endif
-%}

<section
  class="marquee-hero{% if section.settings.enable_gold_effect %} marquee-hero--ouro{% endif %}"
  data-section-id="{{ section.id }}"
  aria-label="{{ 'sections.announcement.label' | t | default: 'Anúncios' }}"
  style="
    --marquee-bg: {{ section.settings.bg_color }};
    --marquee-cor: {{ section.settings.text_color }};
    --marquee-cor-separador: {{ section.settings.separator_color }};
    --marquee-fonte: {{ section.settings.font_size }}px;
    --marquee-peso: {{ section.settings.font_weight }};
    --marquee-caixa: {{ section.settings.text_transform }};
    --marquee-tracking: {{ section.settings.letter_spacing }}px;
    --marquee-italico: {% if section.settings.enable_italic %}italic{% else %}normal{% endif %};
    --marquee-duracao: {{ velocidade }}s;
    --marquee-padding-v: {{ section.settings.padding_vertical }}px;
    --marquee-border-color: {{ section.settings.border_color }};
    --marquee-gap: {{ section.settings.item_gap }}px;
  "
>
  <div class="marquee-hero__track">
    {%- if total > 0 -%}
      {%- comment -%} Criação de 2 grupos perfeitamente idênticos para o looping {%- endcomment -%}
      {%- for g in (1..2) -%}
        <div class="marquee-hero__group" {% if g == 2 %}aria-hidden="true"{% endif %}>
          {%- for r in (1..repeat_count) -%}
            {%- for block in avisos -%}
              <div class="marquee-hero__item" {{ block.shopify_attributes }}>
                
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="marquee-hero__texto marquee-hero__texto--link tap-target" {% if g == 2 %}tabindex="-1"{% endif %}>
                    <span>{{ block.settings.text | escape }}</span>
                    {%- if section.settings.show_arrow -%}
                      <svg class="marquee-hero__seta" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M3 9l6-6M4 3h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- endif -%}
                  </a>
                {%- else -%}
                  <span class="marquee-hero__texto">{{ block.settings.text | escape }}</span>
                {%- endif -%}

                <span class="marquee-hero__separador" aria-hidden="true">
                  {%- case section.settings.separator_symbol -%}
                    {%- when 'circle_outline' -%}
                      <svg class="marquee-hero__icon" viewBox="0 0 12 12" fill="none">
                        <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.5"/>
                      </svg>
                    {%- when 'circle_filled' -%}
                      <svg class="marquee-hero__icon" viewBox="0 0 12 12" fill="currentColor">
                        <circle cx="6" cy="6" r="4"/>
                      </svg>
                    {%- when 'star' -%}
                      <svg class="marquee-hero__icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    {%- else -%}
                      <span class="marquee-hero__char">{{ section.settings.separator_custom | default: '•' }}</span>
                  {%- endcase -%}
                </span>

              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}

    {%- else -%}
      {%- comment -%} Demonstração prévia no painel caso não tenha blocos {%- endcomment -%}
      {%- for g in (1..2) -%}
        <div class="marquee-hero__group" {% if g == 2 %}aria-hidden="true"{% endif %}>
          {%- for i in (1..6) -%}
            <div class="marquee-hero__item">
              <span class="marquee-hero__texto">ADICIONE UM AVISO NO PAINEL</span>
              <span class="marquee-hero__separador" aria-hidden="true">
                <svg class="marquee-hero__icon" viewBox="0 0 12 12" fill="none"><circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.5"/></svg>
              </span>
            </div>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<style>
  /* ==========================================================
     ESTRUTURA BASE E TRACK
     ========================================================== */
  .marquee-hero {
    display: block;
    position: relative;
    z-index: 9;
    background-color: var(--marquee-bg, #000000);
    border-top: 1px solid var(--marquee-border-color, rgba(255, 255, 255, 0.15));
    border-bottom: 1px solid var(--marquee-border-color, rgba(255, 255, 255, 0.15));
    overflow: hidden;
    user-select: none;
    padding-block: var(--marquee-padding-v, 12px);
    width: 100%;
  }

  .marquee-hero__track {
    display: flex;
    align-items: center;
    width: 100%;
  }

  /* ==========================================================
     ANIMAÇÃO PERFEITA: Os GRUPOS se movem, não a Track
     ========================================================== */
  .marquee-hero__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    min-width: 100%;
    /* max-content garante que a caixa envolva todo o texto sem quebrar linha */
    width: max-content; 
    will-change: transform;
    animation: marquee-hero-loop var(--marquee-duracao, 25s) linear infinite;
  }

  @keyframes marquee-hero-loop {
    0% { transform: translate3d(0, 0, 0); }
    /* Move exatamente o tamanho de UM grupo. O segundo grupo toma o lugar perfeitamente. */
    100% { transform: translate3d(-100%, 0, 0); } 
  }

  /* Pausa a rotação ao passar o cursor (Apenas Desktop) */
  @media (hover: hover) {
    .marquee-hero:hover .marquee-hero__group {
      animation-play-state: paused;
    }
  }

  /* Acessibilidade: Desliga a animação para quem tem "Reduzir Movimento" ativado no PC/Celular */
  @media (prefers-reduced-motion: reduce) {
    .marquee-hero__group {
      animation: none !important;
      width: 100%;
      min-width: 0;
      flex-wrap: wrap;
      justify-content: center;
    }
    .marquee-hero__group[aria-hidden="true"] {
      display: none; /* Esconde o segundo grupo duplicado */
    }
  }

  /* ==========================================================
     ITENS E TIPOGRAFIA
     ========================================================== */
  .marquee-hero__item {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .marquee-hero__texto {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body-family, inherit);
    font-size: var(--marquee-fonte, 13px);
    font-style: var(--marquee-italico, normal);
    font-weight: var(--marquee-peso, 700);
    text-transform: var(--marquee-caixa, uppercase);
    letter-spacing: var(--marquee-tracking, 1.4px);
    color: var(--marquee-cor, #ffffff);
    text-decoration: none;
    line-height: 1;
    -webkit-font-smoothing: antialiased;
    transition: opacity 0.2s ease;
  }

  .marquee-hero__texto--link:hover {
    opacity: 0.8;
  }

  /* SEPARADORES (Bolinhas, Estrelas, etc) */
  .marquee-hero__separador {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-inline: var(--marquee-gap, 28px);
    color: var(--marquee-cor-separador, #ffffff);
    opacity: 0.8;
  }

  .marquee-hero__icon {
    width: 12px;
    height: 12px;
    display: block;
  }

  .marquee-hero__char {
    font-size: var(--marquee-fonte, 13px);
    line-height: 1;
  }

  /* ==========================================================
     EFEITOS ESPECIAIS (Ouro e Seta)
     ========================================================== */
  .marquee-hero--ouro .marquee-hero__texto {
    background: linear-gradient(100deg, #FBF0B9 0%, #E3C98B 28%, #C9A24D 55%, #E9D49A 82%, #FBF0B9 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .marquee-hero--ouro .marquee-hero__seta {
    color: #C9A24D;
    -webkit-text-fill-color: currentColor;
  }

  .marquee-hero__seta {
    width: 10px;
    height: 10px;
    flex: none;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .marquee-hero__texto--link:hover .marquee-hero__seta {
    transform: translate(3px, -3px) scale(1.1);
  }

  /* ==========================================================
     RESPONSIVIDADE (Celular)
     ========================================================== */
  @media screen and (max-width: 749px) {
    .marquee-hero {
      /* Reduz levemente o padding em telas pequenas para economizar espaço */
      padding-block: max(8px, calc(var(--marquee-padding-v, 12px) - 3px));
    }
    .marquee-hero__texto {
      /* Texto um pouco menor no celular para caber melhor na tela */
      font-size: max(11px, calc(var(--marquee-fonte, 13px) - 2px));
    }
    .marquee-hero__separador {
      margin-inline: max(16px, calc(var(--marquee-gap, 28px) - 8px));
    }
    .marquee-hero__icon {
      width: 10px;
      height: 10px;
    }
  }
</style>

{% schema %}
{
  "name": "Marquee Pós-Hero",
  "class": "section-marquee-hero",
  "settings": [
    {
      "type": "header",
      "content": "Animação & Velocidade"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Tempo de rotação",
      "default": 25,
      "info": "Quanto menor o tempo, mais rápido."
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento entre avisos",
      "default": 28
    },
    {
      "type": "header",
      "content": "Estilo do Texto & Tipografia"
    },
    {
      "type": "checkbox",
      "id": "enable_gold_effect",
      "label": "Texto com efeito Ouro Metálico",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_italic",
      "label": "Texto em Itálico",
      "default": false
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Tamanho da fonte (Desktop)",
      "default": 13
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Espessura da fonte",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Médio (500)" },
        { "value": "600", "label": "Semi-negrito (600)" },
        { "value": "700", "label": "Negrito (700)" },
        { "value": "800", "label": "Extra Negrito (800)" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Transformação do texto",
      "options": [
        { "value": "uppercase", "label": "MAIÚSCULAS" },
        { "value": "capitalize", "label": "Primeiras Letras Maiúsculas" },
        { "value": "none", "label": "Normal (Conforme digitado)" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 5,
      "step": 0.2,
      "unit": "px",
      "label": "Espaçamento entre letras",
      "default": 1.4
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Exibir seta de link nos itens clicáveis",
      "default": true
    },
    {
      "type": "header",
      "content": "Separador"
    },
    {
      "type": "select",
      "id": "separator_symbol",
      "label": "Estilo do separador",
      "options": [
        { "value": "circle_outline", "label": "Círculo Vazado (Moderno)" },
        { "value": "circle_filled", "label": "Círculo Preenchido" },
        { "value": "star", "label": "Estrela" },
        { "value": "custom", "label": "Caractere Personalizado" }
      ],
      "default": "circle_outline"
    },
    {
      "type": "text",
      "id": "separator_custom",
      "label": "Caractere personalizado",
      "default": "•"
    },
    {
      "type": "header",
      "content": "Cores e Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor do Fundo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do Texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Cor do Separador",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Cor das Bordas (Superior e Inferior)",
      "default": "rgba(255, 255, 255, 0.15)"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 6,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Espaçamento vertical (Padding)",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Anúncio",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto do Anúncio",
          "default": "FRETE GRÁTIS ACIMA DE R$585!"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Pós-Hero",
      "blocks": [
        { "type": "announcement", "settings": { "text": "FRETE GRÁTIS ACIMA DE R$585!" } },
        { "type": "announcement", "settings": { "text": "EM ATÉ 10X SEM JUROS" } },
        { "type": "announcement", "settings": { "text": "10% OFF NA PRIMEIRA COMPRA" } }
      ]
    }
  ]
}
{% endschema %}