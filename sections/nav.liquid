{%- comment -%}
  ============================================================
  HEADER PREMIUM — Minimalista, Seguro e Responsivo
  ============================================================
{%- endcomment -%}

<header class="header {% if section.settings.transparent_on_top %}header--transparent-top{% endif %}" data-section-id="{{ section.id }}" data-header>
  <!-- O fundo (vidro) que só aparece ao rolar -->
  <span class="header__glass" aria-hidden="true">
    {%- if section.settings.show_progress_bar -%}
      <span class="header__progress" data-header-progress></span>
    {%- endif -%}
  </span>

  <div class="header__inner page-width">

    <!-- MOBILE: Menu + Conta (Esquerda) -->
    <div class="header__left-group">
      <button
        type="button"
        class="header__menu-toggle tap-target"
        aria-label="{{ 'sections.header.menu' | t }}"
        aria-expanded="false"
        aria-controls="MobileNav-{{ section.id }}"
      >
        <span class="header__burger"></span>
      </button>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__action-button header__account header__account--mobile tap-target" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}
    </div>

    <!-- LOGO (Centro no Mobile, Esquerda no Desktop) -->
    <a href="{{ routes.root_url }}" class="header__logo-link">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'header__logo-image',
            widths: '100, 150, 300, 450',
            width: section.settings.logo_width,
            alt: logo_alt,
            sizes: '(max-width: 1000px) 30vw, 150px'
        }}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <!-- NAVEGAÇÃO DESKTOP (Centro) -->
    <nav class="header__nav" role="navigation" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="header__menu" role="list">
        {%- for link in section.settings.menu.links -%}
          <li class="header__menu-item {% if link.links != blank %}header__menu-item--has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="header__menu-link" {% if link.current or link.child_active %}aria-current="page"{% endif %}>
              <span class="header__menu-link-text">{{ link.title | escape }}</span>
              {%- if link.links != blank -%}
                <span class="header__menu-caret" aria-hidden="true">
                  <svg width="8" height="5" viewBox="0 0 12 8" fill="none"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              {%- endif -%}
            </a>

            {%- if link.links != blank -%}
              <ul class="header__submenu" role="list">
                {%- for child in link.links -%}
                  <li class="header__submenu-item {% if child.links != blank %}header__submenu-item--has-dropdown{% endif %}">
                    <a href="{{ child.url }}" class="header__submenu-link" {% if child.current %}aria-current="page"{% endif %}>{{ child.title | escape }}</a>

                    {%- if child.links != blank -%}
                      <ul class="header__submenu header__submenu--nested" role="list">
                        {%- for grandchild in child.links -%}
                          <li><a href="{{ grandchild.url }}" class="header__submenu-link">{{ grandchild.title | escape }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <!-- AÇÕES: Busca + Carrinho (Direita) -->
    <div class="header__actions">
      <!-- Busca -->
      <details class="header__search" data-header-search>
        <summary class="header__action-button tap-target" aria-label="{{ 'general.search.search' | t }}">
          {% render 'icon', name: 'search' %}
        </summary>
        <div class="header__search-panel">
          <form action="{{ routes.search_url }}" method="get" role="search" class="header__search-form">
            <span class="header__search-icon" aria-hidden="true">{% render 'icon', name: 'search' %}</span>
            <input
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="Buscar produtos..."
              aria-label="{{ 'general.search.search' | t }}"
              class="field__input header__search-input"
              autocomplete="off"
            >
            <button type="submit" class="header__search-submit" aria-label="{{ 'general.search.submit' | t }}">
              {% render 'icon', name: 'arrow-right' %}
            </button>
          </form>
        </div>
      </details>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__action-button header__account header__account--desktop tap-target" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}

      <!-- Carrinho -->
      <a href="{{ routes.cart_url }}" class="header__action-button header__cart tap-target" aria-label="{{ 'templates.cart.cart' | t }}" data-cart-open>
        {% render 'icon', name: 'cart' %}
        <span class="header__cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<!-- GAVETA MOBILE (Menu Lateral) -->
<div class="header__scrim" data-mobile-scrim hidden></div>

<div class="header__mobile-nav" id="MobileNav-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}" hidden>
  <div class="header__mobile-header">
    <span class="header__mobile-title">{{ 'sections.header.menu' | t }}</span>
    <button type="button" class="header__mobile-close tap-target" data-mobile-close aria-label="{{ 'accessibility.close' | t }}">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M13.5 4.5L4.5 13.5M4.5 4.5L13.5 13.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="header__mobile-body">
    <ul class="header__mobile-menu" role="list">
      {%- for link in section.settings.menu.links -%}
        <li class="header__mobile-item">
          {%- if link.links != blank -%}
            <details class="header__mobile-details">
              <summary class="header__mobile-link header__mobile-link--summary">
                <span class="header__mobile-link-text">{{ link.title | escape }}</span>
                <span class="header__mobile-chevron">
                  <svg width="12" height="7" viewBox="0 0 12 8" fill="none"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </summary>
              <ul role="list" class="header__mobile-submenu">
                {%- for child in link.links -%}
                  <li>
                    <a href="{{ child.url }}" class="header__mobile-link header__mobile-link--child" {% if child.current %}aria-current="page"{% endif %}>
                      {{ child.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          {%- else -%}
            <a href="{{ link.url }}" class="header__mobile-link" {% if link.current %}aria-current="page"{% endif %}>
              <span class="header__mobile-link-text">{{ link.title | escape }}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>

  {%- if shop.customer_accounts_enabled -%}
    <div class="header__mobile-footer">
      <a href="{{ routes.account_url }}" class="header__mobile-account-btn">
        {% render 'icon', name: 'account' %}
        <span>{{ 'customer.account.title' | t }}</span>
      </a>
    </div>
  {%- endif -%}
</div>

<style>
  /* ==========================================================
     ESTRUTURA BASE
     ========================================================== */
  :root {
    --hd-ease: cubic-bezier(0.25, 1, 0.5, 1);
    --hd-duration: 0.4s;
  }

  .header {
    position: fixed; top: 0; left: 0; right: 0; width: 100%;
    z-index: 100; transform: translate3d(0, 0, 0) !important;
  }

  /* --- VIDRO ZERO LINHAS (Estado Topo) --- */
  .header__glass {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-color: transparent;
    border-bottom: none;
    box-shadow: none;
    transition:
      background-color var(--hd-duration) var(--hd-ease),
      border-color var(--hd-duration) var(--hd-ease),
      box-shadow var(--hd-duration) var(--hd-ease),
      backdrop-filter var(--hd-duration) var(--hd-ease);
  }

  .header:not(.header--transparent-top):not(.header--scrolled) .header__glass {
    background-color: var(--color-background, #0A0A0C);
  }

  .header.header--transparent-top:not(.header--scrolled) .header__glass {
    background: linear-gradient(180deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0) 100%);
  }

  /* --- VIDRO ATIVADO (Ao Rolar) --- */
  .header--scrolled .header__glass {
    /* rgba literal de proposito: e um VEU sobre a pagina, nao uma cor
       da paleta. color-mix() resolveria com o token, mas so existe a
       partir do Chrome 111 / Safari 16.2 — mais novo que a linha de
       base que o resto do tema sustenta (ha fallback ate Chrome 85
       aqui do lado), e um navegador sem suporte descartaria a
       declaracao e deixaria a header transparente ao rolar. */
    background-color: rgba(10, 10, 12, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
  }

  /* No toque o blur do vidro sai: a header e fixa e fica sobre a
     pagina rolando, entao o navegador refazia o desfoque do conteudo
     que passa por tras dela a cada frame de rolagem. E a mesma
     politica ja adotada no resto do tema para backdrop-filter. */
  @media (hover: none) {
    .header--scrolled .header__glass {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background-color: var(--cod-black-deep);
    }
  }
  .motion-lite .header--scrolled .header__glass {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background-color: var(--cod-black-deep);
  }

  /* --- PROGRESSO DOURADO --- */
  .header__progress {
    position: absolute; left: 0; right: 0; bottom: -1px; height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent, #C9A24D) 40%, #E3C98B);
    transform: scaleX(0); transform-origin: left center; opacity: 0;
    transition: opacity var(--dur-normal) var(--ease-out);
  }
  .header--scrolled .header__progress { opacity: 1; }

  /* --- ESPAÇAMENTOS INTERNOS --- */
  .header__inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: clamp(12px, 2vw, 24px);
    padding: 12px 0;
    transition: padding var(--hd-duration) var(--hd-ease);
  }
  .header--scrolled .header__inner { padding: 6px 0; }
  .header__left-group { display: flex; align-items: center; gap: 4px; }

  /* --- LOGO REDUZIDO E TRAVADO --- */
  .header__logo-link {
    display: inline-flex; align-items: center; justify-content: center;
    text-decoration: none; z-index: 2;
  }
  .header__logo-image {
    width: {{ section.settings.logo_width }}px;
    max-height: 30px; /* Impede esticamento vertical */
    height: auto;
    object-fit: contain;
    transition: transform var(--hd-duration) var(--hd-ease);
  }
  .header--scrolled .header__logo-image { transform: scale(0.95); }

  .header__logo-text {
    font-size: clamp(1.1rem, 2vw, 1.3rem); font-weight: var(--font-weight-bold); color: var(--color-text-primary);
  }

  /* --- MENU DESKTOP --- */
  .header__nav { flex: 1; display: flex; justify-content: center; }
  .header__menu { display: flex; align-items: center; gap: clamp(16px, 2.5vw, 32px); list-style: none; margin: 0; padding: 0; }
  .header__menu-item { position: relative; padding: 10px 0; }

  .header__menu-link {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: var(--f0); font-weight: var(--font-weight-semibold);
    text-transform: uppercase; letter-spacing: var(--tracking-label);
    color: var(--color-text-primary); text-decoration: none; opacity: 0.75;
    transition: opacity var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .header__menu-link:hover, .header__menu-item:focus-within > .header__menu-link { opacity: 1; }
  .header__menu-link[aria-current='page'] { opacity: 1; color: var(--color-accent); }

  .header__menu-caret { display: inline-flex; transition: transform var(--dur-normal) var(--ease-out); opacity: 0.6; }
  .header__menu-item:hover .header__menu-caret,
  .header__menu-item:focus-within .header__menu-caret { transform: rotate(180deg); opacity: 1; }

  /* SUBMENU DESKTOP */
  .header__submenu {
    position: absolute; top: 100%; left: -16px; min-width: 220px;
    background-color: var(--cod-graphite); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); box-shadow: var(--shadow-md);
    padding: var(--space-2xs); list-style: none; margin: 0;
    opacity: 0; visibility: hidden; transform: translateY(8px);
    transition:
      opacity var(--dur-normal) var(--ease-out),
      visibility var(--dur-normal) var(--ease-out),
      transform var(--dur-normal) var(--ease-out);
    z-index: 20;
  }
  /* :focus-within entra junto do :hover. Sem ele, o submenu so existia
     para quem tem mouse: navegando por Tab o foco entrava em links de
     um painel invisivel, e os itens de segundo nivel do menu eram
     inalcancaveis por teclado. */
  .header__menu-item:hover > .header__submenu,
  .header__menu-item:focus-within > .header__submenu { opacity: 1; visibility: visible; transform: translateY(0); }

  .header__submenu-link {
    display: block; padding: 10px 12px; font-size: var(--f1); color: var(--color-text-primary);
    text-decoration: none; border-radius: var(--radius-sm); opacity: 0.7;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  /* O deslocamento no hover era padding-left, que recalcula o layout do
     painel a cada entrada do cursor. transform faz o mesmo movimento
     so na composicao. */
  .header__submenu-link:hover,
  .header__submenu-link:focus-visible { opacity: 1; background-color: rgba(255, 255, 255, 0.06); transform: translateX(4px); }

  /* --- ÍCONES (AÇÕES) --- */
  .header__actions { display: flex; align-items: center; gap: 4px; }
  .header__action-button {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; color: var(--color-text-primary); background: transparent; border: none; border-radius: 50%;
    cursor: pointer; transition: background-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .header__action-button svg { width: 20px; height: 20px; }
  .header__action-button:hover { background-color: rgba(255, 255, 255, 0.1); }
  .header__action-button:active { transform: scale(0.92); }

  .header__cart { position: relative; }
  /* Era 9px. Numero de 9px sobre uma bolinha de 16px nao e legivel —
     e ele e justamente a confirmacao de que o produto entrou no
     carrinho. Subiu para 11px com a bolha acompanhando. */
  .header__cart-count {
    position: absolute; top: 2px; right: 0; min-width: 18px; height: 18px;
    padding: 0 4px; box-sizing: border-box;
    font-size: 11px; font-weight: var(--font-weight-bold); line-height: 18px; text-align: center;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-on-accent); background-color: var(--color-accent);
    border-radius: var(--radius-pill);
    /* transform-origin no centro para o "pulo" nao deslocar o badge
       do canto do icone enquanto cresce. */
    transform-origin: center center;
  }

  /* O badge reage quando o numero SOBE — a confirmacao de que o
     produto entrou no carrinho. Um passo curto: cresce 35% e assenta.
     So transform e opacity, entao roda no compositor e nao toca no
     layout do header. Sem loop: dispara uma vez por adicao. */
  @keyframes cartCountBump {
    0%   { transform: scale(1); }
    35%  { transform: scale(1.35); }
    100% { transform: scale(1); }
  }
  .header__cart-count.is-bump {
    animation: cartCountBump var(--dur-emphasis) var(--ease-out);
  }
  /* O icone acompanha de leve — o badge sozinho, tao pequeno, passa
     despercebido em tela grande. Metade da amplitude: quem conduz o
     gesto e o numero. */
  @keyframes cartIconNudge {
    0%   { transform: scale(1); }
    35%  { transform: scale(1.12); }
    100% { transform: scale(1); }
  }
  .header__cart:has(.is-bump) svg {
    animation: cartIconNudge var(--dur-emphasis) var(--ease-out);
  }

  /* As duas regras ficam SEPARADAS de proposito — e a mesma razao
     documentada na pilha do topo em base.css: um seletor invalido
     invalida a LISTA inteira em que esta. Num navegador sem :has()
     (anterior a Chrome 105 / Safari 15.4), junta-las faria o
     `animation: none` do badge cair junto, e quem pediu menos
     movimento veria justamente a animacao que pediu para nao ver. */
  @media (prefers-reduced-motion: reduce) {
    .header__cart-count.is-bump { animation: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .header__cart:has(.is-bump) svg { animation: none; }
  }

  /* --- MENU HAMBURGUER ANIMADO --- */
  .header__menu-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; background: none; border: none; padding: 0; cursor: pointer;
  }
  .header__burger, .header__burger::before, .header__burger::after {
    display: block; width: 18px; height: 1.5px; background-color: var(--color-text-primary); border-radius: 2px;
    transition: transform var(--dur-normal) var(--hd-ease), top var(--dur-normal) var(--hd-ease), width var(--dur-fast) var(--ease-out);
  }
  .header__burger { position: relative; }
  .header__burger::before { content: ''; position: absolute; top: -5px; left: 0; }
  .header__burger::after { content: ''; position: absolute; top: 5px; left: 0; width: 12px; }
  .header__menu-toggle:hover .header__burger::after { width: 18px; }
  .header__menu-toggle[aria-expanded='true'] .header__burger { background-color: transparent; }
  .header__menu-toggle[aria-expanded='true'] .header__burger::before { top: 0; transform: rotate(45deg); }
  .header__menu-toggle[aria-expanded='true'] .header__burger::after { top: 0; width: 18px; transform: rotate(-45deg); }

  /* --- RESPONSIVIDADE (CELULAR / TABLET) --- */
  @media screen and (max-width: 1000px) {
    .header__nav { display: none; }
    .header__account--desktop { display: none !important; }
    .header__account--mobile { display: inline-flex; }

    /* GRID MILIMÉTRICO NO MOBILE */
    .header__inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      min-height: 60px;
      padding-top: 8px;
      padding-bottom: 8px;
    }
    .header--scrolled .header__inner { min-height: 54px; }

    .header__left-group { grid-column: 1; justify-self: start; margin-left: -8px; }
    .header__logo-link { grid-column: 2; justify-self: center; }
    .header__actions { grid-column: 3; justify-self: end; margin-right: -8px; }

    .header__logo-image {
      width: {{ section.settings.logo_width_mobile }}px;
      max-height: 24px;
    }

    .header__search { position: static; }
    .header__search-panel { top: 100%; left: 12px; right: 12px; width: auto; border-radius: 12px; }
  }

  @media screen and (min-width: 1001px) {
    .header__account--mobile { display: none !important; }
    .header__account--desktop { display: inline-flex; }
    .header__menu-toggle { display: none; }
    .header__scrim, .header__mobile-nav { display: none !important; }
  }

  /* --- GAVETA MOBILE CSS (Drawer) --- */
  /* Sem backdrop-filter: o scrim cobre a pagina inteira, entao o blur
     obriga o navegador a refazer a composicao de TODA a tela a cada
     frame da animacao de abertura — no celular e o frame que falta.
     O tema ja evita backdrop-filter no toque nos outros componentes
     (ver .collection-panel__band em base.css); este tinha escapado.
     Um preto a 0.82 entrega a mesma separacao de graca. */
  .header__scrim {
    position: fixed; inset: 0; background-color: rgba(0, 0, 0, 0.82);
    opacity: 0; z-index: 150; transition: opacity var(--dur-emphasis) var(--ease-out);
  }
  .header__scrim.is-open { opacity: 1; }

  .header__mobile-nav {
    position: fixed; top: 0; left: 0; height: 100vh; height: 100dvh;
    width: min(86vw, 380px); display: flex; flex-direction: column;
    background-color: var(--cod-charcoal); border-right: 1px solid var(--color-border);
    z-index: 160; transform: translateX(-100%); transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .header__mobile-nav.is-open { transform: translateX(0); }

  .header__mobile-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }
  .header__mobile-title {
    font-size: var(--f0); font-weight: var(--font-weight-bold); text-transform: uppercase;
    letter-spacing: var(--tracking-label); color: var(--color-accent);
  }
  .header__mobile-close { background: none; border: none; color: var(--color-text-primary); width: 40px; height: 40px; cursor: pointer; }

  /* overscroll-behavior: contain impede que, ao chegar ao fim da
     lista, o gesto continue rolando a pagina ATRAS do painel —
     o efeito de "vazamento" classico de menu em celular. */
  .header__mobile-body {
    flex: 1; overflow-y: auto; overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: var(--space-xs) var(--space-md);
    padding-bottom: calc(var(--space-xs) + env(safe-area-inset-bottom, 0px));
  }
  .header__mobile-menu { list-style: none; margin: 0; padding: 0; }
  .header__mobile-link {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-sm);
    padding: 18px 0; font-size: var(--f3); font-weight: var(--font-weight-medium); text-transform: uppercase;
    color: var(--color-text-primary); text-decoration: none; border-bottom: 1px solid var(--color-border);
  }
  .header__mobile-link[aria-current='page'] { color: var(--color-accent); }

  /* ==========================================================
     ENTRADA DOS ITENS — o painel chega, depois o conteudo
     ==========================================================
     Antes o painel deslizava com a lista inteira pronta dentro dele:
     tecnicamente correto, mas o olho le como uma placa entrando, nao
     como um menu abrindo.

     Agora os itens sobem 8px logo atras do painel, em degraus de
     --stagger/2 (35ms). O teto e o 7o item: com a fileira inteira
     escalonada, o ultimo link de um menu grande chegaria tarde
     demais e a navegacao pareceria lenta.

     O atraso base (120ms) existe para a lista comecar a aparecer
     quando o painel ja percorreu parte do caminho — entrar junto
     desde o quadro zero mistura os dois movimentos.

     IMPORTANTE: so opacity e transform mudam. Nenhum item fica com
     pointer-events desligado, entao TODOS sao tocaveis desde o
     primeiro quadro, mesmo os que ainda estao aparecendo. A
     animacao nunca segura a navegacao. */
  .header__mobile-item {
    opacity: 0;
    transform: translateY(8px);
  }
  .header__mobile-nav.is-open .header__mobile-item {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--dur-normal) var(--ease-out),
      transform var(--dur-normal) var(--ease-out);
    transition-delay: calc(120ms + var(--item-i, 0) * (var(--stagger) / 2));
  }
  .header__mobile-item:nth-child(1) { --item-i: 0; }
  .header__mobile-item:nth-child(2) { --item-i: 1; }
  .header__mobile-item:nth-child(3) { --item-i: 2; }
  .header__mobile-item:nth-child(4) { --item-i: 3; }
  .header__mobile-item:nth-child(5) { --item-i: 4; }
  .header__mobile-item:nth-child(6) { --item-i: 5; }
  .header__mobile-item:nth-child(n + 7) { --item-i: 6; }

  /* O rodape (conta) fecha a sequencia, depois da lista. */
  .header__mobile-footer { opacity: 0; transition: opacity var(--dur-normal) var(--ease-out); }
  .header__mobile-nav.is-open .header__mobile-footer {
    opacity: 1;
    transition-delay: calc(120ms + 3 * (var(--stagger) / 2));
  }

  /* Quem pediu menos movimento recebe o painel com o conteudo ja
     posto: a gaveta ainda desliza (e a informacao de ONDE ela vem),
     mas nada escalona. */
  @media (prefers-reduced-motion: reduce) {
    .header__mobile-item,
    .header__mobile-footer { opacity: 1; transform: none; }
    .header__mobile-nav.is-open .header__mobile-item,
    .header__mobile-nav.is-open .header__mobile-footer {
      transition: none;
      transition-delay: 0s;
    }
  }

  .header__mobile-footer {
    padding: var(--space-sm) var(--space-md);
    padding-bottom: calc(var(--space-sm) + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-border); background-color: rgba(255, 255, 255, 0.02);
  }
  .header__mobile-account-btn {
    display: flex; align-items: center; gap: var(--space-xs); min-height: 48px;
    padding: 14px 18px; border-radius: var(--radius-sm); background: rgba(255, 255, 255, 0.08);
    color: var(--color-text-primary); text-decoration: none;
    font-size: var(--f2); font-weight: var(--font-weight-semibold);
  }
</style>

<script>
  (function () {
    var header = document.querySelector('.header[data-section-id="{{ section.id }}"]');
    if (!header) return;
    var raf = window.requestAnimationFrame || function (callback) { return window.setTimeout(callback, 16); };

    var progress = header.querySelector('[data-header-progress]');
    var search = header.querySelector('[data-header-search]');
    var drawer = document.getElementById('MobileNav-{{ section.id }}');

    var SCROLLED_AT = 20;
    var state = { scrolled: null };
    var ticking = false;
    var alturaRolavel = 0;

    function medirAltura() {
      alturaRolavel = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
    }

    function setScrolled(value) {
      if (state.scrolled === value) return;
      state.scrolled = value;
      header.classList.toggle('header--scrolled', value);
      document.documentElement.classList.toggle('rolou', value);
    }

    function update() {
      ticking = false;
      var y = Math.max(0, window.scrollY || document.documentElement.scrollTop);
      setScrolled(y > SCROLLED_AT);

      if (progress) {
        var ratio = alturaRolavel > 0 ? Math.min(1, y / alturaRolavel) : 0;
        progress.style.transform = 'scaleX(' + ratio.toFixed(4) + ')';
      }
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        raf(update);
      }
    }

    function remedir() {
      medirAltura();
      onScroll();
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', remedir);
    window.addEventListener('load', remedir);
    medirAltura();
    update();

    if (search) {
      search.addEventListener('toggle', function () {
        if (!search.open) return;
        var input = search.querySelector('input[type="search"]');
        if (input) window.setTimeout(function () { input.focus(); }, 100);
      });
      document.addEventListener('click', function (event) {
        if (search.open && !search.contains(event.target)) search.open = false;
      });
    }

    var toggle = header.querySelector('.header__menu-toggle');
    var closeBtn = document.querySelector('[data-mobile-close]');
    var scrim = document.querySelector('[data-mobile-scrim]');

    /* ---------------------------------------------------------
       TRAVA DE ROLAGEM — a mesma do carrinho, nao uma paralela

       Aqui havia `document.body.style.overflow = 'hidden'`. No
       Safari do iPhone isso NAO segura a pagina: o dedo continua
       rolando a coleção atras do menu e, ao fechar, a pessoa
       reaparece num ponto qualquer da lista.

       O tema ja resolve isso em assets/carrinho.js, que fixa o body
       guardando o deslocamento e expoe o par CODTravarRolagem /
       CODDestravarRolagem justamente para ser reaproveitado — tanto
       que o fechamento do carrinho checa `.header__mobile-nav.is-open`
       antes de destravar, ou seja, ele ja contava com este menu
       usando a mesma trava. Era o unico ponto do tema que nao usava.
    --------------------------------------------------------- */
    function travar() {
      if (window.CODTravarRolagem) window.CODTravarRolagem();
      else document.body.classList.add('bloquear');
    }

    function destravar() {
      // Se o carrinho estiver aberto, quem destrava e o fechamento dele.
      if (document.querySelector('.cart-drawer.is-open')) return;
      if (window.CODDestravarRolagem) window.CODDestravarRolagem();
      else document.body.classList.remove('bloquear');
    }

    var fecharTimer = null;
    var ultimoFoco = null;
    /* Estado proprio em vez de ler .is-open do DOM: a classe so entra
       no frame seguinte (dentro do raf, para a transicao acontecer),
       entao dois toques no mesmo frame liam "fechado" duas vezes e
       o segundo reabria o painel em vez de fecha-lo. */
    var aberto = false;

    function focaveis() {
      return Array.prototype.filter.call(
        drawer.querySelectorAll('button:not([disabled]), a[href], summary, input:not([disabled]), [tabindex]:not([tabindex="-1"])'),
        function (el) { return el.offsetParent !== null; }
      );
    }

    /* aria-modal="true" promete que o resto da pagina esta fora de
       alcance. Sem prender o Tab, a promessa era falsa: a terceira
       tabulacao ja estava num link da coleção atras do painel. */
    function prenderFoco(event) {
      if (event.key !== 'Tab') return;
      var lista = focaveis();
      if (!lista.length) return;
      var primeiro = lista[0];
      var ultimo = lista[lista.length - 1];
      if (event.shiftKey && document.activeElement === primeiro) {
        event.preventDefault();
        ultimo.focus();
      } else if (!event.shiftKey && document.activeElement === ultimo) {
        event.preventDefault();
        primeiro.focus();
      }
    }

    function onKeydown(event) {
      if (event.key === 'Escape') closeDrawer();
      else prenderFoco(event);
    }

    function openDrawer() {
      if (aberto) return;
      aberto = true;
      // O fechamento anterior podia ainda ter um timer a caminho: sem
      // cancelar, ele disparava depois da reabertura e escondia um
      // painel aberto (drawer.hidden = true num drawer visivel).
      if (fecharTimer) { window.clearTimeout(fecharTimer); fecharTimer = null; }

      ultimoFoco = document.activeElement;
      drawer.hidden = false;
      scrim.hidden = false;
      travar();
      raf(function () {
        drawer.classList.add('is-open');
        scrim.classList.add('is-open');
      });
      if (toggle) toggle.setAttribute('aria-expanded', 'true');
      document.addEventListener('keydown', onKeydown);
      if (closeBtn) closeBtn.focus();
    }

    function closeDrawer() {
      if (!aberto) return;
      aberto = false;
      drawer.classList.remove('is-open');
      scrim.classList.remove('is-open');
      destravar();
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
      document.removeEventListener('keydown', onKeydown);

      if (fecharTimer) window.clearTimeout(fecharTimer);
      fecharTimer = window.setTimeout(function () {
        drawer.hidden = true;
        scrim.hidden = true;
        fecharTimer = null;
      }, 500);

      // Devolve o foco a quem abriu; sem isso o teclado volta para o
      // topo do documento e a pessoa refaz o caminho inteiro.
      if (ultimoFoco && document.contains(ultimoFoco) && typeof ultimoFoco.focus === 'function') {
        ultimoFoco.focus();
      } else if (toggle) {
        toggle.focus();
      }
      ultimoFoco = null;
    }

    if (drawer && scrim) {
      if (toggle) toggle.addEventListener('click', function () {
        if (aberto) closeDrawer();
        else openDrawer();
      });
      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
      scrim.addEventListener('click', closeDrawer);

      // Tocar num link ja navega; o painel precisa sair junto, senao
      // ele reaparece por cima da pagina nova ao voltar pelo historico.
      drawer.addEventListener('click', function (event) {
        var link = event.target.closest && event.target.closest('a[href]');
        if (link) closeDrawer();
      });

      /* Girar o aparelho para a horizontal pode cruzar os 1000px, e
         a partir dali o CSS esconde o painel com display: none. O
         menu sumia da tela mas a trava de rolagem continuava ativa:
         a pagina inteira ficava impossivel de rolar, sem nada visivel
         explicando por que. */
      var mqDesktop = window.matchMedia('(min-width: 1001px)');
      var aoTrocarLargura = function (event) {
        if (event.matches) closeDrawer();
      };
      if (mqDesktop.addEventListener) mqDesktop.addEventListener('change', aoTrocarLargura);
      else if (mqDesktop.addListener) mqDesktop.addListener(aoTrocarLargura);
    }
  })();
</script>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
    },
    {
      "type": "header",
      "content": "Tamanho do Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Largura (Desktop)",
      "default": 110
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Largura (Celular)",
      "default": 85
    },
    {
      "type": "header",
      "content": "Aparência"
    },
    {
      "type": "checkbox",
      "id": "transparent_on_top",
      "label": "Fundo transparente no topo da página",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_progress_bar",
      "label": "Exibir linha dourada ao rolar a página",
      "default": true
    }
  ]
}
{% endschema %}