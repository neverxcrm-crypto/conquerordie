{%- comment -%}
  ============================================================
  HEADER PREMIUM — Inteligência de Contraste e Sem Linhas
  ============================================================
{%- endcomment -%}

{%- liquid
  assign is_transparent = false
  if section.settings.transparent_on_top
    if section.settings.transparent_home_only
      if template.name == 'index'
        assign is_transparent = true
      endif
    else
      assign is_transparent = true
    endif
  endif
-%}

<header class="header {% if is_transparent %}header--transparent-top{% endif %}" data-section-id="{{ section.id }}" data-header>
  <!-- O fundo (vidro) -->
  <span class="header__glass" aria-hidden="true">
    {%- if section.settings.show_progress_bar -%}
      <span class="header__progress" data-header-progress></span>
    {%- endif -%}
  </span>

  <div class="header__inner page-width">

    <!-- MOBILE: Menu + Conta (Esquerda) -->
    <div class="header__left-group">
      <button
        type="button"
        class="header__menu-toggle tap-target"
        aria-label="{{ 'sections.header.menu' | t }}"
        aria-expanded="false"
        aria-controls="MobileNav-{{ section.id }}"
      >
        <span class="header__burger"></span>
      </button>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__action-button header__account header__account--mobile tap-target" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}
    </div>

    <!-- LOGO (Centro no Mobile, Esquerda no Desktop) -->
    <a href="{{ routes.root_url }}" class="header__logo-link">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'header__logo-image',
            widths: '100, 150, 300, 450',
            width: section.settings.logo_width,
            alt: logo_alt,
            sizes: '(max-width: 1000px) 30vw, 150px'
        }}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <!-- NAVEGAÇÃO DESKTOP (Centro) -->
    <nav class="header__nav" role="navigation" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="header__menu" role="list">
        {%- for link in section.settings.menu.links -%}
          <li class="header__menu-item {% if link.links != blank %}header__menu-item--has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="header__menu-link" {% if link.current or link.child_active %}aria-current="page"{% endif %}>
              <span class="header__menu-link-text">{{ link.title | escape }}</span>
              {%- if link.links != blank -%}
                <span class="header__menu-caret" aria-hidden="true">
                  <svg width="8" height="5" viewBox="0 0 12 8" fill="none"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              {%- endif -%}
            </a>

            {%- if link.links != blank -%}
              <ul class="header__submenu" role="list">
                {%- for child in link.links -%}
                  <li class="header__submenu-item {% if child.links != blank %}header__submenu-item--has-dropdown{% endif %}">
                    <a href="{{ child.url }}" class="header__submenu-link" {% if child.current %}aria-current="page"{% endif %}>{{ child.title | escape }}</a>

                    {%- if child.links != blank -%}
                      <ul class="header__submenu header__submenu--nested" role="list">
                        {%- for grandchild in child.links -%}
                          <li><a href="{{ grandchild.url }}" class="header__submenu-link">{{ grandchild.title | escape }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <!-- AÇÕES: Busca + Carrinho (Direita) -->
    <div class="header__actions">
      <!-- Busca -->
      <details class="header__search" data-header-search>
        <summary class="header__action-button tap-target" aria-label="{{ 'general.search.search' | t }}">
          {% render 'icon', name: 'search' %}
        </summary>
        <div class="header__search-panel">
          <form action="{{ routes.search_url }}" method="get" role="search" class="header__search-form">
            <span class="header__search-icon" aria-hidden="true">{% render 'icon', name: 'search' %}</span>
            <input
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="Buscar produtos..."
              aria-label="{{ 'general.search.search' | t }}"
              class="field__input header__search-input"
              autocomplete="off"
            >
            <button type="submit" class="header__search-submit" aria-label="{{ 'general.search.submit' | t }}">
              {% render 'icon', name: 'arrow-right' %}
            </button>
          </form>
        </div>
      </details>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__action-button header__account header__account--desktop tap-target" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}

      <!-- Carrinho -->
      <a href="{{ routes.cart_url }}" class="header__action-button header__cart tap-target" aria-label="{{ 'templates.cart.cart' | t }}" data-cart-open>
        {% render 'icon', name: 'cart' %}
        <span class="header__cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<!-- GAVETA MOBILE (Menu Lateral) -->
<div class="header__scrim" data-mobile-scrim hidden></div>

<div class="header__mobile-nav" id="MobileNav-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}" hidden>
  <div class="header__mobile-header">
    <span class="header__mobile-title">{{ 'sections.header.menu' | t }}</span>
    <button type="button" class="header__mobile-close tap-target" data-mobile-close aria-label="{{ 'accessibility.close' | t }}">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M13.5 4.5L4.5 13.5M4.5 4.5L13.5 13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="header__mobile-body">
    <ul class="header__mobile-menu" role="list">
      {%- for link in section.settings.menu.links -%}
        <li class="header__mobile-item">
          {%- if link.links != blank -%}
            <details class="header__mobile-details">
              <summary class="header__mobile-link header__mobile-link--summary">
                <span class="header__mobile-link-text">{{ link.title | escape }}</span>
                <span class="header__mobile-chevron">
                  <svg width="12" height="7" viewBox="0 0 12 8" fill="none"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </summary>
              <ul role="list" class="header__mobile-submenu">
                {%- for child in link.links -%}
                  <li>
                    <a href="{{ child.url }}" class="header__mobile-link header__mobile-link--child" {% if child.current %}aria-current="page"{% endif %}>
                      {{ child.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          {%- else -%}
            <a href="{{ link.url }}" class="header__mobile-link" {% if link.current %}aria-current="page"{% endif %}>
              <span class="header__mobile-link-text">{{ link.title | escape }}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>

  {%- if shop.customer_accounts_enabled -%}
    <div class="header__mobile-footer">
      <a href="{{ routes.account_url }}" class="header__mobile-account-btn">
        {% render 'icon', name: 'account' %}
        <span>{{ 'customer.account.title' | t }}</span>
      </a>
    </div>
  {%- endif -%}
</div>

<style>
  /* ==========================================================
     ESTRUTURA BASE
     ========================================================== */
  :root {
    --hd-ease: cubic-bezier(0.25, 1, 0.5, 1);
    --hd-duration: 0.4s;
  }

  .header {
    position: fixed; top: 0; left: 0; right: 0; width: 100%;
    z-index: 100; transform: translate3d(0, 0, 0) !important;
    border: none !important; /* Previne que o tema global injete borda no wrapper */
    box-shadow: none !important;
  }

  /* --- VIDRO: Estado Base (Páginas Internas) --- */
  .header__glass {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-color: var(--color-background, #0A0A0C);
    border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.05));
    box-shadow: none;
    transition:
      background-color var(--hd-duration) var(--hd-ease),
      border-color var(--hd-duration) var(--hd-ease),
      box-shadow var(--hd-duration) var(--hd-ease),
      backdrop-filter var(--hd-duration) var(--hd-ease);
  }

  /* --- VIDRO: Estado Topo Transparente (Home Page) --- */
  .header.header--transparent-top:not(.header--scrolled) .header__glass {
    background-color: transparent;
    border-bottom: none !important; /* Remove totalmente a linha divisória */
    box-shadow: none !important;
    background-image: linear-gradient(180deg, rgba(0,0,0,0.4) 0%, transparent 100%);
  }

  /* Sombras dinâmicas super limpas nos itens (Apenas no estado transparente) */
  .header.header--transparent-top:not(.header--scrolled) .header__menu-link,
  .header.header--transparent-top:not(.header--scrolled) .header__logo-text {
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }
  .header.header--transparent-top:not(.header--scrolled) .header__action-button svg,
  .header.header--transparent-top:not(.header--scrolled) .header__burger,
  .header.header--transparent-top:not(.header--scrolled) .header__burger::before,
  .header.header--transparent-top:not(.header--scrolled) .header__burger::after,
  .header.header--transparent-top:not(.header--scrolled) .header__menu-caret svg {
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.6));
  }

  /* --- VIDRO ATIVADO (Ao Rolar) --- */
  .header--scrolled .header__glass {
    background-color: rgba(10, 10, 12, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.05));
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
    background-image: none; 
  }

  @media (hover: none) {
    .header--scrolled .header__glass {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background-color: var(--cod-black-deep, #050505);
    }
  }
  .motion-lite .header--scrolled .header__glass {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background-color: var(--cod-black-deep, #050505);
  }

  /* --- PROGRESSO DOURADO --- */
  .header__progress {
    position: absolute; left: 0; right: 0; bottom: -1px; height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent, #C9A24D) 40%, #E3C98B);
    transform: scaleX(0); transform-origin: left center; opacity: 0;
    transition: opacity var(--dur-normal, 0.3s) var(--ease-out, ease);
  }
  .header--scrolled .header__progress { opacity: 1; }

  /* --- ESPAÇAMENTOS INTERNOS --- */
  .header__inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: clamp(12px, 2vw, 24px);
    padding: 12px 0;
    transition: padding var(--hd-duration) var(--hd-ease);
  }
  .header--scrolled .header__inner { padding: 6px 0; }

  .header { padding-top: var(--sat, 0px); }
  .header__left-group { display: flex; align-items: center; gap: var(--space-3xs); }

  /* --- LOGO REDUZIDO E TRAVADO --- */
  .header__logo-link {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px;
    text-decoration: none; z-index: 2;
  }
  .header__logo-image {
    width: {{ section.settings.logo_width }}px;
    max-height: 36px;
    height: auto;
    object-fit: contain;
    transition: transform var(--hd-duration) var(--hd-ease);
  }
  .header--scrolled .header__logo-image { transform: scale(0.95); }

  .header__logo-text {
    font-size: clamp(1.1rem, 2vw, 1.3rem); font-weight: var(--font-weight-bold, 700); color: var(--color-text-primary, #ffffff);
  }

  /* --- MENU DESKTOP --- */
  .header__nav { flex: 1; display: flex; justify-content: center; }
  .header__menu { display: flex; align-items: center; gap: clamp(16px, 2.5vw, 32px); list-style: none; margin: 0; padding: 0; }
  .header__menu-item { position: relative; }

  .header__menu-link {
    display: inline-flex; align-items: center; gap: var(--space-2xs);
    padding: 12px 0;
    font-size: var(--f0, 0.8125rem); font-weight: var(--font-weight-semibold, 600);
    text-transform: uppercase; letter-spacing: var(--tracking-label, 0.05em);
    color: var(--color-text-primary, #ffffff); text-decoration: none; opacity: 0.75;
    transition: opacity var(--dur-fast, 0.2s) var(--ease-out, ease), color var(--dur-fast, 0.2s) var(--ease-out, ease);
  }
  .header__menu-link:hover, .header__menu-item:focus-within > .header__menu-link { opacity: 1; }
  .header__menu-link[aria-current='page'] { opacity: 1; color: var(--color-accent, #C9A24D); }

  .header__menu-caret { display: inline-flex; transition: transform var(--dur-normal, 0.3s) var(--ease-out, ease); opacity: 0.6; }
  .header__menu-item:hover .header__menu-caret,
  .header__menu-item:focus-within .header__menu-caret { transform: rotate(180deg); opacity: 1; }

  /* SUBMENU DESKTOP */
  .header__submenu {
    position: absolute; top: 100%; left: -16px; min-width: 220px;
    background-color: var(--cod-graphite, #1A1A1A); border: 1px solid var(--color-border, rgba(255,255,255,0.1));
    border-radius: var(--radius-md, 8px); box-shadow: var(--shadow-md, 0 10px 20px rgba(0,0,0,0.5));
    padding: var(--space-2xs, 8px); list-style: none; margin: 0;
    opacity: 0; visibility: hidden; transform: translateY(8px);
    transition:
      opacity var(--dur-normal, 0.3s) var(--ease-out, ease),
      visibility var(--dur-normal, 0.3s) var(--ease-out, ease),
      transform var(--dur-normal, 0.3s) var(--ease-out, ease);
    z-index: 20;
  }
  .header__menu-item:hover > .header__submenu,
  .header__menu-item:focus-within > .header__submenu { opacity: 1; visibility: visible; transform: translateY(0); }

  .header__submenu-link {
    display: flex; align-items: center; min-height: 44px; padding: 10px 12px; font-size: var(--f1, 0.875rem); color: var(--color-text-primary, #ffffff);
    text-decoration: none; border-radius: var(--radius-sm, 4px); opacity: 0.7;
    transition:
      opacity var(--dur-fast, 0.2s) var(--ease-out, ease),
      background-color var(--dur-fast, 0.2s) var(--ease-out, ease),
      transform var(--dur-fast, 0.2s) var(--ease-out, ease);
  }
  .header__submenu-link:hover,
  .header__submenu-link:focus-visible { opacity: 1; background-color: rgba(255, 255, 255, 0.06); transform: translateX(4px); }

  /* ==========================================================
     BUSCA
     ========================================================== */
  .header__search { position: relative; }
  .header__search > summary { list-style: none; cursor: pointer; }
  .header__search > summary::-webkit-details-marker { display: none; }
  .header__search > summary::marker { content: ''; }

  .header__search[open] > summary {
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--color-accent, #C9A24D);
  }

  .header__search-panel {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: min(400px, calc(100vw - 32px));
    padding: 10px;
    box-sizing: border-box;
    background-color: rgba(16, 16, 18, 0.96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
    border-radius: var(--radius-md, 12px);
    box-shadow: var(--shadow-lg, 0 24px 48px -12px rgba(0, 0, 0, 0.7));
    z-index: 30;
    transform-origin: top right;
    animation: headerSearchIn var(--dur-normal, 0.28s) var(--hd-ease) both;
  }

  @keyframes headerSearchIn {
    from { opacity: 0; transform: translateY(-8px) scale(0.98); }
    to   { opacity: 1; transform: none; }
  }

  .header__search-form { display: flex; align-items: center; gap: var(--space-2xs); }
  .header__search-icon { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 24px; margin-left: 6px; color: var(--color-text-muted, rgba(255, 255, 255, 0.5)); }
  .header__search-icon svg { width: 18px; height: 18px; }

  .header__search-input.field__input {
    flex: 1 1 auto; min-width: 0; min-height: 44px; padding: 10px 4px;
    background: transparent; border: none; border-radius: 0;
  }
  .header__search-input.field__input:hover,
  .header__search-input.field__input:focus { background: transparent; border: none; box-shadow: none; outline: none; }
  .header__search-input::-webkit-search-cancel-button { -webkit-appearance: none; }

  .header__search-submit {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 44px; height: 44px; background-color: var(--color-accent, #C9A24D);
    color: var(--color-text-on-accent, #000000); border: none; border-radius: var(--radius-sm, 8px);
    cursor: pointer; transition: filter var(--dur-fast, 0.2s) var(--ease-out, ease), transform var(--dur-fast, 0.2s) var(--ease-out, ease);
  }
  .header__search-submit svg { width: 18px; height: 18px; }
  .header__search-submit:hover { filter: brightness(1.12); }
  .header__search-submit:active { transform: scale(0.94); }

  @media (prefers-reduced-motion: reduce) {
    .header__search-panel { animation: none; }
    .header__search-submit:active { transform: none; }
  }

  /* --- ÍCONES (AÇÕES) --- */
  .header__actions { display: flex; align-items: center; gap: var(--space-3xs); }
  .header__action-button {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; color: var(--color-text-primary, #ffffff); background: transparent; border: none; border-radius: 50%;
    cursor: pointer; transition: background-color var(--dur-fast, 0.2s) var(--ease-out, ease), transform var(--dur-fast, 0.2s) var(--ease-out, ease);
  }
  .header__action-button svg { width: 20px; height: 20px; }
  .header__action-button:hover { background-color: rgba(255, 255, 255, 0.1); }
  .header__action-button:active { transform: scale(0.92); }

  .header__cart { position: relative; }
  .header__cart-count {
    position: absolute; top: 4px; right: 4px; min-width: 18px; height: 18px;
    padding: 0 4px; box-sizing: border-box;
    font-size: 11px; font-weight: var(--font-weight-bold, 700); line-height: 18px; text-align: center;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-on-accent, #000000); background-color: var(--color-accent, #C9A24D);
    border-radius: var(--radius-pill, 99px); transform-origin: center center;
  }

  @keyframes cartCountBump {
    0%   { transform: scale(1); }
    35%  { transform: scale(1.35); }
    100% { transform: scale(1); }
  }
  .header__cart-count.is-bump { animation: cartCountBump var(--dur-emphasis, 0.4s) var(--ease-out, ease); }
  
  @keyframes cartIconNudge {
    0%   { transform: scale(1); }
    35%  { transform: scale(1.12); }
    100% { transform: scale(1); }
  }
  .header__cart:has(.is-bump) svg { animation: cartIconNudge var(--dur-emphasis, 0.4s) var(--ease-out, ease); }

  @media (prefers-reduced-motion: reduce) {
    .header__cart-count.is-bump { animation: none; }
    .header__cart:has(.is-bump) svg { animation: none; }
  }

  /* --- MENU HAMBURGUER ANIMADO --- */
  .header__menu-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; background: none; border: none; padding: 0; cursor: pointer;
  }
  .header__burger, .header__burger::before, .header__burger::after {
    display: block; width: 18px; height: 1.5px; background-color: var(--color-text-primary, #ffffff); border-radius: 2px;
    transition: transform var(--dur-normal, 0.3s) var(--hd-ease), top var(--dur-normal, 0.3s) var(--hd-ease), width var(--dur-fast, 0.2s) var(--ease-out, ease);
  }
  .header__burger { position: relative; }
  .header__burger::before { content: ''; position: absolute; top: -5px; left: 0; }
  .header__burger::after { content: ''; position: absolute; top: 5px; left: 0; width: 12px; }
  .header__menu-toggle:hover .header__burger::after { width: 18px; }
  .header__menu-toggle[aria-expanded='true'] .header__burger { background-color: transparent; }
  .header__menu-toggle[aria-expanded='true'] .header__burger::before { top: 0; transform: rotate(45deg); }
  .header__menu-toggle[aria-expanded='true'] .header__burger::after { top: 0; width: 18px; transform: rotate(-45deg); }

  /* --- RESPONSIVIDADE (CELULAR / TABLET) --- */
  @media screen and (max-width: 1000px) {
    .header__nav { display: none; }
    .header__account--desktop { display: none !important; }
    .header__account--mobile { display: inline-flex; }

    .header__inner {
      display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
      min-height: 64px; padding-top: 8px; padding-bottom: 8px;
      padding-left: 16px; padding-right: 16px; gap: var(--space-xs);
    }
    .header--scrolled .header__inner { min-height: 56px; }

    .header__left-group { grid-column: 1; justify-self: start; margin: 0; }
    .header__logo-link { grid-column: 2; justify-self: center; }
    .header__actions { grid-column: 3; justify-self: end; margin: 0; }

    .header__logo-image { width: {{ section.settings.logo_width_mobile }}px; max-height: 36px; }

    .header__search { position: static; }
    .header__search-panel { top: calc(100% + 8px); left: max(12px, var(--sal, 0px)); right: max(12px, var(--sar, 0px)); width: auto; transform-origin: top center; }
  }

  @media screen and (min-width: 1001px) {
    .header__account--mobile { display: none !important; }
    .header__account--desktop { display: inline-flex; }
    .header__menu-toggle { display: none; }
    .header__scrim, .header__mobile-nav { display: none !important; }
  }

  /* --- GAVETA MOBILE (Drawer) --- */
  .header__scrim[hidden], .header__mobile-nav[hidden] { display: none !important; }

  .header__scrim {
    position: fixed; inset: 0; background-color: rgba(0, 0, 0, 0.82);
    opacity: 0; z-index: 950; transition: opacity var(--dur-emphasis, 0.4s) var(--ease-out, ease);
    -webkit-tap-highlight-color: transparent;
  }
  .header__scrim.is-open { opacity: 1; }

  .header__mobile-nav {
    position: fixed; top: 0; left: 0; height: 100vh; height: 100dvh;
    width: min(86vw, 380px); display: flex; flex-direction: column;
    background-color: var(--cod-charcoal, #121212); border-right: 1px solid var(--color-border, rgba(255,255,255,0.1));
    z-index: 960; transform: translateX(-100%); transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    overscroll-behavior: contain;
  }
  .header__mobile-nav.is-open { transform: translateX(0); }

  .header__mobile-header {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-xs, 8px);
    padding: var(--space-sm, 16px) var(--space-md, 24px);
    padding-top: calc(var(--space-sm, 16px) + var(--sat, 0px));
    padding-left: max(var(--space-md, 24px), var(--sal, 0px));
    border-bottom: 1px solid var(--color-border, rgba(255,255,255,0.1)); flex-shrink: 0;
  }
  .header__mobile-title {
    font-size: var(--f0, 0.8125rem); font-weight: var(--font-weight-bold, 700); text-transform: uppercase;
    letter-spacing: var(--tracking-label, 0.05em); color: var(--color-accent, #C9A24D);
  }
  .header__mobile-close {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    background: none; border: none; color: var(--color-text-primary, #ffffff); min-width: 44px; min-height: 44px;
    margin-right: -10px; border-radius: 50%; cursor: pointer; transition: background-color var(--dur-fast, 0.2s) var(--ease-out, ease);
  }
  .header__mobile-close:hover { background-color: rgba(255, 255, 255, 0.08); }
  .header__mobile-close:active { background-color: rgba(255, 255, 255, 0.14); }

  .header__mobile-body {
    flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch;
    padding: var(--space-xs, 8px) var(--space-md, 24px); padding-left: max(var(--space-md, 24px), var(--sal, 0px));
  }
  .header__mobile-menu { list-style: none; margin: 0; padding: 0; }
  .header__mobile-link {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm, 16px);
    padding: 18px 0; font-size: var(--f3, 1.25rem); font-weight: var(--font-weight-medium, 500); text-transform: uppercase;
    color: var(--color-text-primary, #ffffff); text-decoration: none; border-bottom: 1px solid var(--color-border, rgba(255,255,255,0.1));
  }
  .header__mobile-link[aria-current='page'] { color: var(--color-accent, #C9A24D); }
  .header__mobile-menu > .header__mobile-item:last-child > .header__mobile-link { border-bottom: none; }
  .header__mobile-link--summary { list-style: none; cursor: pointer; }
  .header__mobile-link--summary::-webkit-details-marker { display: none; }
  .header__mobile-link--summary::marker { content: ''; }
  .header__mobile-chevron { display: inline-flex; flex: none; transition: transform var(--dur-normal, 0.3s) var(--hd-ease); }
  .header__mobile-details[open] .header__mobile-chevron { transform: rotate(180deg); }
  .header__mobile-submenu { list-style: none; margin: 0; padding: 0 0 8px 12px; }
  .header__mobile-link--child { font-size: var(--f2, 1rem); text-transform: none; opacity: 0.75; padding: 14px 0; border-bottom: none; }
  .header__mobile-link--child[aria-current='page'] { opacity: 1; }

  .header__mobile-item { opacity: 0; transform: translateY(8px); }
  .header__mobile-nav.is-open .header__mobile-item {
    opacity: 1; transform: none;
    transition: opacity var(--dur-normal, 0.3s) var(--ease-out, ease), transform var(--dur-normal, 0.3s) var(--ease-out, ease);
    transition-delay: calc(120ms + var(--item-i, 0) * (var(--stagger, 70ms) / 2));
  }
  .header__mobile-item:nth-child(1) { --item-i: 0; } .header__mobile-item:nth-child(2) { --item-i: 1; }
  .header__mobile-item:nth-child(3) { --item-i: 2; } .header__mobile-item:nth-child(4) { --item-i: 3; }
  .header__mobile-item:nth-child(5) { --item-i: 4; } .header__mobile-item:nth-child(6) { --item-i: 5; }
  .header__mobile-item:nth-child(n + 7) { --item-i: 6; }

  .header__mobile-footer { opacity: 0; transition: opacity var(--dur-normal, 0.3s) var(--ease-out, ease); }
  .header__mobile-nav.is-open .header__mobile-footer { opacity: 1; transition-delay: calc(120ms + 3 * (var(--stagger, 70ms) / 2)); }

  @media (prefers-reduced-motion: reduce) {
    .header__mobile-item, .header__mobile-footer { opacity: 1; transform: none; }
    .header__mobile-nav.is-open .header__mobile-item, .header__mobile-nav.is-open .header__mobile-footer { transition: none; transition-delay: 0s; }
  }

  .header__mobile-footer {
    flex-shrink: 0; padding: var(--space-sm, 16px) var(--space-md, 24px); padding-bottom: calc(var(--space-sm, 16px) + var(--sab, 0px));
    padding-left: max(var(--space-md, 24px), var(--sal, 0px));
    border-top: 1px solid var(--color-border, rgba(255,255,255,0.1)); background-color: rgba(255, 255, 255, 0.02);
  }
  .header__mobile-account-btn {
    display: flex; align-items: center; gap: var(--space-xs, 8px); min-height: 48px;
    padding: 14px 18px; border-radius: var(--radius-sm, 4px); background: rgba(255, 255, 255, 0.08);
    color: var(--color-text-primary, #ffffff); text-decoration: none; font-size: var(--f2, 1rem); font-weight: var(--font-weight-semibold, 600);
  }
</style>

<script>
  (function () {
    var header = document.querySelector('.header[data-section-id="{{ section.id }}"]');
    if (!header) return;
    var raf = window.requestAnimationFrame || function (callback) { return window.setTimeout(callback, 16); };

    var progress = header.querySelector('[data-header-progress]');
    var search = header.querySelector('[data-header-search]');
    var drawer = document.getElementById('MobileNav-{{ section.id }}');
    var scrimEl = document.querySelector('[data-mobile-scrim]');

    function portar(el) {
      if (!el || el.parentNode === document.body) return el;
      var anterior = document.querySelector('[data-portado="' + el.id + '"]');
      if (anterior && anterior !== el) anterior.parentNode.removeChild(anterior);
      if (el.id) el.setAttribute('data-portado', el.id);
      document.body.appendChild(el);
      return el;
    }

    if (drawer) {
      portar(drawer);
      if (scrimEl) {
        if (!scrimEl.id) scrimEl.id = 'MobileScrim-{{ section.id }}';
        portar(scrimEl);
        document.body.insertBefore(scrimEl, drawer);
      }
    }

    var SCROLLED_AT = 20;
    var state = { scrolled: null };
    var ticking = false;
    var alturaRolavel = 0;

    function medirAltura() {
      alturaRolavel = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
    }

    function setScrolled(value) {
      if (state.scrolled === value) return;
      state.scrolled = value;
      header.classList.toggle('header--scrolled', value);
      document.documentElement.classList.toggle('rolou', value);
    }

    function update() {
      ticking = false;
      var y = Math.max(0, window.scrollY || document.documentElement.scrollTop);
      setScrolled(y > SCROLLED_AT);

      if (progress) {
        var ratio = alturaRolavel > 0 ? Math.min(1, y / alturaRolavel) : 0;
        progress.style.transform = 'scaleX(' + ratio.toFixed(4) + ')';
      }
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        raf(update);
      }
    }

    function remedir() {
      medirAltura();
      onScroll();
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', remedir);
    window.addEventListener('load', remedir);
    medirAltura();
    update();

    function fecharBusca() {
      if (search && search.open) search.open = false;
    }

    if (search) {
      search.addEventListener('toggle', function () {
        if (!search.open) return;
        var input = search.querySelector('input[type="search"]');
        if (input) window.setTimeout(function () { input.focus(); }, 100);
      });
      document.addEventListener('click', function (event) {
        if (search.open && !search.contains(event.target)) search.open = false;
      });
      search.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;
        event.stopPropagation();
        fecharBusca();
        var resumo = search.querySelector('summary');
        if (resumo) resumo.focus();
      });
      var formBusca = search.querySelector('form');
      if (formBusca) {
        formBusca.addEventListener('submit', function (event) {
          var campo = formBusca.querySelector('input[name="q"]');
          if (campo && !campo.value.trim()) {
            event.preventDefault();
            campo.focus();
          }
        });
      }
    }

    var toggle = header.querySelector('.header__menu-toggle');
    var closeBtn = drawer ? drawer.querySelector('[data-mobile-close]') : null;
    var scrim = scrimEl;

    var rolagemGuardada = 0;

    function travar() {
      if (window.CODTravarRolagem) { window.CODTravarRolagem(); return; }
      if (document.body.classList.contains('bloquear')) return;
      rolagemGuardada = window.scrollY || document.documentElement.scrollTop || 0;
      if (!document.documentElement.classList.contains('has-smooth-scroll')) {
        document.body.style.top = '-' + rolagemGuardada + 'px';
      }
      document.body.classList.add('bloquear');
    }

    function destravar() {
      if (document.querySelector('.cart-drawer.is-open')) return;
      if (window.CODDestravarRolagem) { window.CODDestravarRolagem(); return; }
      if (!document.body.classList.contains('bloquear')) return;
      var restaurar = document.body.style.top !== '';
      document.body.classList.remove('bloquear');
      document.body.style.top = '';
      if (!restaurar) return;
      var html = document.documentElement;
      var anterior = html.style.scrollBehavior;
      html.style.scrollBehavior = 'auto';
      window.scrollTo(0, rolagemGuardada);
      html.style.scrollBehavior = anterior;
    }

    var fecharTimer = null;
    var ultimoFoco = null;
    var aberto = false;

    function focaveis() {
      return Array.prototype.filter.call(
        drawer.querySelectorAll('button:not([disabled]), a[href], summary, input:not([disabled]), [tabindex]:not([tabindex="-1"])'),
        function (el) { return el.offsetParent !== null; }
      );
    }

    function prenderFoco(event) {
      if (event.key !== 'Tab') return;
      var lista = focaveis();
      if (!lista.length) return;
      var primeiro = lista[0];
      var ultimo = lista[lista.length - 1];
      if (event.shiftKey && document.activeElement === primeiro) {
        event.preventDefault();
        ultimo.focus();
      } else if (!event.shiftKey && document.activeElement === ultimo) {
        event.preventDefault();
        primeiro.focus();
      }
    }

    function onKeydown(event) {
      if (event.key === 'Escape') closeDrawer();
      else prenderFoco(event);
    }

    function openDrawer() {
      if (aberto) return;
      aberto = true;
      if (fecharTimer) { window.clearTimeout(fecharTimer); fecharTimer = null; }

      fecharBusca();
      if (window.CODFecharCarrinho) window.CODFecharCarrinho(true);

      ultimoFoco = document.activeElement;
      drawer.hidden = false;
      scrim.hidden = false;
      travar();
      raf(function () {
        drawer.classList.add('is-open');
        scrim.classList.add('is-open');
      });
      if (toggle) toggle.setAttribute('aria-expanded', 'true');
      document.addEventListener('keydown', onKeydown);
      if (closeBtn) closeBtn.focus();
    }

    function closeDrawer(manterTrava) {
      if (!aberto) return;
      aberto = false;
      drawer.classList.remove('is-open');
      scrim.classList.remove('is-open');
      if (!manterTrava) destravar();
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
      document.removeEventListener('keydown', onKeydown);

      if (ultimoFoco && document.contains(ultimoFoco) && typeof ultimoFoco.focus === 'function') {
        ultimoFoco.focus();
      } else if (toggle) {
        toggle.focus();
      }
      ultimoFoco = null;

      if (fecharTimer) window.clearTimeout(fecharTimer);
      fecharTimer = window.setTimeout(function () {
        drawer.hidden = true;
        scrim.hidden = true;
        fecharTimer = null;
      }, 500);
    }

    window.CODFecharMenu = closeDrawer;

    if (drawer && scrim) {
      if (toggle) toggle.addEventListener('click', function () {
        if (aberto) closeDrawer();
        else openDrawer();
      });
      if (closeBtn) closeBtn.addEventListener('click', function () { closeDrawer(); });
      scrim.addEventListener('click', function () { closeDrawer(); });

      drawer.addEventListener('click', function (event) {
        var link = event.target.closest && event.target.closest('a[href]');
        if (link) closeDrawer();
      });

      var toqueX = 0, toqueY = 0, toqueT = 0, arrastando = false, eixoDefinido = false;

      drawer.addEventListener('touchstart', function (event) {
        if (event.touches.length !== 1) return;
        toqueX = event.touches[0].clientX;
        toqueY = event.touches[0].clientY;
        toqueT = Date.now();
        arrastando = true;
        eixoDefinido = false;
      }, { passive: true });

      drawer.addEventListener('touchmove', function (event) {
        if (!arrastando) return;
        var dx = event.touches[0].clientX - toqueX;
        var dy = event.touches[0].clientY - toqueY;

        if (!eixoDefinido) {
          if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
          if (Math.abs(dy) > Math.abs(dx)) { arrastando = false; return; }
          eixoDefinido = true;
          drawer.style.transition = 'none';
        }

        if (dx > 0) dx = 0;
        drawer.style.transform = 'translateX(' + dx + 'px)';
        if (scrim) scrim.style.opacity = String(Math.max(0, 1 + dx / drawer.offsetWidth));
      }, { passive: true });

      function fimDoArrasto(event) {
        if (!arrastando) return;
        arrastando = false;
        drawer.style.transition = '';
        if (scrim) scrim.style.opacity = '';
        if (!eixoDefinido) return;

        var dx = event.changedTouches[0].clientX - toqueX;
        var velocidade = Math.abs(dx) / Math.max(1, Date.now() - toqueT);
        drawer.style.transform = '';
        if (dx < -drawer.offsetWidth / 3 || (dx < -40 && velocidade > 0.5)) closeDrawer();
      }

      drawer.addEventListener('touchend', fimDoArrasto, { passive: true });
      drawer.addEventListener('touchcancel', function () {
        arrastando = false;
        drawer.style.transition = '';
        drawer.style.transform = '';
        if (scrim) scrim.style.opacity = '';
      }, { passive: true });

      var mqDesktop = window.matchMedia('(min-width: 1001px)');
      var aoTrocarLargura = function (event) {
        if (event.matches) closeDrawer();
      };
      if (mqDesktop.addEventListener) mqDesktop.addEventListener('change', aoTrocarLargura);
      else if (mqDesktop.addListener) mqDesktop.addListener(aoTrocarLargura);
    }
  })();
</script>

