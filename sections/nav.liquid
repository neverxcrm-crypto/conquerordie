{%- comment -%}
  ============================================================
  NAV / HEADER — barra fixa com glassmorphism e estados de scroll
  ============================================================

  ESTADOS (classe no <header>, trocados pelo script no fim):
  - topo            barra preta sólida, largura total, hairline embaixo.
  - --scrolled      vira CÁPSULA DE VIDRO flutuante: a camada
                    .header__glass encolhe (inset), arredonda e ganha
                    blur + borda + sombra. O conteúdo NÃO se move de
                    lugar — só o fundo muda de forma, então não há
                    salto de layout.
  - --hidden        rolando para baixo, a cápsula sobe e sai de cena;
                    qualquer rolagem para cima (ou foco de teclado,
                    busca/menu abertos) traz de volta.
  - Fio de progresso em ouro na base da cápsula = quanto da página
    já foi lida.

  POR QUE O VIDRO FICA NUMA CAMADA SEPARADA (.header__glass):
  backdrop-filter no próprio <header> cria um "backdrop root" e os
  submenus/busca (que também têm blur) deixavam de desfocar o que
  está atrás. Com o vidro num irmão absoluto, cada painel desfoca
  a página de verdade — e a camada pode mudar de forma sozinha.

  MOBILE:
  Grid 1fr | logo | 1fr (simetria), drawer lateral de vidro com
  itens em cascata. Abrir o drawer põe body.bloquear — o mesmo que
  o carrinho usa — e o movimento.js pausa o ScrollSmoother.
{%- endcomment -%}
<header class="header" data-section-id="{{ section.id }}" data-header>
  <span class="header__glass" aria-hidden="true">
    <span class="header__progress" data-header-progress></span>
  </span>

  <div class="header__inner page-width">
    <div class="header__left-group">
      <button
        type="button"
        class="header__menu-toggle tap-target"
        aria-label="{{ 'sections.header.menu' | t }}"
        aria-expanded="false"
        aria-controls="MobileNav-{{ section.id }}"
      >
        <span class="header__burger"></span>
      </button>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__action-button header__account header__account--mobile tap-target" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}
    </div>

    <a href="{{ routes.root_url }}" class="header__logo-link">
      <span class="header__logo-aura" aria-hidden="true"></span>
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = shop.name | escape -%}
        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'header__logo-image',
            widths: '150, 300, 450, 600',
            width: settings.logo_width,
            height: logo_height,
            alt: logo_alt,
            sizes: '(max-width: 1000px) 40vw, 200px'
        }}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="header__nav" role="navigation" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="header__menu" role="list">
        {%- for link in section.settings.menu.links -%}
          <li class="header__menu-item {% if link.links != blank %}header__menu-item--has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="header__menu-link" {% if link.current or link.child_active %}aria-current="page"{% endif %}>
              <span class="header__menu-link-text">{{ link.title | escape }}</span>
              {%- if link.links != blank -%}
                <span class="header__menu-caret" aria-hidden="true">
                  <svg width="9" height="6" viewBox="0 0 12 8" fill="none"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              {%- endif -%}
            </a>
            {%- if link.links != blank -%}
              <ul class="header__submenu" role="list">
                {%- for child in link.links -%}
                  <li class="header__submenu-item {% if child.links != blank %}header__submenu-item--has-dropdown{% endif %}" style="--i: {{ forloop.index0 }};">
                    <a href="{{ child.url }}" class="header__submenu-link" {% if child.current %}aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                    {%- if child.links != blank -%}
                      <ul class="header__submenu header__submenu--nested" role="list">
                        {%- for grandchild in child.links -%}
                          <li><a href="{{ grandchild.url }}" class="header__submenu-link">{{ grandchild.title | escape }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__actions">
      <details class="header__search" data-header-search>
        <summary class="header__action-button tap-target" aria-label="{{ 'general.search.search' | t }}">
          {% render 'icon', name: 'search' %}
        </summary>
        <div class="header__search-panel">
          <form action="{{ routes.search_url }}" method="get" role="search" class="header__search-form">
            <span class="header__search-icon" aria-hidden="true">{% render 'icon', name: 'search' %}</span>
            <input
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.placeholder' | t }}"
              aria-label="{{ 'general.search.search' | t }}"
              class="field__input header__search-input"
              autocomplete="off"
            >
            <button type="submit" class="header__search-submit" aria-label="{{ 'general.search.submit' | t }}">
              {% render 'icon', name: 'arrow-right' %}
            </button>
          </form>
        </div>
      </details>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__action-button header__account header__account--desktop tap-target" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}

      <a
        href="{{ routes.cart_url }}"
        class="header__action-button header__cart tap-target"
        aria-label="{{ 'templates.cart.cart' | t }}"
        data-cart-open
      >
        {% render 'icon', name: 'cart' %}
        <span class="header__cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<div class="header__scrim" data-mobile-scrim hidden></div>

<div class="header__mobile-nav" id="MobileNav-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}" hidden>
  <div class="header__mobile-header">
    <span class="header__mobile-title">{{ 'sections.header.menu' | t }}</span>
    <button type="button" class="header__mobile-close tap-target" data-mobile-close aria-label="{{ 'accessibility.close' | t }}">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M13.5 4.5L4.5 13.5M4.5 4.5L13.5 13.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="header__mobile-body">
    <ul class="header__mobile-menu" role="list">
      {%- for link in section.settings.menu.links -%}
        <li class="header__mobile-item" style="--item-index: {{ forloop.index }};">
          {%- if link.links != blank -%}
            <details class="header__mobile-details">
              <summary class="header__mobile-link header__mobile-link--summary">
                <span class="header__mobile-link-text">
                  <span class="header__mobile-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  {{ link.title | escape }}
                </span>
                <span class="header__mobile-chevron">
                  <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </summary>
              <ul role="list" class="header__mobile-submenu">
                {%- for child in link.links -%}
                  <li>
                    <a href="{{ child.url }}" class="header__mobile-link header__mobile-link--child" {% if child.current %}aria-current="page"{% endif %}>
                      {{ child.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          {%- else -%}
            <a href="{{ link.url }}" class="header__mobile-link" {% if link.current %}aria-current="page"{% endif %}>
              <span class="header__mobile-link-text">
                <span class="header__mobile-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                {{ link.title | escape }}
              </span>
              <span class="header__mobile-arrow" aria-hidden="true">{% render 'icon', name: 'arrow-right' %}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>

  {%- if shop.customer_accounts_enabled -%}
    <div class="header__mobile-footer">
      <a href="{{ routes.account_url }}" class="header__mobile-account-btn">
        {% render 'icon', name: 'account' %}
        <span>{{ 'customer.account.title' | t }}</span>
      </a>
    </div>
  {%- endif -%}
</div>

<style>
  /* ==========================================================
     Base — o <header> é transparente; quem pinta é .header__glass
     ========================================================== */
  .header {
    --hd-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --hd-duration: 560ms;
    --hd-float-top: 8px;
    --hd-float-side: max(12px, calc((100% - var(--page-width, 1440px)) / 2 + 12px));
    position: relative;
    z-index: 100;
    transform: translate3d(0, 0, 0);
    transition: transform var(--hd-duration) var(--hd-ease);
  }

  .header__glass {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background-color: #000000;
    border: 1px solid transparent;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-radius: 0;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    transition:
      inset var(--hd-duration) var(--hd-ease),
      border-radius var(--hd-duration) var(--hd-ease),
      background-color 400ms var(--hd-ease),
      border-color 400ms var(--hd-ease),
      box-shadow var(--hd-duration) var(--hd-ease);
  }

  /* Fio de leitura — ouro, 1px, só aparece no estado de vidro */
  .header__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent) 20%, var(--cod-gold-soft, #E3C98B));
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
    transition: opacity 400ms ease;
    will-change: transform;
  }

  /* ---------- Estado: vidro flutuante ---------- */
  .header--scrolled .header__glass {
    inset: var(--hd-float-top) var(--hd-float-side) 0;
    border-radius: 18px;
    background-color: rgba(10, 10, 12, 0.72);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow:
      0 18px 40px -12px rgba(0, 0, 0, 0.65),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
  }
  .header--scrolled .header__progress { opacity: 0.9; }

  /* ---------- Estado: escondida (rolando para baixo) ---------- */
  .header--hidden {
    transform: translate3d(0, calc(-100% - var(--hd-float-top) - 4px), 0);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 12px;
    padding-bottom: 12px;
    transition: padding var(--hd-duration) var(--hd-ease);
  }
  /* Na cápsula o conteúdo desce metade do recuo do vidro, para ficar
     centrado nele. A altura total não muda (ver --header-height). */
  .header--scrolled .header__inner {
    padding-top: calc(12px + var(--hd-float-top) / 2);
    padding-bottom: calc(12px - var(--hd-float-top) / 2);
  }

  .header__left-group { display: flex; align-items: center; gap: 2px; }

  /* ---------- Logo ---------- */
  .header__logo-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text, #ffffff);
    text-decoration: none;
  }
  .header__logo-aura {
    position: absolute;
    z-index: -1;
    width: 130%;
    height: 160%;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgb(214 166 64 / 35%) 0%, transparent 70%);
    opacity: 0;
    filter: blur(12px);
    transform: scale(0.6);
    transition: opacity 400ms ease, transform 400ms var(--hd-ease);
    pointer-events: none;
  }
  .header--scrolled .header__logo-aura { opacity: 0.5; transform: scale(1); }
  .header__logo-image {
    max-height: 36px;
    width: auto;
    height: auto;
    transition: transform var(--hd-duration) var(--hd-ease);
  }
  .header__logo-text {
    font-size: var(--f3, 1.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
    transition: transform var(--hd-duration) var(--hd-ease);
  }
  .header--scrolled .header__logo-image,
  .header--scrolled .header__logo-text { transform: scale(0.9); }

  /* ---------- Menu desktop ---------- */
  .header__nav { flex: 1; display: flex; justify-content: center; }
  .header__menu {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.4vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .header__menu-item { position: relative; }
  /* Ponte invisível entre o link e o submenu: o hover não cai no vão */
  .header__menu-item--has-dropdown::after {
    content: '';
    position: absolute;
    left: -12px;
    right: -12px;
    top: 100%;
    height: 16px;
  }

  .header__menu-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 0;
    font-size: var(--f1, 0.875rem);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text, #ffffff);
    text-decoration: none;
    opacity: 0.78;
    transition: opacity 240ms ease;
  }
  .header__menu-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 400ms var(--hd-ease);
  }
  .header__menu-caret {
    display: inline-flex;
    transition: transform 320ms var(--hd-ease);
  }
  .header__menu-link:hover,
  .header__menu-item:focus-within > .header__menu-link { opacity: 1; }
  .header__menu-link:hover::after,
  .header__menu-item:focus-within > .header__menu-link::after { transform: scaleX(1); transform-origin: left center; }
  .header__menu-item--has-dropdown:hover .header__menu-caret,
  .header__menu-item--has-dropdown:focus-within .header__menu-caret { transform: rotate(180deg); }
  /* Página atual: ouro, sublinhado fixo */
  .header__menu-link[aria-current='page'] { opacity: 1; color: var(--color-accent-readable); }
  .header__menu-link[aria-current='page']::after { transform: scaleX(1); }

  /* ---------- Submenus — vidro próprio, entrada em cascata ---------- */
  .header__submenu {
    position: absolute;
    top: calc(100% + 14px);
    left: -16px;
    min-width: 220px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background-color: rgba(14, 14, 18, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px) scale(0.98);
    transform-origin: top left;
    transition: opacity 240ms ease, transform 360ms var(--hd-ease), visibility 0s linear 360ms;
    z-index: 20;
  }
  .header__menu-item--has-dropdown:hover > .header__submenu,
  .header__menu-item--has-dropdown:focus-within > .header__submenu {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .header__submenu > li {
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 260ms ease, transform 360ms var(--hd-ease);
  }
  .header__menu-item--has-dropdown:hover > .header__submenu > li,
  .header__menu-item--has-dropdown:focus-within > .header__submenu > li {
    opacity: 1;
    transform: none;
    transition-delay: calc(40ms + var(--i, 0) * 30ms);
  }
  .header__submenu--nested { top: -9px; left: 100%; }
  .header__submenu-item--has-dropdown { position: relative; }
  .header__submenu-item--has-dropdown:hover > .header__submenu--nested,
  .header__submenu-item--has-dropdown:focus-within > .header__submenu--nested {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .header__submenu-item--has-dropdown:hover > .header__submenu--nested > li,
  .header__submenu-item--has-dropdown:focus-within > .header__submenu--nested > li { opacity: 1; transform: none; }

  .header__submenu-link {
    position: relative;
    display: block;
    padding: 10px 12px;
    font-size: var(--f1, 0.875rem);
    color: #ffffff;
    text-decoration: none;
    border-radius: 8px;
    opacity: 0.8;
    transition: opacity 180ms ease, background-color 180ms ease, padding 280ms var(--hd-ease);
  }
  .header__submenu-link::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 50%;
    width: 6px;
    height: 1px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 280ms var(--hd-ease);
  }
  .header__submenu-link:hover,
  .header__submenu-link:focus-visible {
    opacity: 1;
    padding-left: 24px;
    background-color: rgba(255, 255, 255, 0.06);
  }
  .header__submenu-link:hover::before,
  .header__submenu-link:focus-visible::before { transform: scaleX(1); }
  .header__submenu-link[aria-current='page'] { opacity: 1; color: var(--color-accent-readable); }

  /* ---------- Ações ---------- */
  .header__actions { display: flex; align-items: center; gap: 2px; }
  .header__action-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 44px;
    height: 44px;
    color: var(--color-text, #ffffff);
    background: transparent;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 220ms ease, transform 320ms var(--hd-ease);
  }
  .header__action-button:hover { background-color: rgba(255, 255, 255, 0.08); }
  .header__action-button:active { transform: scale(0.92); }

  .header__cart-count {
    position: absolute;
    top: 4px;
    right: 3px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    font-size: 10px;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
    color: var(--color-text-on-accent, #000);
    background-color: var(--color-accent, #C9A24D);
    border-radius: 9px;
    box-shadow: 0 0 0 2px #000;
  }
  /* Pulso quando a quantidade muda (item adicionado) */
  .header__cart-count.is-bumping { animation: headerCartBump 600ms var(--hd-ease); }
  @keyframes headerCartBump {
    0% { transform: scale(1); }
    30% { transform: scale(1.35); }
    100% { transform: scale(1); }
  }

  /* ---------- Busca — painel de vidro ---------- */
  .header__search { position: relative; }
  .header__search summary { list-style: none; cursor: pointer; }
  .header__search summary::-webkit-details-marker { display: none; }
  .header__search[open] > summary { background-color: rgba(255, 255, 255, 0.1); }
  .header__search-panel {
    position: absolute;
    top: calc(100% + 14px);
    right: 0;
    width: min(360px, calc(100vw - 32px));
    padding: 8px;
    background-color: rgba(14, 14, 18, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    z-index: 20;
  }
  .header__search[open] .header__search-panel { animation: headerPanelIn 360ms var(--hd-ease); }
  @keyframes headerPanelIn {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }
  .header__search-form { position: relative; display: flex; align-items: center; }
  .header__search-icon {
    position: absolute;
    left: 12px;
    display: inline-flex;
    color: rgba(255, 255, 255, 0.5);
    pointer-events: none;
  }
  .header__search-icon svg { width: 16px; height: 16px; }
  .header__search-input {
    width: 100%;
    padding: 10px 48px 10px 38px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid transparent;
    color: #ffffff;
    outline: none;
    transition: border-color 200ms ease, background-color 200ms ease;
  }
  .header__search-input:focus { border-color: var(--color-border-accent); background-color: rgba(255, 255, 255, 0.08); }
  .header__search-input::-webkit-search-cancel-button { display: none; }
  .header__search-submit {
    position: absolute;
    right: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    color: var(--color-text-on-accent, #000);
    background-color: var(--color-accent, #C9A24D);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: filter 200ms ease;
  }
  .header__search-submit:hover { filter: brightness(1.08); }
  .header__search-submit svg { width: 14px; height: 14px; }

  /* ---------- Burger ---------- */
  .header__menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    width: 44px;
    height: 44px;
    padding: 0;
    cursor: pointer;
    border-radius: 50%;
  }
  .header__burger,
  .header__burger::before,
  .header__burger::after {
    display: block;
    width: 20px;
    height: 2px;
    background-color: var(--color-text, #ffffff);
    border-radius: 2px;
    transition: transform 360ms var(--hd-ease), top 360ms var(--hd-ease), opacity 200ms ease, width 360ms var(--hd-ease);
  }
  .header__burger { position: relative; }
  .header__burger::before { content: ''; position: absolute; top: -6px; left: 0; }
  .header__burger::after { content: ''; position: absolute; top: 6px; left: 0; width: 14px; }
  .header__menu-toggle:hover .header__burger::after { width: 20px; }
  /* Aberto: vira X */
  .header__menu-toggle[aria-expanded='true'] .header__burger { background-color: transparent; }
  .header__menu-toggle[aria-expanded='true'] .header__burger::before { top: 0; transform: rotate(45deg); }
  .header__menu-toggle[aria-expanded='true'] .header__burger::after { top: 0; width: 20px; transform: rotate(-45deg); }

  /* ==========================================================
     Drawer mobile — vidro
     ========================================================== */
  .header__scrim {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    z-index: 150;
    transition: opacity 400ms var(--hd-ease, ease);
  }
  .header__scrim.is-open { opacity: 1; }

  .header__mobile-nav {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    height: 100dvh;
    width: min(88vw, 380px);
    display: flex;
    flex-direction: column;
    background-color: rgba(12, 12, 15, 0.9);
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 16px 0 40px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    z-index: 160;
    transform: translateX(-100%);
    transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .header__mobile-nav.is-open { transform: translateX(0); }

  .header__mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .header__mobile-title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent-readable);
  }
  .header__mobile-title::before {
    content: '';
    width: 20px;
    height: 1px;
    background-color: currentColor;
    opacity: 0.7;
  }
  .header__mobile-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    color: #ffffff;
    cursor: pointer;
    transition: background-color 200ms ease, transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .header__mobile-close:hover { background: rgba(255, 255, 255, 0.12); transform: rotate(90deg); }

  .header__mobile-body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 8px 20px 24px;
  }
  .header__mobile-menu { list-style: none; margin: 0; padding: 0; }

  /* Itens em cascata */
  .header__mobile-item { opacity: 0; }
  .header__mobile-nav.is-open .header__mobile-item {
    animation: mobileItemFadeIn 560ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(80ms + var(--item-index, 1) * 45ms);
  }
  @keyframes mobileItemFadeIn {
    from { opacity: 0; transform: translateX(-16px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .header__mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 0;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    transition: color 200ms ease;
  }
  .header__mobile-link-text { display: inline-flex; align-items: baseline; gap: 14px; }
  .header__mobile-index {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-accent-readable);
    font-variant-numeric: tabular-nums;
  }
  .header__mobile-arrow { display: inline-flex; color: rgba(255, 255, 255, 0.4); transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), color 200ms ease; }
  .header__mobile-arrow svg { width: 14px; height: 14px; }
  .header__mobile-link:active { opacity: 0.7; }
  .header__mobile-link:hover .header__mobile-arrow { color: var(--color-accent-readable); transform: translateX(3px); }
  .header__mobile-link[aria-current='page'] { color: var(--color-accent-readable); }

  .header__mobile-details summary { list-style: none; cursor: pointer; }
  .header__mobile-details summary::-webkit-details-marker { display: none; }
  .header__mobile-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: rgba(255, 255, 255, 0.6);
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .header__mobile-details[open] .header__mobile-chevron { transform: rotate(180deg); color: var(--color-accent-readable); }
  .header__mobile-details[open] .header__mobile-submenu { animation: mobileSubIn 360ms cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes mobileSubIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }
  .header__mobile-submenu {
    list-style: none;
    padding: 6px 0 14px 14px;
    margin: 0 0 0 4px;
    border-left: 1px solid var(--color-border-accent, rgba(201, 162, 77, 0.55));
  }
  .header__mobile-link--child {
    padding: 10px 0 10px 12px;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    color: rgba(255, 255, 255, 0.72);
    border-bottom: none;
  }

  .header__mobile-footer {
    padding: 16px 20px calc(16px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.2);
  }
  .header__mobile-account-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 14px 16px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #ffffff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background-color 200ms ease, border-color 200ms ease;
  }
  .header__mobile-account-btn:hover { background: rgba(255, 255, 255, 0.1); border-color: var(--color-border-accent); }

  /* ==========================================================
     Responsivo
     ========================================================== */
  @media screen and (max-width: 1000px) {
    .header { --hd-float-top: 6px; --hd-float-side: 8px; }
    .header__nav { display: none; }
    .header__account--desktop { display: none !important; }
    .header__account--mobile { display: inline-flex; }

    .header__inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 8px;
      padding-top: 7px;
      padding-bottom: 7px;
    }
    .header--scrolled .header__inner {
      padding-top: calc(7px + var(--hd-float-top) / 2);
      padding-bottom: calc(7px - var(--hd-float-top) / 2);
    }
    .header--scrolled .header__glass { border-radius: 14px; }
    .header__left-group { grid-column: 1; justify-self: start; }
    .header__logo-link { grid-column: 2; justify-self: center; margin: 0; }
    .header__actions { grid-column: 3; justify-self: end; }
    .header__logo-image { max-height: 28px; }
    /* Busca no mobile: painel ancorado na tela, não no botão */
    .header__search { position: static; }
    .header__search-panel {
      position: absolute;
      top: calc(100% + 8px);
      left: var(--hd-float-side);
      right: var(--hd-float-side);
      width: auto;
    }
  }

  @media screen and (min-width: 1001px) {
    .header__account--mobile { display: none !important; }
    .header__account--desktop { display: inline-flex; }
    .header__menu-toggle { display: none; }
    .header__scrim, .header__mobile-nav { display: none !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .header, .header *, .header *::before, .header *::after,
    .header__scrim, .header__mobile-nav, .header__mobile-nav * {
      transition-duration: 0.01ms !important;
      animation: none !important;
    }
    .header__mobile-item { opacity: 1; }
    .header--hidden { transform: none; }
  }
</style>

<script>
  (function () {
    var header = document.querySelector('.header[data-section-id="{{ section.id }}"]');
    if (!header) return;

    var progress = header.querySelector('[data-header-progress]');
    var search = header.querySelector('[data-header-search]');
    var drawer = document.getElementById('MobileNav-{{ section.id }}');

    var SCROLLED_AT = 16;   // px até virar cápsula de vidro
    var HIDE_AFTER = 320;   // px até poder esconder ao descer
    var DELTA = 6;          // tolerância para não piscar em micro-rolagens

    var lastY = window.scrollY || 0;
    var state = { scrolled: null, hidden: false };
    var ticking = false;

    /* Algo aberto/focado na header? Então ela não pode sumir. */
    var canHover = window.matchMedia('(hover: hover)').matches;
    function isEngaged() {
      return (search && search.open) ||
        (canHover && header.matches(':hover')) ||
        header.contains(document.activeElement) ||
        (drawer && drawer.classList.contains('is-open'));
    }

    function setScrolled(value) {
      if (state.scrolled === value) return;
      state.scrolled = value;
      header.classList.toggle('header--scrolled', value);
    }

    function setHidden(value) {
      if (state.hidden === value) return;
      state.hidden = value;
      header.classList.toggle('header--hidden', value);
      if (value && search) search.open = false;
    }

    function update() {
      ticking = false;
      var y = Math.max(0, window.scrollY || document.documentElement.scrollTop);
      var diff = y - lastY;

      setScrolled(y > SCROLLED_AT);

      if (y <= HIDE_AFTER || isEngaged()) {
        setHidden(false);
      } else if (diff > DELTA) {
        setHidden(true);
      } else if (diff < -DELTA) {
        setHidden(false);
      }
      if (Math.abs(diff) > DELTA || y <= HIDE_AFTER) lastY = y;

      if (progress) {
        var max = document.documentElement.scrollHeight - window.innerHeight;
        var ratio = max > 0 ? Math.min(1, y / max) : 0;
        progress.style.transform = 'scaleX(' + ratio.toFixed(4) + ')';
      }
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(update);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    header.addEventListener('focusin', function () { setHidden(false); });
    update();

    /* Busca: foco direto no campo; fecha com Esc ou clique fora. */
    if (search) {
      search.addEventListener('toggle', function () {
        if (!search.open) return;
        var input = search.querySelector('input[type="search"]');
        if (input) window.setTimeout(function () { input.focus(); }, 30);
      });
      document.addEventListener('click', function (event) {
        if (search.open && !search.contains(event.target)) search.open = false;
      });
      search.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && search.open) {
          search.open = false;
          search.querySelector('summary').focus();
        }
      });
    }

    /* Contador do carrinho: pulso quando o número muda. */
    var count = header.querySelector('[data-cart-count]');
    if (count && 'MutationObserver' in window) {
      var previous = count.textContent;
      new MutationObserver(function () {
        if (count.textContent === previous) return;
        previous = count.textContent;
        count.classList.remove('is-bumping');
        void count.offsetWidth;
        count.classList.add('is-bumping');
      }).observe(count, { childList: true, characterData: true, subtree: true });
    }

    /* ---------------------------------------------------------
       Drawer mobile
       body.bloquear trava a página (e pausa o ScrollSmoother via
       movimento.js). O carrinho usa a mesma classe: quem fecha
       por último destrava.
    --------------------------------------------------------- */
    var toggle = header.querySelector('.header__menu-toggle');
    var closeBtn = document.querySelector('[data-mobile-close]');
    var scrim = document.querySelector('[data-mobile-scrim]');
    var closeTimer = null;

    function openDrawer() {
      window.clearTimeout(closeTimer);
      drawer.hidden = false;
      scrim.hidden = false;
      document.body.classList.add('bloquear');
      window.requestAnimationFrame(function () {
        drawer.classList.add('is-open');
        scrim.classList.add('is-open');
      });
      if (toggle) toggle.setAttribute('aria-expanded', 'true');
      if (closeBtn) window.setTimeout(function () { closeBtn.focus(); }, 60);
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      scrim.classList.remove('is-open');
      var cart = document.getElementById('CartDrawer');
      if (!cart || !cart.classList.contains('is-open')) document.body.classList.remove('bloquear');
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
      closeTimer = window.setTimeout(function () {
        drawer.hidden = true;
        scrim.hidden = true;
      }, 520);
    }

    if (drawer && scrim) {
      if (toggle) {
        toggle.addEventListener('click', function () {
          if (toggle.getAttribute('aria-expanded') === 'true') closeDrawer();
          else openDrawer();
        });
      }
      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
      scrim.addEventListener('click', closeDrawer);

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && drawer.classList.contains('is-open')) {
          closeDrawer();
          if (toggle) toggle.focus();
        }
      });

      /* Voltou para desktop com o drawer aberto: fecha e destrava. */
      var desktop = window.matchMedia('(min-width: 1001px)');
      var onBreakpoint = function (event) {
        if (event.matches && drawer.classList.contains('is-open')) closeDrawer();
      };
      if (desktop.addEventListener) desktop.addEventListener('change', onBreakpoint);
      else if (desktop.addListener) desktop.addListener(onBreakpoint);
    }
  })();
</script>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
    }
  ]
}
{% endschema %}
