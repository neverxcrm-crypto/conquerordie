{%- comment -%}
  ============================================================
  NAV / HEADER — Versão Otimizada (UI/UX Elite)
  ============================================================
{%- endcomment -%}
<header class="header" data-section-id="{{ section.id }}">
  <div class="header__inner page-width">
    <button
      type="button"
      class="header__menu-toggle tap-target"
      aria-label="{{ 'sections.header.menu' | t }}"
      aria-expanded="false"
      aria-controls="MobileNav-{{ section.id }}"
    >
      <span class="header__burger"></span>
    </button>

    <a href="{{ routes.root_url }}" class="header__logo-link">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = shop.name | escape -%}
        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'header__logo-image',
            widths: '150, 300, 450, 600',
            width: settings.logo_width,
            height: logo_height,
            alt: logo_alt,
            sizes: '(max-width: 1000px) 40vw, 200px'
        }}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="header__nav" role="navigation" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="header__menu" role="list">
        {%- for link in section.settings.menu.links -%}
          <li class="header__menu-item {% if link.links != blank %}header__menu-item--has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="header__menu-link" {% if link.current %}aria-current="page"{% endif %}>
              <span class="header__menu-link-text">{{ link.title | escape }}</span>
            </a>
            {%- if link.links != blank -%}
              <ul class="header__submenu" role="list">
                {%- for child in link.links -%}
                  <li class="header__submenu-item {% if child.links != blank %}header__submenu-item--has-dropdown{% endif %}">
                    <a href="{{ child.url }}" class="header__submenu-link">{{ child.title | escape }}</a>
                    {%- if child.links != blank -%}
                      <ul class="header__submenu header__submenu--nested" role="list">
                        {%- for grandchild in child.links -%}
                          <li><a href="{{ grandchild.url }}" class="header__submenu-link">{{ grandchild.title | escape }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__actions">
      <details class="header__search">
        <summary class="header__action-button tap-target" aria-label="{{ 'general.search.search' | t }}">
          {% render 'icon', name: 'search' %}
        </summary>
        <div class="header__search-panel">
          <form action="{{ routes.search_url }}" method="get" role="search" class="header__search-form">
            <input
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.placeholder' | t }}"
              aria-label="{{ 'general.search.search' | t }}"
              class="field__input header__search-input"
            >
            <button type="submit" class="visually-hidden">{{ 'general.search.submit' | t }}</button>
          </form>
        </div>
      </details>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__action-button tap-target" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}

      <a
        href="{{ routes.cart_url }}"
        class="header__action-button header__cart tap-target"
        aria-label="{{ 'templates.cart.cart' | t }}"
        data-cart-open
      >
        {% render 'icon', name: 'cart' %}
        <span class="header__cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<div class="header__scrim" data-mobile-scrim hidden></div>

<div class="header__mobile-nav" id="MobileNav-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}" hidden>
  <ul class="header__mobile-menu" role="list">
    {%- for link in section.settings.menu.links -%}
      <li class="header__mobile-item" style="--item-index: {{ forloop.index }};">
        {%- if link.links != blank -%}
          <details class="header__mobile-details">
            <summary class="header__mobile-link header__mobile-link--summary">
              <span>{{ link.title | escape }}</span>
              <span class="header__mobile-chevron">
                <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </summary>
            <ul role="list" class="header__mobile-submenu">
              {%- for child in link.links -%}
                <li><a href="{{ child.url }}" class="header__mobile-link header__mobile-link--child">{{ child.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </details>
        {%- else -%}
          <a href="{{ link.url }}" class="header__mobile-link" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

<style>
  /* Base Header & Efeito de Transição Avançado */
  .header {
    position: relative;
    z-index: 3;
    background-color: var(--color-background);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition:
      background-color 450ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 450ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 450ms cubic-bezier(0.16, 1, 0.3, 1),
      backdrop-filter 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Glassmorphism de Alta Definição com Brilho Especular */
  .header--scrolled {
    background-color: var(--color-overlay, rgba(12, 12, 15, 0.72));
    border-bottom-color: rgba(255, 255, 255, 0.12);
    box-shadow: 
      0 16px 36px -10px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .header--scrolled { background-color: var(--color-background); }
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 18px;
    padding-bottom: 18px;
    transition: padding 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header--scrolled .header__inner {
    padding-top: 12px;
    padding-bottom: 12px;
  }

  .header__logo-image,
  .header__logo-text {
    display: block;
    transform-origin: left center;
    transition: transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header__logo-image {
    max-height: 32px;
    width: auto;
    height: auto;
  }

  .header__logo-text { 
    font-size: var(--f3); 
    font-weight: var(--font-weight-bold, 700);
    letter-spacing: -0.02em;
    line-height: 32px; 
  }

  .header--scrolled .header__logo-image,
  .header--scrolled .header__logo-text {
    transform: scale(0.88);
  }

  /* Desktop Menu Interativo */
  .header__nav { flex: 1; display: flex; justify-content: center; }
  .header__menu {
    display: flex;
    align-items: center;
    gap: 36px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .header__menu-item { position: relative; }

  .header__menu-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 8px 0;
    font-family: var(--font-ui-family);
    font-size: var(--f1);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-ui);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 250ms ease, transform 250ms ease;
  }

  .header__menu-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 100%;
    height: 2px;
    background-color: var(--color-text);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
    border-radius: 2px;
  }

  .header__menu-link:hover,
  .header__menu-link:focus-visible {
    opacity: 1;
    transform: translateY(-1px);
  }

  .header__menu-link:hover::after,
  .header__menu-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .header__menu-link[aria-current='page'] { 
    opacity: 1; 
    font-weight: var(--font-weight-semibold, 600);
  }

  .header__menu-link[aria-current='page']::after {
    transform: scaleX(1);
    background-color: var(--color-accent);
    height: 2px;
  }

  /* Dropdown Flutuante Otimizado */
  .header__submenu {
    position: absolute;
    top: calc(100% + 8px);
    left: -12px;
    min-width: 220px;
    margin: 0;
    padding: 10px;
    list-style: none;
    background-color: var(--color-surface, rgba(20, 20, 24, 0.95));
    border: 1px solid var(--color-border-strong, rgba(255, 255, 255, 0.1));
    border-radius: calc(var(--inputs-radius) + 4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(16px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px) scale(0.98);
    transition: opacity 220ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1), visibility 220ms;
    z-index: 20;
  }

  .header__submenu--nested { top: -10px; left: calc(100% + 8px); }

  .header__menu-item--has-dropdown:hover > .header__submenu,
  .header__menu-item--has-dropdown:focus-within > .header__submenu,
  .header__submenu-item--has-dropdown:hover > .header__submenu,
  .header__submenu-item--has-dropdown:focus-within > .header__submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .header__submenu-item { position: relative; }
  .header__submenu-link {
    display: block;
    padding: 10px 14px;
    width: 100%;
    font-size: var(--f1);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--inputs-radius);
    opacity: 0.85;
    transition: opacity 200ms ease, background-color 200ms ease, transform 200ms ease;
  }

  .header__submenu-link:hover { 
    opacity: 1; 
    background-color: var(--color-surface-elevated, rgba(255, 255, 255, 0.08)); 
    transform: translateX(4px);
  }

  /* Botões de Ação & Animações */
  .header__actions { display: flex; align-items: center; gap: 8px; }
  .header__action-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 40px;
    height: 40px;
    color: var(--color-text);
    background: transparent;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    text-decoration: none;
    opacity: 0.85;
    -webkit-tap-highlight-color: transparent;
    transition: opacity 200ms ease, background-color 200ms ease, transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .header__action-button:hover,
  .header__action-button:focus-visible {
    opacity: 1;
    background-color: rgba(255, 255, 255, 0.06);
    transform: scale(1.12);
  }

  .header__action-button:active {
    transform: scale(0.92);
  }

  .header__cart-count {
    position: absolute;
    top: 4px;
    right: 4px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    font-family: var(--font-ui-family);
    font-size: 10px;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
    color: var(--color-text-on-accent, #fff);
    background-color: var(--color-accent, #0071e3);
    border-radius: 9px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    animation: cartPulse 2s infinite cubic-bezier(0.4, 0, 0.6, 1);
  }

  @keyframes cartPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.12); }
  }

  /* Painel de Busca Animado */
  .header__search { position: relative; }
  .header__search summary { list-style: none; cursor: pointer; }
  .header__search summary::-webkit-details-marker { display: none; }
  .header__search[open] .header__search-panel {
    animation: searchExpand 250ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes searchExpand {
    from { opacity: 0; transform: translateY(8px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .header__search-panel {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: 320px;
    max-width: 90vw;
    padding: 8px;
    background-color: var(--color-surface, #1c1c1e);
    border: 1px solid var(--color-border-strong, rgba(255, 255, 255, 0.12));
    border-radius: calc(var(--inputs-radius) + 4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
    z-index: 20;
  }

  .header__search-input {
    width: 100%;
    padding: 10px 14px;
    border-radius: var(--inputs-radius);
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid transparent;
    color: var(--color-text);
    outline: none;
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .header__search-input:focus {
    border-color: var(--color-accent);
    background-color: transparent;
  }

  /* Mobile Hamburguer Transição Morfólogica */
  .header__menu-toggle { display: none; background: none; border: none; }
  .header__burger,
  .header__burger::before,
  .header__burger::after {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--color-text);
    border-radius: 2px;
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), top 300ms cubic-bezier(0.16, 1, 0.3, 1), opacity 200ms ease;
  }
  .header__burger { position: relative; }
  .header__burger::before { content: ''; position: absolute; top: -7px; }
  .header__burger::after { content: ''; position: absolute; top: 7px; }
  .header__menu-toggle[aria-expanded='true'] .header__burger { background-color: transparent; }
  .header__menu-toggle[aria-expanded='true'] .header__burger::before { top: 0; transform: rotate(45deg); }
  .header__menu-toggle[aria-expanded='true'] .header__burger::after { top: 0; transform: rotate(-45deg); }

  /* Mobile Drawer & Acordeões */
  .header__scrim {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    opacity: 0;
    z-index: 1;
    transition: opacity 350ms ease;
  }
  .header__scrim.is-open { opacity: 1; }

  .header__mobile-nav {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: min(86vw, 380px);
    overflow-y: auto;
    background-color: var(--color-background);
    border-left: 1px solid var(--color-border);
    padding: calc(var(--header-height) + 24px) 24px 40px;
    z-index: 2;
    transform: translateX(100%);
    opacity: 0;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1), opacity 400ms ease;
  }

  .header__mobile-nav.is-open { transform: translateX(0); opacity: 1; }

  .header__mobile-menu { list-style: none; margin: 0; padding: 0; }
  
  /* Staggered animation dos itens do mobile */
  .header__mobile-nav.is-open .header__mobile-item {
    animation: mobileItemFadeIn 400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--item-index, 1) * 40ms);
  }

  @keyframes mobileItemFadeIn {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .header__mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    font-size: var(--f3);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    transition: color 200ms ease;
  }

  .header__mobile-details summary {
    list-style: none;
    cursor: pointer;
  }
  .header__mobile-details summary::-webkit-details-marker { display: none; }

  .header__mobile-chevron {
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header__mobile-details[open] .header__mobile-chevron {
    transform: rotate(180deg);
  }

  .header__mobile-submenu {
    list-style: none;
    padding: 0 0 8px 16px;
    margin: 0;
  }

  .header__mobile-link--child {
    padding: 10px 0;
    font-size: var(--f2);
    color: var(--color-text-secondary);
    border-bottom: none;
  }

  @media screen and (max-width: 1000px) {
    .header__nav { display: none; }
    .header__menu-toggle { display: inline-flex; align-items: center; justify-content: center; }
    .header__inner { padding-top: 14px; padding-bottom: 14px; }
    .header--scrolled .header__inner { padding-top: 10px; padding-bottom: 10px; }
    .header__logo-image { max-height: 28px; }
    .header__logo-link { margin: 0 auto; }
  }

  @media screen and (min-width: 1001px) {
    .header__scrim, .header__mobile-nav { display: none !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .header, .header__inner, .header__logo-image, .header__logo-text,
    .header__menu-link, .header__action-button, .header__scrim,
    .header__mobile-nav, .header__cart-count {
      transition-duration: 0.01ms !important;
      animation: none !important;
    }
  }
</style>

<script>
  (function () {
    var header = document.querySelector('.header[data-section-id="{{ section.id }}"]');
    if (!header) return;

    var ENTER_AT = 20;
    var EXIT_AT = 8;
    var ticking = false;
    var isScrolled = false;

    function applyScrollState() {
      var y = window.scrollY || document.documentElement.scrollTop;
      if (!isScrolled && y > ENTER_AT) {
        isScrolled = true;
        header.classList.add('header--scrolled');
      } else if (isScrolled && y < EXIT_AT) {
        isScrolled = false;
        header.classList.remove('header--scrolled');
      }
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(applyScrollState);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    applyScrollState();

    /* ---- Drawer mobile ---- */
    var toggle = header.querySelector('.header__menu-toggle');
    var drawer = document.getElementById('MobileNav-{{ section.id }}');
    var scrim = document.querySelector('.header__scrim');
    var closeTimer = null;

    function openDrawer() {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      drawer.hidden = false;
      scrim.hidden = false;
      document.body.classList.add('bloquear');
      window.requestAnimationFrame(function () {
        drawer.classList.add('is-open');
        scrim.classList.add('is-open');
      });
      toggle.setAttribute('aria-expanded', 'true');
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      scrim.classList.remove('is-open');
      var cartDrawer = document.getElementById('CartDrawer');
      if (!cartDrawer || !cartDrawer.classList.contains('is-open')) {
        document.body.classList.remove('bloquear');
      }
      toggle.setAttribute('aria-expanded', 'false');
      closeTimer = setTimeout(function () {
        drawer.hidden = true;
        scrim.hidden = true;
      }, 400);
    }

    if (toggle && drawer && scrim) {
      toggle.addEventListener('click', function () {
        var open = toggle.getAttribute('aria-expanded') === 'true';
        if (open) { closeDrawer(); } else { openDrawer(); }
      });
      scrim.addEventListener('click', closeDrawer);
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
          closeDrawer();
          toggle.focus();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
    }
  ]
}
{% endschema %}