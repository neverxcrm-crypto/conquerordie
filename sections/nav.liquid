{%- comment -%}
  ============================================================
  NAV / HEADER — barra fixa em preto absoluto com glassmorphism no scroll
  ============================================================
{%- endcomment -%}
<header class="header" data-section-id="{{ section.id }}" data-header>
  <span class="header__glass" aria-hidden="true">
    <span class="header__progress" data-header-progress></span>
  </span>

  <div class="header__inner page-width">
    <div class="header__left-group">
      <button
        type="button"
        class="header__menu-toggle tap-target"
        aria-label="{{ 'sections.header.menu' | t }}"
        aria-expanded="false"
        aria-controls="MobileNav-{{ section.id }}"
      >
        <span class="header__burger"></span>
      </button>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__action-button header__account header__account--mobile tap-target" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}
    </div>

    <a href="{{ routes.root_url }}" class="header__logo-link">
      <span class="header__logo-aura" aria-hidden="true"></span>
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = shop.name | escape -%}
        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'header__logo-image',
            widths: '150, 300, 450, 600',
            width: settings.logo_width,
            height: logo_height,
            alt: logo_alt,
            sizes: '(max-width: 1000px) 40vw, 200px'
        }}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="header__nav" role="navigation" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="header__menu" role="list">
        {%- for link in section.settings.menu.links -%}
          <li class="header__menu-item {% if link.links != blank %}header__menu-item--has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="header__menu-link" {% if link.current or link.child_active %}aria-current="page"{% endif %}>
              <span class="header__menu-link-text">{{ link.title | escape }}</span>
              {%- if link.links != blank -%}
                <span class="header__menu-caret" aria-hidden="true">
                  <svg width="9" height="6" viewBox="0 0 12 8" fill="none"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              {%- endif -%}
            </a>
            {%- if link.links != blank -%}
              <ul class="header__submenu" role="list">
                {%- for child in link.links -%}
                  <li class="header__submenu-item {% if child.links != blank %}header__submenu-item--has-dropdown{% endif %}" style="--i: {{ forloop.index0 }};">
                    <a href="{{ child.url }}" class="header__submenu-link" {% if child.current %}aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                    {%- if child.links != blank -%}
                      <ul class="header__submenu header__submenu--nested" role="list">
                        {%- for grandchild in child.links -%}
                          <li><a href="{{ grandchild.url }}" class="header__submenu-link">{{ grandchild.title | escape }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__actions">
      <details class="header__search" data-header-search>
        <summary class="header__action-button tap-target" aria-label="{{ 'general.search.search' | t }}">
          {% render 'icon', name: 'search' %}
        </summary>
        <div class="header__search-panel">
          <form action="{{ routes.search_url }}" method="get" role="search" class="header__search-form">
            <span class="header__search-icon" aria-hidden="true">{% render 'icon', name: 'search' %}</span>
            <input
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.placeholder' | t }}"
              aria-label="{{ 'general.search.search' | t }}"
              class="field__input header__search-input"
              autocomplete="off"
            >
            <button type="submit" class="header__search-submit alvo-44" aria-label="{{ 'general.search.submit' | t }}">
              {% render 'icon', name: 'arrow-right' %}
            </button>
          </form>
        </div>
      </details>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__action-button header__account header__account--desktop tap-target" aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}

      <a
        href="{{ routes.cart_url }}"
        class="header__action-button header__cart tap-target"
        aria-label="{{ 'templates.cart.cart' | t }}"
        data-cart-open
      >
        {% render 'icon', name: 'cart' %}
        <span class="header__cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<div class="header__scrim" data-mobile-scrim hidden></div>

<div class="header__mobile-nav" id="MobileNav-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}" hidden>
  <div class="header__mobile-header">
    <span class="header__mobile-title">{{ 'sections.header.menu' | t }}</span>
    <button type="button" class="header__mobile-close tap-target" data-mobile-close aria-label="{{ 'accessibility.close' | t }}">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M13.5 4.5L4.5 13.5M4.5 4.5L13.5 13.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="header__mobile-body">
    <ul class="header__mobile-menu" role="list">
      {%- for link in section.settings.menu.links -%}
        <li class="header__mobile-item" style="--item-index: {{ forloop.index }};">
          {%- if link.links != blank -%}
            <details class="header__mobile-details">
              <summary class="header__mobile-link header__mobile-link--summary">
                <span class="header__mobile-link-text">
                  <span class="header__mobile-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  {{ link.title | escape }}
                </span>
                <span class="header__mobile-chevron">
                  <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </summary>
              <ul role="list" class="header__mobile-submenu">
                {%- for child in link.links -%}
                  <li>
                    <a href="{{ child.url }}" class="header__mobile-link header__mobile-link--child" {% if child.current %}aria-current="page"{% endif %}>
                      {{ child.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          {%- else -%}
            <a href="{{ link.url }}" class="header__mobile-link" {% if link.current %}aria-current="page"{% endif %}>
              <span class="header__mobile-link-text">
                <span class="header__mobile-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                {{ link.title | escape }}
              </span>
              <span class="header__mobile-arrow" aria-hidden="true">{% render 'icon', name: 'arrow-right' %}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>

  {%- if shop.customer_accounts_enabled -%}
    <div class="header__mobile-footer">
      <a href="{{ routes.account_url }}" class="header__mobile-account-btn">
        {% render 'icon', name: 'account' %}
        <span>{{ 'customer.account.title' | t }}</span>
      </a>
    </div>
  {%- endif -%}
</div>

<style>
  /* ==========================================================
     Header Fixo no Topo com Fundo Preto Sólido
     ========================================================== */
  .header {
    --hd-ease: var(--ease-out, ease-out);
    --hd-duration: var(--dur-emphasis, 0.25s);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 100;
    transform: translate3d(0, 0, 0) !important;
  }

  /* Estado Inicial (sem scroll): Preto Absoluto Sólido */
  .header__glass {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background-color: #000000 !important; /* Preto absoluto no topo */
    border: none !important;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition:
      background-color var(--hd-duration) var(--hd-ease),
      backdrop-filter var(--hd-duration) var(--hd-ease),
      box-shadow var(--hd-duration) var(--hd-ease);
  }

  /* Fio de leitura em ouro */
  .header__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent, #C9A24D) 20%, var(--cod-gold-soft, #E3C98B));
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
    transition: opacity 300ms ease;
    will-change: transform;
  }

  /* ---------- Estado: Glassmorphism ao Rolar (Scroll) ---------- */
  .header--scrolled .header__glass {
    background-color: rgba(10, 10, 12, 0.78) !important; /* Fica translúcido no scroll */
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }
  .header--scrolled .header__progress { opacity: 0.9; }

  /* ---------- Espaçamentos e Margem Reduzida ---------- */
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
    transition: padding var(--hd-duration) var(--hd-ease);
  }

  .header__left-group { display: flex; align-items: center; gap: 2px; }

  /* Logo */
  .header__logo-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    color: var(--color-text, #ffffff);
    text-decoration: none;
  }

  .header__logo-aura {
    position: absolute;
    z-index: -1;
    width: 130%;
    height: 160%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse closest-side,
      rgb(214 166 64 / 35%) 0%,
      rgb(214 166 64 / 30%) 22%,
      rgb(214 166 64 / 1%) 87%,
      transparent 100%
    );
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 400ms ease, transform 400ms var(--hd-ease);
    pointer-events: none;
  }
  .header--scrolled .header__logo-aura { opacity: 0.4; transform: scale(1); }

  .header__logo-image {
    max-height: 32px;
    width: auto;
    height: auto;
    transition: transform var(--hd-duration) var(--hd-ease);
  }
  .header__logo-text {
    font-size: var(--f3, 1.15rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  /* Menu Desktop */
  .header__nav { flex: 1; display: flex; justify-content: center; }
  .header__menu {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.2vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .header__menu-item { position: relative; }
  .header__menu-item--has-dropdown::after {
    content: '';
    position: absolute;
    left: -12px;
    right: -12px;
    top: 100%;
    height: 16px;
  }

  .header__menu-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 0;
    font-size: var(--f1, 0.8125rem);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text, #ffffff);
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 240ms ease;
  }
  .header__menu-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 300ms var(--hd-ease);
  }
  .header__menu-caret { display: inline-flex; transition: transform 320ms var(--hd-ease); }
  .header__menu-link:hover,
  .header__menu-item:focus-within > .header__menu-link { opacity: 1; }
  .header__menu-link:hover::after,
  .header__menu-item:focus-within > .header__menu-link::after { transform: scaleX(1); transform-origin: left center; }
  .header__menu-item--has-dropdown:hover .header__menu-caret,
  .header__menu-item--has-dropdown:focus-within .header__menu-caret { transform: rotate(180deg); }
  .header__menu-link[aria-current='page'] { opacity: 1; color: var(--color-accent-readable, #C9A24D); }
  .header__menu-link[aria-current='page']::after { transform: scaleX(1); }

  /* Submenus */
  .header__submenu {
    position: absolute;
    top: calc(100% + 10px);
    left: -16px;
    min-width: 220px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background-color: rgba(14, 14, 18, 0.95);
    border: none;
    border-radius: 12px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 200ms ease, transform 240ms var(--hd-ease), visibility 0s linear 240ms;
    z-index: 20;
  }
  .header__menu-item--has-dropdown:hover > .header__submenu,
  .header__menu-item--has-dropdown:focus-within > .header__submenu {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .header__submenu-link {
    display: block;
    padding: 8px 12px;
    font-size: var(--f1, 0.8125rem);
    color: #ffffff;
    text-decoration: none;
    border-radius: 6px;
    opacity: 0.85;
    transition: opacity 180ms ease, background-color 180ms ease;
  }
  .header__submenu-link:hover { opacity: 1; background-color: rgba(255, 255, 255, 0.08); }

  /* Ações */
  .header__actions { display: flex; align-items: center; gap: 2px; }
  .header__action-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-text, #ffffff);
    background: transparent;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 200ms ease, transform 200ms ease;
  }
  .header__action-button:hover { background-color: rgba(255, 255, 255, 0.08); }
  .header__action-button:active { transform: scale(0.92); }

  .header__cart-count {
    position: absolute;
    top: 4px;
    right: 3px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    font-size: 9px;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
    color: var(--color-text-on-accent, #000);
    background-color: var(--color-accent, #C9A24D);
    border-radius: 8px;
  }

  /* Busca */
  .header__search { position: relative; }
  .header__search summary { list-style: none; cursor: pointer; }
  .header__search summary::-webkit-details-marker { display: none; }
  .header__search-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(340px, calc(100vw - 32px));
    padding: 8px;
    background-color: rgba(14, 14, 18, 0.95);
    border-radius: 12px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 20;
  }
  .header__search-form { position: relative; display: flex; align-items: center; }
  .header__search-icon { position: absolute; left: 12px; color: rgba(255, 255, 255, 0.5); pointer-events: none; }
  .header__search-icon svg { width: 16px; height: 16px; }
  .header__search-input {
    width: 100%;
    padding: 8px 44px 8px 36px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.08);
    border: none;
    color: #ffffff;
    outline: none;
  }
  .header__search-submit {
    position: absolute;
    right: 4px;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-accent, #C9A24D);
    border: none;
    border-radius: 6px;
    cursor: pointer;
  }

  /* Burger */
  .header__menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    width: 40px;
    height: 40px;
    padding: 0;
    cursor: pointer;
  }
  .header__burger,
  .header__burger::before,
  .header__burger::after {
    display: block;
    width: 18px;
    height: 2px;
    background-color: var(--color-text, #ffffff);
    border-radius: 2px;
    transition: transform 300ms var(--hd-ease), top 300ms var(--hd-ease);
  }
  .header__burger { position: relative; }
  .header__burger::before { content: ''; position: absolute; top: -5px; left: 0; }
  .header__burger::after { content: ''; position: absolute; top: 5px; left: 0; width: 12px; }
  .header__menu-toggle:hover .header__burger::after { width: 18px; }
  .header__menu-toggle[aria-expanded='true'] .header__burger { background-color: transparent; }
  .header__menu-toggle[aria-expanded='true'] .header__burger::before { top: 0; transform: rotate(45deg); }
  .header__menu-toggle[aria-expanded='true'] .header__burger::after { top: 0; width: 18px; transform: rotate(-45deg); }

  /* Mobile Drawer */
  .header__scrim {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    z-index: 150;
    transition: opacity 300ms ease;
  }
  .header__scrim.is-open { opacity: 1; }

  .header__mobile-nav {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    height: 100dvh;
    width: min(85vw, 360px);
    display: flex;
    flex-direction: column;
    background-color: rgba(12, 12, 15, 0.98);
    border-right: none;
    box-shadow: 10px 0 30px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 160;
    transform: translateX(-100%);
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .header__mobile-nav.is-open { transform: translateX(0); }

  .header__mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .header__mobile-title { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-accent-readable, #C9A24D); }
  .header__mobile-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.06);
    border: none;
    border-radius: 50%;
    color: #ffffff;
    cursor: pointer;
  }

  .header__mobile-body { flex: 1; overflow-y: auto; padding: 8px 18px 20px; }
  .header__mobile-menu { list-style: none; margin: 0; padding: 0; }
  .header__mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .header__mobile-link-text { display: inline-flex; align-items: center; gap: 10px; }
  .header__mobile-index { font-size: 0.6875rem; color: var(--color-accent-readable, #C9A24D); }

  .header__mobile-footer {
    padding: 14px 18px calc(14px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .header__mobile-account-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 12px 14px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    text-decoration: none;
    font-size: 0.85rem;
  }

  /* Responsivo */
  @media screen and (max-width: 1000px) {
    .header__nav { display: none; }
    .header__account--desktop { display: none !important; }
    .header__account--mobile { display: inline-flex; }

    .header__inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 8px;
      padding-top: 5px;
      padding-bottom: 5px;
    }
    .header__left-group { grid-column: 1; justify-self: start; }
    .header__logo-link { grid-column: 2; justify-self: center; margin: 0; }
    .header__actions { grid-column: 3; justify-self: end; }
    .header__logo-image { max-height: 26px; }

    .header__search { position: static; }
    .header__search-panel {
      position: absolute;
      top: 100%;
      left: 10px;
      right: 10px;
      width: auto;
    }
  }

  @media screen and (min-width: 1001px) {
    .header__account--mobile { display: none !important; }
    .header__account--desktop { display: inline-flex; }
    .header__menu-toggle { display: none; }
    .header__scrim, .header__mobile-nav { display: none !important; }
  }
</style>

<script>
  (function () {
    var header = document.querySelector('.header[data-section-id="{{ section.id }}"]');
    if (!header) return;

    var progress = header.querySelector('[data-header-progress]');
    var search = header.querySelector('[data-header-search]');
    var drawer = document.getElementById('MobileNav-{{ section.id }}');

    var SCROLLED_AT = 10;
    var state = { scrolled: null };
    var ticking = false;

    function medirAviso() {
      var barra = document.querySelector('[class*="section-aviso"]');
      var noTopo = barra && barra.nextElementSibling &&
        barra.nextElementSibling.classList.contains('section-header');

      if (!noTopo) {
        document.documentElement.style.removeProperty('--aviso-altura');
        if (barra) barra.classList.remove('aviso-fixa');
        return;
      }

      barra.classList.add('aviso-fixa');
      document.documentElement.style.setProperty('--aviso-altura', barra.offsetHeight + 'px');
    }

    var alturaRolavel = 0;
    function medirAltura() {
      alturaRolavel = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
    }

    function setScrolled(value) {
      if (state.scrolled === value) return;
      state.scrolled = value;
      header.classList.toggle('header--scrolled', value);
      document.documentElement.classList.toggle('rolou', value);
    }

    function update() {
      ticking = false;
      var y = Math.max(0, window.scrollY || document.documentElement.scrollTop);

      setScrolled(y > SCROLLED_AT);

      if (progress) {
        var ratio = alturaRolavel > 0 ? Math.min(1, y / alturaRolavel) : 0;
        progress.style.transform = 'scaleX(' + ratio.toFixed(4) + ')';
      }
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(update);
      }
    }

    function remedir() {
      medirAltura();
      onScroll();
    }

    medirAviso();
    window.addEventListener('resize', medirAviso);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(medirAviso);

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', remedir);
    window.addEventListener('load', remedir);

    medirAltura();
    update();

    /* Busca */
    if (search) {
      search.addEventListener('toggle', function () {
        if (!search.open) return;
        var input = search.querySelector('input[type="search"]');
        if (input) window.setTimeout(function () { input.focus(); }, 30);
      });
      document.addEventListener('click', function (event) {
        if (search.open && !search.contains(event.target)) search.open = false;
      });
    }

    /* Mobile Drawer */
    var toggle = header.querySelector('.header__menu-toggle');
    var closeBtn = document.querySelector('[data-mobile-close]');
    var scrim = document.querySelector('[data-mobile-scrim]');

    function openDrawer() {
      drawer.hidden = false;
      scrim.hidden = false;
      document.body.classList.add('bloquear');
      window.requestAnimationFrame(function () {
        drawer.classList.add('is-open');
        scrim.classList.add('is-open');
      });
      if (toggle) toggle.setAttribute('aria-expanded', 'true');
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      scrim.classList.remove('is-open');
      document.body.classList.remove('bloquear');
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
      window.setTimeout(function () {
        drawer.hidden = true;
        scrim.hidden = true;
      }, 400);
    }

    if (drawer && scrim) {
      if (toggle) {
        toggle.addEventListener('click', function () {
          if (toggle.getAttribute('aria-expanded') === 'true') closeDrawer();
          else openDrawer();
        });
      }
      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
      scrim.addEventListener('click', closeDrawer);
    }
  })();
</script>

