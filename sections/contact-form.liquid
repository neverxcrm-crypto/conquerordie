{%- comment -%}
  ============================================================
  CONTACT FORM — formulário de contato nativo
  ============================================================

  O QUE FAZ:
  Renderiza o formulário de contato usando {% form 'contact' %} do
  Shopify (envia email para a loja). Campos: nome, email (required),
  telefone e mensagem. Mostra avisos de sucesso e de erros de validação.

  ONDE É USADA:
  Template page.contact (ou onde a seção for adicionada via preset).

  PRINCIPAIS PARTES:
  - form 'contact': envio nativo, sem backend próprio
  - Pré-preenche valores com dados do customer, se logado
  - Bloco de erros com âncoras para cada campo inválido
  - Telefone usa type="tel"; textarea tem resize desativado
  - Setting: heading; tem preset (aparece no theme editor)

  OBSERVAÇÕES:
  Os name= de nome/telefone usam a label traduzida (padrão Shopify).
{%- endcomment -%}

{%- assign form_id = 'ContactForm-' | append: section.id -%}

<section class="contact page-width" data-section-id="{{ section.id }}">
  <header class="page-header contact__header">
    <div class="page-header__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="page-header__title">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="page-header__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </header>

  <div class="contact__grid">
   <div class="contact__coluna">
  {%- form 'contact', id: form_id, class: 'contact__form' -%}
    {%- if form.posted_successfully? -%}
      <div class="contact__notice contact__notice--success" role="status" tabindex="-1">
        {{ 'templates.contact.form.post_success' | t }}
      </div>
    {%- elsif form.errors -%}
      <div class="contact__notice contact__notice--error" role="alert" tabindex="-1">
        <h2 class="contact__notice-title">{{ 'templates.contact.form.error_heading' | t }}</h2>
        <ul class="contact__errors" role="list">
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                <a href="#ContactForm-{{ field }}-{{ section.id }}">
                  {{ form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="contact__field">
      <label class="field__label" for="ContactForm-name-{{ section.id }}">
        {{ 'templates.contact.form.name' | t }}
      </label>
      <input
        type="text"
        class="field__input"
        id="ContactForm-name-{{ section.id }}"
        name="contact[{{ 'templates.contact.form.name' | t }}]"
        value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        autocomplete="name"
        spellcheck="false"
      >
    </div>

    <div class="contact__field">
      <label class="field__label" for="ContactForm-email-{{ section.id }}">
        {{ 'templates.contact.form.email' | t }}
      </label>
      <input
        type="email"
        class="field__input"
        id="ContactForm-email-{{ section.id }}"
        name="contact[email]"
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="ContactForm-email-erro-{{ section.id }}"{% endif %}
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        required
      >
      {%- if form.errors contains 'email' -%}
        <p class="field__error" id="ContactForm-email-erro-{{ section.id }}">
          {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
        </p>
      {%- endif -%}
    </div>

    <div class="contact__field">
      <label class="field__label" for="ContactForm-phone-{{ section.id }}">
        {{ 'templates.contact.form.phone' | t }}
      </label>
      <input
        type="tel"
        class="field__input"
        id="ContactForm-phone-{{ section.id }}"
        name="contact[{{ 'templates.contact.form.phone' | t }}]"
        value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
        autocomplete="tel"
        spellcheck="false"
      >
    </div>

    <div class="contact__field">
      <label class="field__label" for="ContactForm-body-{{ section.id }}">
        {{ 'templates.contact.form.comment' | t }}
      </label>
      <textarea
        rows="6"
        class="field__input contact__textarea"
        id="ContactForm-body-{{ section.id }}"
        name="contact[body]"
        spellcheck="false"
      >{% if form.body %}{{ form.body }}{% endif %}</textarea>
    </div>

    <button type="submit" class="button contact__submit" data-contato-enviar>
      {{ 'templates.contact.form.send' | t }}
    </button>
  {%- endform -%}
   </div>

   {%- comment -%}
     Painel de atendimento: quem chega aqui muitas vezes quer falar
     AGORA, não preencher formulário. O WhatsApp e o horário vêm
     primeiro por isso — o formulário fica para quem prefere escrever.
   {%- endcomment -%}
   <aside class="contact__aside">
     {%- if section.settings.hours_title != blank or section.settings.hours != blank -%}
       <div class="contact__bloco">
         <h2 class="contact__bloco-titulo">{{ section.settings.hours_title | escape }}</h2>
         <p class="contact__bloco-texto">{{ section.settings.hours | newline_to_br }}</p>
       </div>
     {%- endif -%}

     <ul class="contact__canais" role="list">
       {%- if section.settings.whatsapp != blank -%}
         <li>
           <a class="contact__canal" href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}" target="_blank" rel="noopener">
             <span class="contact__canal-rotulo">WhatsApp</span>
             <span class="contact__canal-valor">{{ section.settings.whatsapp | escape }}</span>
             {% render 'icon', name: 'arrow-right' %}
           </a>
         </li>
       {%- endif -%}
       {%- if section.settings.email != blank -%}
         <li>
           <a class="contact__canal" href="mailto:{{ section.settings.email }}">
             <span class="contact__canal-rotulo">E-mail</span>
             <span class="contact__canal-valor">{{ section.settings.email | escape }}</span>
             {% render 'icon', name: 'arrow-right' %}
           </a>
         </li>
       {%- endif -%}
       {%- if settings.social_instagram_link != blank -%}
         <li>
           <a class="contact__canal" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">
             <span class="contact__canal-rotulo">Instagram</span>
             <span class="contact__canal-valor">{{ section.settings.instagram_handle | default: '@conquerordie' | escape }}</span>
             {% render 'icon', name: 'arrow-right' %}
           </a>
         </li>
       {%- endif -%}
     </ul>

     {%- if section.settings.faq_page != blank -%}
       <a class="arrow-link contact__faq" href="{{ pages[section.settings.faq_page].url }}">
         {{ section.settings.faq_label | escape }}
         {% render 'icon', name: 'arrow-right' %}
       </a>
     {%- endif -%}
   </aside>
  </div>
</section>

{%- comment -%}
  O formulário é nativo (POST + recarregamento). Este pedacinho só
  marca o botão como ocupado no instante do envio: sem ele a pessoa
  clica, nada muda na tela por um segundo e ela clica de novo.
{%- endcomment -%}
<script>
  (function () {
    var form = document.getElementById('{{ form_id }}');
    if (!form) return;
    form.addEventListener('submit', function () {
      var botao = form.querySelector('[data-contato-enviar]');
      if (botao) botao.setAttribute('aria-busy', 'true');
    });
  })();
</script>

<style>
  .contact {
    padding-top: var(--space-md);
    padding-bottom: var(--space-section);
    max-width: var(--page-width);
  }
  .contact__header { padding-bottom: var(--space-lg); }

  /* Formulário e atendimento lado a lado: são dois caminhos para a
     mesma tarefa, não um principal e um rodapé. */
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: start;
  }

  .contact__form { display: grid; gap: var(--space-sm); }
  .contact__field { display: grid; gap: 6px; }
  .contact__textarea { resize: vertical; min-height: 140px; }
  .contact__submit { justify-self: start; min-width: 200px; }

  /* ---------- Avisos ---------- */
  .contact__notice {
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--f2);
  }
  .contact__notice--success {
    color: var(--color-text-primary);
    background-color: var(--color-accent-muted);
    box-shadow: inset 0 0 0 1px var(--color-border-accent);
  }
  .contact__notice--error {
    color: var(--color-text-primary);
    box-shadow: inset 0 0 0 1px var(--color-error);
  }
  .contact__notice-title { font-size: var(--f3); margin: 0 0 var(--space-2xs); }
  .contact__errors { margin: 0; padding-left: 1.2em; }
  .contact__errors a { color: inherit; }

  /* ---------- Painel de atendimento ---------- */
  .contact__aside {
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }
  .contact__bloco-titulo {
    font-family: var(--font-ui-family);
    font-size: var(--f0);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-2xs);
  }
  .contact__bloco-texto {
    font-size: var(--f3);
    line-height: var(--leading-heading);
    color: var(--color-text-primary);
    margin: 0;
  }

  .contact__canais { display: grid; gap: var(--space-2xs); list-style: none; margin: 0; padding: 0; }
  .contact__canal {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 56px;
    padding: var(--space-2xs) 0;
    color: var(--color-text-primary);
    text-decoration: none;
    border-top: 1px solid var(--color-border);
    transition: color var(--dur-normal) var(--ease-out);
  }
  .contact__canal-rotulo {
    grid-column: 1;
    font-family: var(--font-ui-family);
    font-size: var(--f0);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .contact__canal-valor {
    grid-column: 1;
    font-size: var(--f2);
    font-weight: var(--font-weight-medium);
  }
  .contact__canal svg {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 14px;
    height: 14px;
    color: var(--color-accent-readable);
    transition: transform var(--dur-normal) var(--ease-out);
  }
  .contact__canal:hover { color: var(--color-accent-readable); }
  .contact__canal:hover svg { transform: translateX(4px); }

  .contact__faq { color: var(--color-text-primary); }

  @media screen and (max-width: 1000px) {
    /* No celular o atendimento vem PRIMEIRO: quem abre o contato
       pelo telefone quase sempre quer falar agora, não escrever. */
    .contact__grid { grid-template-columns: 1fr; gap: var(--space-lg); }
    .contact__aside { order: -1; }
    .contact__submit { width: 100%; }
  }
</style>

{% schema %}
{
  "name": "t:sections.contact_form.name",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Rótulo", "default": "Atendimento" },
    { "type": "text", "id": "heading", "label": "t:sections.contact_form.settings.heading.label", "default": "Fale com a gente" },
    { "type": "text", "id": "text", "label": "Texto de apoio", "default": "Estamos aqui para ajudar." },
    { "type": "header", "content": "Painel de atendimento" },
    { "type": "text", "id": "hours_title", "label": "Título do horário", "default": "Horário" },
    { "type": "textarea", "id": "hours", "label": "Horário", "default": "Seg — Sex\n09:00 — 18:00" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp", "info": "Com DDI e DDD. Ex.: +55 11 99999-9999" },
    { "type": "text", "id": "email", "label": "E-mail" },
    { "type": "text", "id": "instagram_handle", "label": "Instagram (@)", "default": "@conquerordie", "info": "O link vem das redes sociais nas configurações do tema." },
    { "type": "header", "content": "Perguntas frequentes" },
    { "type": "page", "id": "faq_page", "label": "Página de FAQ" },
    { "type": "text", "id": "faq_label", "label": "Rótulo do link", "default": "Ver perguntas frequentes" }
  ],
  "presets": [
    { "name": "t:sections.contact_form.name" }
  ]
}
{% endschema %}
