{%- comment -%}
  ============================================================
  RELATED PRODUCTS — Recomendações Premium (Performance & Shimmer)
  ============================================================
{%- endcomment -%}

{%- liquid
  assign colunas = section.settings.columns_desktop | default: 4
  assign quantidade = section.settings.products_to_show | default: 4
  assign intencao = section.settings.intent | default: 'related'
-%}

{%- if section.settings.enable -%}
  <product-recommendations
    class="relacionados page-width"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ quantidade }}&intent={{ intencao }}"
    data-quantidade="{{ quantidade }}"
    {% if request.design_mode %}data-editor="1"{% endif %}
    style="--grid-columns: {{ colunas }};"
  >
    {%- if recommendations.performed -%}
      {%- if recommendations.products_count > 0 -%}
        <div class="relacionados__topo">
          {%- if section.settings.eyebrow != blank -%}
            <p class="relacionados__eyebrow animate-el">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="relacionados__titulo animate-el">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>

        <ul class="relacionados__grade" role="list">
          {%- for recomendado in recommendations.products -%}
            <li class="relacionados__item" data-reveal style="--item-index: {{ forloop.index }};">
              {% render 'card-product', card_product: recomendado, columns: colunas %}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- else -%}
      {%- comment -%}
        ESQUELETO PREMIUM (SHIMMER EFFECT)
        Reserva o espaço e mostra uma animação de carregamento antes do fetch terminar.
        Evita saltos no ecrã (CLS) e melhora a percepção de velocidade.
      {%- endcomment -%}
      <div class="relacionados__topo" aria-hidden="true">
        {%- if section.settings.eyebrow != blank -%}
          <p class="relacionados__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="relacionados__titulo">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      
      <ul class="relacionados__grade" role="list" aria-hidden="true">
        {%- for i in (1..quantidade) -%}
          <li class="relacionados__item relacionados__item--esqueleto">
            <div class="skeleton skeleton--media"></div>
            <div class="skeleton__info">
              <div class="skeleton skeleton--titulo"></div>
              <div class="skeleton skeleton--preco"></div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </product-recommendations>

  <style>
    /* ==========================================================
       ESTRUTURA BASE (Fluxo Normal, Sem Posições Fixas)
       ========================================================== */
    .section-related-products {
      position: relative; /* Fluxo normal da página, nunca fixo */
      padding-block: clamp(60px, 8vw, 100px);
      background-color: var(--color-background, #0A0A0C);
      overflow: hidden;
    }

    product-recommendations { 
      display: block; 
      width: 100%;
    }

    /* ==========================================================
       TOPO E TIPOGRAFIA
       ========================================================== */
    .relacionados__topo {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-2xs, 8px);
      margin-bottom: clamp(32px, 5vw, 56px);
    }

    .relacionados__eyebrow {
      font-family: var(--font-heading-family, inherit);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--color-accent, #C9A24D);
      margin: 0;
    }

    .relacionados__titulo {
      font-family: var(--font-heading-family, inherit);
      font-size: clamp(1.8rem, 4vw, 3rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin: 0;
      color: var(--color-text-primary, #ffffff);
    }

    /* ==========================================================
       GRADE DE PRODUTOS (Desktop e Mobile)
       ========================================================== */
    .relacionados__grade {
      display: grid;
      gap: var(--space-md, 24px);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    @media screen and (min-width: 750px) {
      .relacionados__grade {
        /* Usa a variável do Shopify para gerar as colunas exatas */
        grid-template-columns: repeat(var(--grid-columns, 4), minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      /* Mobile Swipe Carousel elegante */
      .relacionados__grade {
        grid-template-columns: none;
        grid-auto-flow: column;
        /* Mostra quase 2 inteiros (44%), deixando a borda do 3º visível para instigar o swipe */
        grid-auto-columns: calc(46% - 8px);
        gap: 16px;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        
        padding-inline: max(16px, env(safe-area-inset-left));
        margin-inline: calc(-1 * max(16px, env(safe-area-inset-left)));
        scroll-padding-left: max(16px, env(safe-area-inset-left));
        padding-bottom: 24px; /* Espaço para sombras dos cards não cortarem */
      }
      
      .relacionados__grade::-webkit-scrollbar { display: none; }
      .relacionados__item { scroll-snap-align: start; }
    }

    /* ==========================================================
       ANIMAÇÃO DE ENTRADA (Fade Up)
       ========================================================== */
    .js .relacionados__item[data-reveal] {
      opacity: 0;
      transform: translateY(20px);
    }
    
    .js .relacionados__item[data-reveal].is-revealed {
      opacity: 1;
      transform: none;
      transition: opacity 0.6s cubic-bezier(0.21, 0.85, 0.32, 1), transform 0.6s cubic-bezier(0.21, 0.85, 0.32, 1);
      transition-delay: calc(var(--item-index, 1) * 60ms);
    }

    /* ==========================================================
       ESQUELETO PREMIUM (SHIMMER)
       ========================================================== */
    .relacionados__item--esqueleto {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .skeleton {
      background: linear-gradient(90deg, rgba(255,255,255,0.05) 25%, rgba(255,255,255,0.12) 50%, rgba(255,255,255,0.05) 75%);
      background-size: 200% 100%;
      animation: skeleton-shimmer 1.8s infinite linear;
      border-radius: var(--radius-sm, 6px);
    }

    .skeleton--media {
      width: 100%;
      aspect-ratio: var(--card-aspect-ratio, 3/4); /* Mantém proporção igual aos produtos */
    }

    .skeleton__info {
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: center; /* Se os seus cards originais forem centralizados */
    }

    .skeleton--titulo { height: 14px; width: 75%; }
    .skeleton--preco { height: 14px; width: 40%; }

    @keyframes skeleton-shimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    .relacionados__vazio {
      margin: 0;
      padding: var(--space-md);
      border: 1px dashed var(--color-border-strong, rgba(255,255,255,0.2));
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      color: var(--color-text-muted, rgba(255,255,255,0.5));
      text-align: center;
    }

    @media (prefers-reduced-motion: reduce) {
      .js .relacionados__item[data-reveal] { opacity: 1; transform: none; }
      .js .relacionados__item[data-reveal].is-revealed { transition: none; transition-delay: 0s; }
      .skeleton { animation: none; background: rgba(255,255,255,0.08); }
    }
  </style>

  <script>
    if (!customElements.get('product-recommendations')) {
      customElements.define('product-recommendations', class extends HTMLElement {
        connectedCallback() {
          if (this.__iniciado) return;
          this.__iniciado = true;

          var self = this;
          
          /* Intersection Observer: Só descarrega os produtos se a secção estiver quase visível */
          var observador = new IntersectionObserver(function (entradas) {
            if (!entradas[0].isIntersecting) return;
            observador.disconnect();
            self.buscar();
          }, { rootMargin: '0px 0px 400px 0px' });
          
          observador.observe(this);
        }

        buscar() {
          var url = this.dataset.url;
          if (!url) return;
          var self = this;

          fetch(url)
            .then(function (resposta) {
              if (!resposta.ok) throw new Error('HTTP ' + resposta.status);
              return resposta.text();
            })
            .then(function (texto) {
              var caixa = document.createElement('div');
              caixa.innerHTML = texto;
              var novo = caixa.querySelector('product-recommendations');
              var temProdutos = novo && novo.querySelector('.relacionados__item:not(.relacionados__item--esqueleto)');

              if (!temProdutos) { self.semResultado(); return; }

              self.innerHTML = novo.innerHTML;

              /* Aciona a animação de Fade-Up se a função global CODRevelar existir */
              if (typeof window.CODRevelar === 'function') {
                window.CODRevelar(self);
              } else {
                self.querySelectorAll('[data-reveal]').forEach(function (el) {
                  el.classList.add('is-revealed');
                });
              }
            })
            .catch(function () {
              self.semResultado();
            });
        }

        semResultado() {
          if (this.dataset.editor) {
            this.innerHTML =
              '<p class="relacionados__vazio">Nenhuma recomendação disponível para este produto ainda. ' +
              'Para "complete o look", ligue produtos complementares no app Search &amp; Discovery.</p>';
            return;
          }
          var hospedeiro = this.closest('.shopify-section') || this;
          hospedeiro.hidden = true;
        }
      });
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.related_products.name",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "default": true,
      "label": "t:sections.related_products.settings.enable.label"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "O que recomendar",
      "options": [
        { "value": "related", "label": "Produtos parecidos (Automático)" },
        { "value": "complementary", "label": "Complete o look (Manual no App Search & Discovery)" }
      ],
      "default": "related",
      "info": "\"Complete o look\" usa os produtos que liga no app Search & Discovery da Shopify."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Chapéu",
      "info": "Texto curto acima do título. Opcional."
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Você também pode gostar",
      "label": "t:sections.related_products.settings.heading.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "t:sections.related_products.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "unit": "col",
      "label": "Colunas no computador"
    }
  ],
  "presets": [{ "name": "t:sections.related_products.name" }]
}
{% endschema %}