{%- comment -%}
  ============================================================
  CAMPAIGN — próximo drop / campanha em fotografia
  ============================================================

  O QUE FAZ:
  Faixa full-bleed de campanha: fotografia grande, eyebrow do drop,
  título Display, uma linha de texto, CTA e um countdown opcional.
  É o momento de URGÊNCIA da narrativa da home — e só funciona se a
  data for real, por isso o countdown é opt-in e some sozinho quando
  a data passa.

  ONDE É USADA:
  Home (templates/index.json). Tem preset.

  PRINCIPAIS PARTES:
  - .campaign__media: imagem (desktop) + image_mobile opcional.
  - .campaign__content: eyebrow, heading, texto e CTA.
  - .campaign__countdown: 4 pares número/label. Só renderiza com
    show_countdown ativo E uma data futura preenchida.

  COUNTDOWN:
  - A data vem do setting 'countdown_date' (YYYY-MM-DD) + hora.
  - O HTML já nasce com os valores certos calculados no servidor,
    então não há "flash" de zeros; o JS apenas continua a contagem.
  - Quando zera, o bloco inteiro é removido do DOM — nada de
    contador negativo ou travado em 00.
  - Sem JS, os números renderizados no servidor continuam corretos.

  OBSERVAÇÕES:
  - .scheme-dark: a seção vive dentro do <main> claro e precisa dos
    tokens escuros para o texto sobre a foto.
  - Overlay usa os tokens --photo-veil-*, os mesmos do hero.
{%- endcomment -%}
{%- liquid
  assign show_countdown = false
  if section.settings.show_countdown and section.settings.countdown_date != blank
    assign deadline_string = section.settings.countdown_date | append: 'T' | append: section.settings.countdown_time | append: ':00'
    assign deadline = deadline_string | date: '%s' | plus: 0
    assign now_ts = 'now' | date: '%s' | plus: 0
    assign remaining = deadline | minus: now_ts
    if remaining > 0
      assign show_countdown = true
      assign days = remaining | divided_by: 86400
      assign after_days = remaining | modulo: 86400
      assign hours = after_days | divided_by: 3600
      assign after_hours = after_days | modulo: 3600
      assign minutes = after_hours | divided_by: 60
      assign seconds = after_hours | modulo: 60
    endif
  endif
-%}
<div class="campaign scheme-dark" data-section-id="{{ section.id }}">
  <div class="campaign__media" data-parallax="0.12">
    {%- if section.settings.image != blank -%}
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.image_mobile | image_url: width: 750 }} 750w,
              {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w
            "
            sizes="100vw"
          >
          {{
            section.settings.image
            | image_url: width: 2600
            | image_tag:
              loading: 'lazy',
              class: 'campaign__image',
              widths: '900, 1200, 1600, 2000, 2600',
              sizes: '100vw',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        </picture>
      {%- else -%}
        {{
          section.settings.image
          | image_url: width: 2600
          | image_tag:
            loading: 'lazy',
            class: 'campaign__image',
            widths: '900, 1200, 1600, 2000, 2600',
            sizes: '100vw',
            alt: section.settings.image.alt | default: section.settings.heading | escape
        }}
      {%- endif -%}
    {%- else -%}
      <div class="campaign__image campaign__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <div class="campaign__inner page-width">
    <div class="campaign__content" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="campaign__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="campaign__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button button--secondary campaign__cta">
          {{ section.settings.button_label | escape }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    {%- if show_countdown -%}
      <div class="campaign__aside" data-countdown data-deadline="{{ deadline }}">
        {%- if section.settings.countdown_label != blank -%}
          <p class="eyebrow campaign__countdown-label">{{ section.settings.countdown_label | escape }}</p>
        {%- endif -%}
        <ul class="campaign__countdown" role="list">
          <li class="campaign__unit">
            <span class="campaign__number" data-countdown-days>{{ days | prepend: '0' | slice: -2, 2 }}</span>
            <span class="campaign__label">{{ 'sections.campaign.days' | t }}</span>
          </li>
          <li class="campaign__unit">
            <span class="campaign__number" data-countdown-hours>{{ hours | prepend: '0' | slice: -2, 2 }}</span>
            <span class="campaign__label">{{ 'sections.campaign.hours' | t }}</span>
          </li>
          <li class="campaign__unit">
            <span class="campaign__number" data-countdown-minutes>{{ minutes | prepend: '0' | slice: -2, 2 }}</span>
            <span class="campaign__label">{{ 'sections.campaign.minutes' | t }}</span>
          </li>
          <li class="campaign__unit">
            <span class="campaign__number" data-countdown-seconds>{{ seconds | prepend: '0' | slice: -2, 2 }}</span>
            <span class="campaign__label">{{ 'sections.campaign.seconds' | t }}</span>
          </li>
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .campaign {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 68vh;
    overflow: hidden;
    background-color: var(--color-background);
  }
  .campaign__media { position: absolute; inset: 0; }
  .campaign__image { width: 100%; height: 100%; object-fit: cover; display: block; }
  .campaign__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface);
    height: 100%;
  }
  .campaign__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--photo-veil-side);
  }

  .campaign__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
    padding-top: var(--space-section);
    padding-bottom: var(--space-section);
  }
  .campaign__content { max-width: 32rem; }
  .campaign__content .eyebrow { margin-bottom: 16px; }
  .campaign__heading { font-size: var(--f7); margin-bottom: 12px; }
  .campaign__text { font-size: var(--f2); color: var(--color-text-secondary); margin-bottom: 28px; }
  .campaign__cta { min-width: 200px; }

  /* Countdown editorial: números grandes, rótulos minúsculos.
     Sem caixas, sem separadores piscando. */
  .campaign__aside { text-align: right; }
  .campaign__countdown-label { margin-bottom: 14px; }
  .campaign__countdown {
    display: flex;
    gap: clamp(20px, 3vw, 40px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .campaign__unit { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .campaign__number {
    font-family: var(--font-ui-family);
    font-size: var(--f5);
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-primary);
    line-height: 1;
  }
  .campaign__label {
    font-family: var(--font-ui-family);
    font-size: var(--f0);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media screen and (max-width: 1000px) {
    .campaign { min-height: 76vh; }
    .campaign__media::after { background: var(--photo-veil-bottom); }
    .campaign__inner { flex-direction: column; align-items: flex-start; gap: 36px; }
    .campaign__aside { text-align: left; }
    .campaign__countdown { gap: 24px; }
    .campaign__cta { width: 100%; }
  }
</style>

{%- if show_countdown -%}
  <script>
    (function () {
      var section = document.querySelector('.campaign[data-section-id="{{ section.id }}"]');
      var root = section && section.querySelector('[data-countdown][data-deadline]');
      if (!root) return;

      var deadline = parseInt(root.getAttribute('data-deadline'), 10) * 1000;
      var fields = {
        days: root.querySelector('[data-countdown-days]'),
        hours: root.querySelector('[data-countdown-hours]'),
        minutes: root.querySelector('[data-countdown-minutes]'),
        seconds: root.querySelector('[data-countdown-seconds]')
      };

      function pad(n) { return (n < 10 ? '0' : '') + n; }

      /* Escreve so quando o valor MUDOU. Os dias mudam uma vez por
         dia, as horas uma vez por hora: sem esta guarda o contador
         reescrevia os quatro campos a cada segundo, e cada escrita
         num no de texto custa layout + paint da caixa do numero. */
      function escrever(campo, valor) {
        if (!campo || campo.textContent === valor) return;
        campo.textContent = valor;
      }

      var acabou = false;

      function tick() {
        var remaining = Math.floor((deadline - Date.now()) / 1000);
        if (remaining <= 0) {
          // Acabou: o bloco some em vez de ficar zerado na tela.
          acabou = true;
          parar();
          root.remove();
          return;
        }
        escrever(fields.days, pad(Math.floor(remaining / 86400)));
        escrever(fields.hours, pad(Math.floor((remaining % 86400) / 3600)));
        escrever(fields.minutes, pad(Math.floor((remaining % 3600) / 60)));
        escrever(fields.seconds, pad(remaining % 60));
      }

      /* ---------------------------------------------------------
         O contador so anda quando ALGUEM PODE VE-LO.

         Antes era um setInterval solto: enquanto a pagina estivesse
         aberta ele acordava a thread principal uma vez por segundo,
         para sempre — inclusive com a section rolada para longe da
         tela, e inclusive com o site numa aba de fundo ou com o
         celular no bolso. Um relogio que ninguem esta olhando e
         custo puro: CPU, bateria e um frame gasto por segundo que
         podia estar servindo a rolagem.

         Parar nao desalinha nada: tick() recalcula o tempo a partir
         de Date.now() toda vez, nunca de um acumulador. Entao ao
         voltar a ficar visivel ele ja aparece com a hora certa, sem
         "recuperar" segundos perdidos.
      --------------------------------------------------------- */
      var timer = null;
      var naTela = true;

      function parar() {
        if (timer === null) return;
        window.clearInterval(timer);
        timer = null;
      }

      function andar() {
        if (timer !== null || acabou) return;
        tick();                              // acerta o relogio na hora
        // tick() pode ter descoberto que o prazo ja venceu: ai nao
        // ha contador nenhum para manter andando.
        if (!acabou) timer = window.setInterval(tick, 1000);
      }

      function sincronizar() {
        if (naTela && !document.hidden) andar();
        else parar();
      }

      document.addEventListener('visibilitychange', sincronizar);

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          naTela = entries[0].isIntersecting;
          sincronizar();
        }, { rootMargin: '120px 0px' }).observe(root);
      }

      sincronizar();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.campaign.name",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.campaign.settings.image.label" },
    { "type": "image_picker", "id": "image_mobile", "label": "t:sections.campaign.settings.image_mobile.label", "info": "t:sections.campaign.settings.image_mobile.info" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.campaign.settings.eyebrow.label" },
    { "type": "text", "id": "heading", "label": "t:sections.campaign.settings.heading.label" },
    { "type": "text", "id": "text", "label": "t:sections.campaign.settings.text.label" },
    { "type": "text", "id": "button_label", "label": "t:sections.campaign.settings.button_label.label" },
    { "type": "url", "id": "button_link", "label": "t:sections.campaign.settings.button_link.label" },
    { "type": "header", "content": "t:sections.campaign.settings.header__countdown.content" },
    { "type": "checkbox", "id": "show_countdown", "default": false, "label": "t:sections.campaign.settings.show_countdown.label", "info": "t:sections.campaign.settings.show_countdown.info" },
    { "type": "text", "id": "countdown_label", "label": "t:sections.campaign.settings.countdown_label.label" },
    { "type": "text", "id": "countdown_date", "label": "t:sections.campaign.settings.countdown_date.label", "info": "t:sections.campaign.settings.countdown_date.info" },
    { "type": "text", "id": "countdown_time", "default": "00:00", "label": "t:sections.campaign.settings.countdown_time.label" }
  ],
  "presets": [{ "name": "t:sections.campaign.name" }]
}
{% endschema %}
