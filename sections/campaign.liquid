{%- comment -%}
  ============================================================
  CAMPAIGN PREMIUM — Banner de Drop c/ Countdown Inteligente
  ============================================================
{%- endcomment -%}

{%- liquid
  assign show_countdown = false
  if section.settings.show_countdown and section.settings.countdown_date != blank
    assign deadline_string = section.settings.countdown_date | append: 'T' | append: section.settings.countdown_time | append: ':00'
    assign deadline = deadline_string | date: '%s' | plus: 0
    assign now_ts = 'now' | date: '%s' | plus: 0
    assign remaining = deadline | minus: now_ts
    if remaining > 0
      assign show_countdown = true
      assign days = remaining | divided_by: 86400
      assign after_days = remaining | modulo: 86400
      assign hours = after_days | divided_by: 3600
      assign after_hours = after_days | modulo: 3600
      assign minutes = after_hours | divided_by: 60
      assign seconds = after_hours | modulo: 60
    endif
  endif

  assign align_class_desktop = 'campaign__inner--desktop-' | append: section.settings.desktop_text_alignment
  assign pos_class_desktop = 'campaign__inner--desktop-pos-' | append: section.settings.desktop_content_position
  assign align_class_mobile = 'campaign__inner--mobile-' | append: section.settings.mobile_text_alignment
  assign pos_class_mobile = 'campaign__inner--mobile-pos-' | append: section.settings.mobile_content_position
-%}

<div class="campaign scheme-dark" data-section-id="{{ section.id }}" style="--overlay-color: {{ section.settings.overlay_color }}; --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  
  <!-- Mídia -->
  <div class="campaign__media" data-parallax="0.12">
    {%- if section.settings.image != blank -%}
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.image_mobile | image_url: width: 750 }} 750w,
              {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w
            "
            sizes="100vw"
          >
          {{
            section.settings.image
            | image_url: width: 2600
            | image_tag:
              loading: 'lazy',
              class: 'campaign__image',
              widths: '900, 1200, 1600, 2000, 2600',
              sizes: '100vw',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        </picture>
      {%- else -%}
        {{
          section.settings.image
          | image_url: width: 2600
          | image_tag:
            loading: 'lazy',
            class: 'campaign__image',
            widths: '900, 1200, 1600, 2000, 2600',
            sizes: '100vw',
            alt: section.settings.image.alt | default: section.settings.heading | escape
        }}
      {%- endif -%}
    {%- else -%}
      <div class="campaign__image campaign__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}

    <div class="campaign__overlay"></div>
  </div>

  <!-- Conteúdo -->
  <div class="campaign__inner page-width {{ align_class_desktop }} {{ pos_class_desktop }} {{ align_class_mobile }} {{ pos_class_mobile }}">
    <div class="campaign__content" data-reveal>
      
      {%- if section.settings.eyebrow != blank -%}
        <p class="campaign__eyebrow animate-el" style="--item-index: 1;">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="campaign__heading animate-el" style="--item-index: 2;">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="campaign__text animate-el" style="--item-index: 3;">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="campaign__cta-wrapper animate-el" style="--item-index: 4;">
          <a href="{{ section.settings.button_link | default: '#' }}" class="button button--secondary campaign__cta">
            {{ section.settings.button_label | escape }}
            {% render 'icon', name: 'arrow-right' %}
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Countdown Opcional -->
    {%- if show_countdown -%}
      <div class="campaign__aside animate-el" style="--item-index: 5;" data-countdown data-deadline="{{ deadline }}">
        {%- if section.settings.countdown_label != blank -%}
          <p class="campaign__countdown-label">{{ section.settings.countdown_label | escape }}</p>
        {%- endif -%}
        
        <ul class="campaign__countdown" role="list">
          <li class="campaign__unit">
            <span class="campaign__number" data-countdown-days>{{ days | prepend: '0' | slice: -2, 2 }}</span>
            <span class="campaign__label">Dias</span>
          </li>
          <li class="campaign__separator">:</li>
          <li class="campaign__unit">
            <span class="campaign__number" data-countdown-hours>{{ hours | prepend: '0' | slice: -2, 2 }}</span>
            <span class="campaign__label">Horas</span>
          </li>
          <li class="campaign__separator">:</li>
          <li class="campaign__unit">
            <span class="campaign__number" data-countdown-minutes>{{ minutes | prepend: '0' | slice: -2, 2 }}</span>
            <span class="campaign__label">Min</span>
          </li>
          <li class="campaign__separator">:</li>
          <li class="campaign__unit">
            <span class="campaign__number" data-countdown-seconds>{{ seconds | prepend: '0' | slice: -2, 2 }}</span>
            <span class="campaign__label">Seg</span>
          </li>
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  /* ==========================================================
     ESTRUTURA BASE E MÍDIA
     ========================================================== */
  .campaign {
    position: relative;
    display: flex;
    overflow: hidden;
    background-color: var(--color-background, #0A0A0C);
    /* Alturas fixadas no layout */
    min-height: clamp(500px, 75vh, 800px);
  }

  .campaign__media { 
    position: absolute; 
    inset: 0; 
  }
  
  .campaign__image { 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
    display: block; 
    transition: transform 0.6s ease;
  }
  
  .campaign:hover .campaign__image {
    transform: scale(1.03);
  }

  .campaign__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface, #121212);
    height: 100%;
  }

  /* Overlay Configurável */
  .campaign__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--overlay-color, #000000);
    opacity: var(--overlay-opacity, 0.4);
    z-index: 1;
    pointer-events: none;
  }

  .campaign__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.3) 40%, transparent 80%);
    pointer-events: none;
    z-index: 2;
  }

  /* ==========================================================
     CONTEÚDO E ALINHAMENTOS
     ========================================================== */
  .campaign__inner {
    position: relative;
    z-index: 3;
    width: 100%;
    display: flex;
    padding-top: var(--space-section, 64px);
    padding-bottom: var(--space-section, 64px);
  }

  /* Organização Desktop */
  @media screen and (min-width: 750px) {
    /* Posição Vertical */
    .campaign__inner--desktop-pos-bottom { align-items: flex-end; }
    .campaign__inner--desktop-pos-middle { align-items: center; }
    .campaign__inner--desktop-pos-top { align-items: flex-start; }

    /* Alinhamento Horizontal e Disposição */
    .campaign__inner--desktop-left { 
      flex-direction: row; 
      justify-content: space-between; 
      text-align: left; 
    }
    .campaign__inner--desktop-center { 
      flex-direction: column; 
      justify-content: center; 
      text-align: center; 
      gap: 40px;
    }
    .campaign__inner--desktop-right { 
      flex-direction: row-reverse; 
      justify-content: space-between; 
      text-align: right; 
    }
  }

  /* Organização Mobile */
  @media screen and (max-width: 749px) {
    .campaign { min-height: 80vh; }
    .campaign__inner { gap: 40px; flex-direction: column; }
    
    /* Posição Vertical */
    .campaign__inner--mobile-pos-bottom { justify-content: flex-end; }
    .campaign__inner--mobile-pos-middle { justify-content: center; }
    .campaign__inner--mobile-pos-top { justify-content: flex-start; }

    /* Alinhamento Horizontal */
    .campaign__inner--mobile-left { align-items: flex-start; text-align: left; }
    .campaign__inner--mobile-center { align-items: center; text-align: center; }
    .campaign__inner--mobile-right { align-items: flex-end; text-align: right; }
  }

  /* ==========================================================
     TIPOGRAFIA E ESTILOS DE TEXTO (Com Sombra/Degradê)
     ========================================================== */
  .campaign__content { 
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 36rem; 
  }

  .campaign__eyebrow { 
    font-family: var(--font-heading-family, inherit);
    font-size: 0.875rem; 
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent, #C9A24D);
    margin: 0;
    /* Sombra para destaque */
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }

  .campaign__heading { 
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(2.5rem, 5vw, 4.5rem); 
    line-height: 1.05;
    font-weight: 700;
    margin: 0;
    color: #ffffff; 
    /* DUPLA SOMBRA: Uma fina para o contorno e uma gigante para simular o degradê escuro no fundo das letras */
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6), 0 12px 48px rgba(0, 0, 0, 0.7);
  }

  .campaign__text { 
    font-size: clamp(1rem, 1.2vw, 1.15rem); 
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9); 
    margin: 0;
    /* Sombra difusa sob o texto */
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7), 0 4px 24px rgba(0, 0, 0, 0.5);
  }

  .campaign__cta { 
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 32px;
    margin-top: 12px;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: transparent;
    color: #ffffff;
    border: 1px solid rgba(255,255,255,0.4);
    box-shadow: 0 4px 16px rgba(0,0,0,0.3); /* Sombra na caixa do botão */
    transition: all 0.3s ease;
  }

  .campaign__cta:hover {
    background-color: #ffffff;
    color: #000000;
    border-color: #ffffff;
  }

  .campaign__cta svg {
    transition: transform 0.3s ease;
  }
  .campaign__cta:hover svg {
    transform: translateX(4px);
  }

  /* ==========================================================
     COUNTDOWN (Cronômetro Estilo App)
     ========================================================== */
  .campaign__aside { 
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Ajusta alinhamento do título do countdown baseado no layout */
  .campaign__inner--desktop-left .campaign__aside { align-items: flex-end; text-align: right; }
  .campaign__inner--desktop-center .campaign__aside { align-items: center; text-align: center; }
  .campaign__inner--desktop-right .campaign__aside { align-items: flex-start; text-align: left; }
  
  .campaign__inner--mobile-left .campaign__aside { align-items: flex-start; text-align: left; }
  .campaign__inner--mobile-center .campaign__aside { align-items: center; text-align: center; }
  .campaign__inner--mobile-right .campaign__aside { align-items: flex-end; text-align: right; }

  .campaign__countdown-label { 
    font-family: var(--font-heading-family, inherit);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0; 
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }

  .campaign__countdown {
    display: flex;
    align-items: center;
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4); /* Sombra difusa atrás do vidro */
    padding: 16px 24px;
    border-radius: var(--radius-md, 12px);
  }

  .campaign__unit { 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
    gap: 4px; 
    min-width: 48px;
  }

  .campaign__number {
    font-family: var(--font-ui-family, inherit);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent, #C9A24D);
    line-height: 1;
  }

  .campaign__separator {
    font-size: 2rem;
    font-weight: 700;
    color: rgba(255,255,255,0.3);
    line-height: 1;
    margin-top: -16px;
  }

  .campaign__label {
    font-family: var(--font-ui-family, inherit);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  /* ==========================================================
     ANIMAÇÕES DE ENTRADA (Fade Up)
     ========================================================== */
  .animate-el {
    opacity: 0;
    transform: translateY(20px);
  }
  
  .js .campaign__content.is-revealed .animate-el,
  .js .campaign.is-revealed .animate-el {
    animation: fadeUp 0.6s cubic-bezier(0.21, 0.85, 0.32, 1) forwards;
    animation-delay: calc(var(--item-index, 1) * 80ms);
  }

  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-el { opacity: 1; transform: none; animation: none; }
    .campaign:hover .campaign__image { transform: none; }
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.campaign[data-section-id="{{ section.id }}"]');
    if (!section) return;

    // Dispara animação baseada no scroll (Intersection Observer)
    if (typeof window.CODRevelar === 'function') {
      window.CODRevelar(section);
    } else {
      section.classList.add('is-revealed'); // Fallback imediato
    }

    // Lógica do Cronômetro
    var root = section.querySelector('[data-countdown][data-deadline]');
    if (!root) return;

    var deadline = parseInt(root.getAttribute('data-deadline'), 10) * 1000;
    var fields = {
      days: root.querySelector('[data-countdown-days]'),
      hours: root.querySelector('[data-countdown-hours]'),
      minutes: root.querySelector('[data-countdown-minutes]'),
      seconds: root.querySelector('[data-countdown-seconds]')
    };

    function pad(n) { return (n < 10 ? '0' : '') + n; }

    function escrever(campo, valor) {
      if (!campo || campo.textContent === valor) return;
      campo.textContent = valor;
    }

    var acabou = false;

    function tick() {
      var remaining = Math.floor((deadline - Date.now()) / 1000);
      if (remaining <= 0) {
        acabou = true;
        parar();
        root.remove();
        return;
      }
      escrever(fields.days, pad(Math.floor(remaining / 86400)));
      escrever(fields.hours, pad(Math.floor((remaining % 86400) / 3600)));
      escrever(fields.minutes, pad(Math.floor((remaining % 3600) / 60)));
      escrever(fields.seconds, pad(remaining % 60));
    }

    var timer = null;
    var naTela = true;

    function parar() {
      if (timer === null) return;
      window.clearInterval(timer);
      timer = null;
    }

    function andar() {
      if (timer !== null || acabou) return;
      tick(); 
      if (!acabou) timer = window.setInterval(tick, 1000);
    }

    function sincronizar() {
      if (naTela && !document.hidden) andar();
      else parar();
    }

    document.addEventListener('visibilitychange', sincronizar);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        naTela = entries[0].isIntersecting;
        sincronizar();
      }, { rootMargin: '120px 0px' }).observe(root);
    } else {
      sincronizar();
    }
  })();
</script>

{% schema %}
{
  "name": "Campanha Promocional",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Mídia da Campanha"
    },
    { 
      "type": "image_picker", 
      "id": "image", 
      "label": "Imagem Desktop",
      "info": "Formato recomendado: paisagem (16:9)."
    },
    { 
      "type": "image_picker", 
      "id": "image_mobile", 
      "label": "Imagem Mobile (Opcional)", 
      "info": "Se vazia, será usada a imagem Desktop. Formato recomendado: retrato (4:5)." 
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Cor da Máscara",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Escurecimento (Overlay)",
      "default": 30,
      "info": "Aumente para garantir leitura em fundos muito claros."
    },
    {
      "type": "header",
      "content": "Conteúdo e Textos"
    },
    { "type": "text", "id": "eyebrow", "label": "Rótulo (Eyebrow)", "default": "PRÓXIMO DROP" },
    { "type": "text", "id": "heading", "label": "Título Principal", "default": "Coleção Inverno" },
    { "type": "text", "id": "text", "label": "Texto de Apoio", "default": "Prepare-se para o lançamento mais esperado." },
    { "type": "text", "id": "button_label", "label": "Texto do Botão", "default": "Ver Detalhes" },
    { "type": "url", "id": "button_link", "label": "Link do Botão" },
    {
      "type": "header",
      "content": "Layout Desktop"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "label": "Posição Vertical",
      "options": [
        { "value": "top", "label": "Em Cima" },
        { "value": "middle", "label": "No Meio" },
        { "value": "bottom", "label": "Embaixo" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "desktop_text_alignment",
      "label": "Alinhamento e Distribuição",
      "options": [
        { "value": "left", "label": "Esquerda (Texto esquerda, Tempo direita)" },
        { "value": "center", "label": "Centro (Tudo centralizado)" },
        { "value": "right", "label": "Direita (Texto direita, Tempo esquerda)" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout Mobile"
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "Posição Vertical",
      "options": [
        { "value": "top", "label": "Em Cima" },
        { "value": "middle", "label": "No Meio" },
        { "value": "bottom", "label": "Embaixo" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "Alinhamento do Texto",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Direita" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Cronómetro (Countdown)"
    },
    { 
      "type": "checkbox", 
      "id": "show_countdown", 
      "default": true, 
      "label": "Ativar Cronómetro", 
      "info": "A caixa inteira desaparecerá automaticamente quando a data expirar." 
    },
    { "type": "text", "id": "countdown_label", "label": "Título do Cronómetro", "default": "Tempo restante" },
    { 
      "type": "text", 
      "id": "countdown_date", 
      "label": "Data do Evento", 
      "info": "Formato obrigatório: AAAA-MM-DD. Ex: 2024-12-25",
      "default": "2024-12-31"
    },
    { "type": "text", "id": "countdown_time", "default": "23:59", "label": "Hora do Evento", "info": "Formato: HH:MM" }
  ],
  "presets": [{ "name": "Campanha (Countdown)" }]
}
{% endschema %}