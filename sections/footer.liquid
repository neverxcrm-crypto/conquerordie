{%- comment -%}
  ============================================================
  FOOTER — rodapé editorial & de alta conversão
  ============================================================
{%- endcomment -%}

{%- liquid
  assign show_payment_icons = section.settings.show_payment_icons
  assign show_social = section.settings.show_social
  assign show_back_to_top = section.settings.show_back_to_top
-%}

<footer 
  class="footer section-{{ section.id }}-padding" 
  data-section-id="{{ section.id }}"
>
  <div class="footer__top page-width">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'brand' -%}
          <div class="footer__block footer__block--brand" {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank -%}
              {{
                block.settings.logo
                | image_url: width: 400
                | image_tag:
                  class: 'footer__logo',
                  widths: '150, 300, 400',
                  width: block.settings.logo_width | default: 160,
                  height: 160 | divided_by: block.settings.logo.aspect_ratio,
                  alt: shop.name | escape
              }}
            {%- else -%}
              <p class="footer__brand-name">{{ shop.name }}</p>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="footer__text footer__statement rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>

        {%- when 'menu' -%}
          <details class="footer__block footer__block--menu footer__accordion" open {{ block.shopify_attributes }}>
            <summary class="footer__accordion-toggle">
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              <span class="footer__accordion-icon" aria-hidden="true">{% render 'icon', name: 'chevron' %}</span>
            </summary>
            {%- if block.settings.menu != blank -%}
              <ul class="footer__menu" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}" class="footer__link">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </details>

        {%- when 'contact' -%}
          <details class="footer__block footer__block--contact footer__accordion" open {{ block.shopify_attributes }}>
            <summary class="footer__accordion-toggle">
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              <span class="footer__accordion-icon" aria-hidden="true">{% render 'icon', name: 'chevron' %}</span>
            </summary>
            <div class="footer__contact-info">
              {%- if block.settings.whatsapp != blank -%}
                <p class="footer__contact-item">
                  <span class="footer__contact-label">WhatsApp:</span>
                  <a href="https://wa.me/{{ block.settings.whatsapp | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}" target="_blank" rel="noopener" class="footer__link">{{ block.settings.whatsapp }}</a>
                </p>
              {%- endif -%}
              {%- if block.settings.email != blank -%}
                <p class="footer__contact-item">
                  <span class="footer__contact-label">E-mail:</span>
                  <a href="mailto:{{ block.settings.email }}" class="footer__link">{{ block.settings.email }}</a>
                </p>
              {%- endif -%}
              {%- if block.settings.hours != blank -%}
                <p class="footer__contact-item footer__contact-hours">{{ block.settings.hours | escape }}</p>
              {%- endif -%}
            </div>
          </details>

        {%- when 'text' -%}
          <details class="footer__block footer__block--text footer__accordion" open {{ block.shopify_attributes }}>
            <summary class="footer__accordion-toggle">
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              <span class="footer__accordion-icon" aria-hidden="true">{% render 'icon', name: 'chevron' %}</span>
            </summary>
            {%- if block.settings.text != blank -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </details>

        {%- when 'newsletter' -%}
          <div class="footer__block footer__block--newsletter" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.subtext != blank -%}
              <div class="footer__text footer__newsletter-subtext rte">{{ block.settings.subtext }}</div>
            {%- endif -%}
            {% render 'newsletter-form', block: block %}
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer__bottom page-width">
    <!-- Linha Superior do Bottom: Pagamentos, Redes e Voltar ao Topo -->
    <div class="footer__bottom-primary">
      <div class="footer__bottom-left">
        {%- if show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <ul class="footer__payment" role="list" aria-label="{{ 'sections.footer.payment' | t | default: 'Formas de pagamento' }}">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="footer__bottom-right">
        {%- if show_social -%}
          <ul class="footer__social" role="list" aria-label="Redes Sociais">
            {%- if settings.social_instagram_link != blank -%}
              <li><a href="{{ settings.social_instagram_link }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a></li>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <li><a href="{{ settings.social_facebook_link }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'icon', name: 'facebook' %}</a></li>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <li><a href="{{ settings.social_tiktok_link }}" aria-label="TikTok" rel="noopener" target="_blank">{% render 'icon', name: 'tiktok' %}</a></li>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <li><a href="{{ settings.social_youtube_link }}" aria-label="YouTube" rel="noopener" target="_blank">{% render 'icon', name: 'youtube' %}</a></li>
            {%- endif -%}
            {%- if settings.social_x_link != blank -%}
              <li><a href="{{ settings.social_x_link }}" aria-label="X" rel="noopener" target="_blank">{% render 'icon', name: 'x' %}</a></li>
            {%- endif -%}
            {%- if settings.social_linkedin_link != blank -%}
              <li><a href="{{ settings.social_linkedin_link }}" aria-label="LinkedIn" rel="noopener" target="_blank">{% render 'icon', name: 'linkedin' %}</a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if show_back_to_top -%}
          <button type="button" class="footer__back-to-top" data-back-to-top aria-label="Voltar ao topo">
            <span>VOLTAR AO TOPO</span>
            <span class="footer__back-to-top-icon" aria-hidden="true">↑</span>
          </button>
        {%- endif -%}
      </div>
    </div>

    <!-- Linha Secundária do Bottom: Políticas, CNPJ e Copyright -->
    <div class="footer__bottom-secondary">
      <div class="footer__legal-container">
        {%- assign has_policy = false -%}
        {%- if shop.policies.privacy_policy.url != blank
          or shop.policies.terms_of_service.url != blank
          or shop.policies.refund_policy.url != blank
          or shop.policies.shipping_policy.url != blank
        -%}
          {%- assign has_policy = true -%}
        {%- endif -%}

        {%- if has_policy -%}
          <ul class="footer__legal" role="list">
            {%- if shop.policies.terms_of_service.url != blank -%}
              <li><a href="{{ shop.policies.terms_of_service.url }}">{{ shop.policies.terms_of_service.title }}</a></li>
            {%- endif -%}
            {%- if shop.policies.privacy_policy.url != blank -%}
              <li><a href="{{ shop.policies.privacy_policy.url }}">{{ shop.policies.privacy_policy.title }}</a></li>
            {%- endif -%}
            {%- if shop.policies.refund_policy.url != blank -%}
              <li><a href="{{ shop.policies.refund_policy.url }}">{{ shop.policies.refund_policy.title }}</a></li>
            {%- endif -%}
            {%- if shop.policies.shipping_policy.url != blank -%}
              <li><a href="{{ shop.policies.shipping_policy.url }}">{{ shop.policies.shipping_policy.title }}</a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        <!-- Informações Empresariais (CNPJ / Endereço) -->
        {%- if section.settings.company_info != blank -%}
          <div class="footer__company-info">
            {{ section.settings.company_info }}
          </div>
        {%- endif -%}
      </div>

      <div class="footer__copyright-container">
        <p class="footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'sections.footer.rights' | t | default: 'Todos os direitos reservados.' }}
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .footer {
    background-color: var(--color-background, #000000);
    color: var(--color-text-primary, #ffffff);
    margin-top: 0;
    border-top: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(220px, 1.3fr) repeat(auto-fit, minmax(160px, 1fr));
    gap: clamp(32px, 4vw, 56px);
    padding-top: 12px;
    padding-bottom: 48px;
  }

  /* Marca / manifesto */
  .footer__logo { display: block; height: auto; margin-bottom: 20px; }
  .footer__brand-name {
    font-size: var(--f4, 20px);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }
  .footer__statement {
    color: var(--color-text-secondary, #a1a1a1);
    max-width: 40ch;
    font-size: var(--f1, 13px);
    line-height: 1.6;
  }

  /* Headings & Accordions */
  .footer__heading {
    font-size: var(--f1, 12px);
    font-weight: var(--font-weight-semibold, 600);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label, 0.1em);
    margin: 0;
    color: var(--color-text-primary, #ffffff);
  }

  .footer__accordion-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    list-style: none;
    cursor: default;
    margin-bottom: 16px;
  }
  .footer__accordion-toggle::-webkit-details-marker,
  .footer__accordion-toggle::marker { display: none; content: ''; }
  .footer__accordion-icon { display: none; color: var(--color-text-muted, #777777); transition: transform 200ms ease; }

  .footer__menu { list-style: none; margin: 0; padding: 0; }
  .footer__link {
    display: inline-block;
    padding: 5px 0;
    color: var(--color-text-secondary, #a1a1a1);
    text-decoration: none;
    font-size: var(--f1, 13px);
    transition: color 200ms ease, transform 200ms ease;
  }
  .footer__link:hover { color: var(--color-text-primary, #ffffff); transform: translateX(2px); }
  
  .footer__text { font-size: var(--f1, 13px); line-height: 1.6; color: var(--color-text-secondary, #a1a1a1); }
  .footer__newsletter-subtext { margin-bottom: 16px; }

  /* Bloco de Contato */
  .footer__contact-info { display: flex; flex-direction: column; gap: 8px; }
  .footer__contact-item { margin: 0; font-size: var(--f1, 13px); color: var(--color-text-secondary, #a1a1a1); }
  .footer__contact-label { font-weight: 600; color: var(--color-text-primary, #ffffff); margin-right: 4px; }
  .footer__contact-hours { font-size: 12px; opacity: 0.8; margin-top: 4px; }

  /* Newsletter Estilizada */
  .footer__block--newsletter { align-self: start; }
  .footer__block--newsletter .newsletter-form__field .field__input {
    background-color: transparent;
    border-width: 0 0 1px 0;
    border-color: var(--color-border-strong, rgba(255, 255, 255, 0.3));
    border-radius: 0;
    padding-left: 0;
    color: var(--color-text-primary, #ffffff);
  }
  .footer__block--newsletter .newsletter-form__button {
    background-color: transparent;
    color: var(--color-text-primary, #ffffff);
    border-color: var(--color-border-strong, rgba(255, 255, 255, 0.3));
    transition: all 200ms ease;
  }
  .footer__block--newsletter .newsletter-form__button:hover {
    background-color: var(--color-text-primary, #ffffff);
    color: var(--color-background, #000000);
  }

  /* Rodapé Inferior */
  .footer__bottom {
    padding-top: 24px;
    padding-bottom: 32px;
    border-top: 1px solid var(--color-border-accent, rgba(201, 162, 77, 0.35));
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .footer__bottom-primary,
  .footer__bottom-secondary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer__bottom-left,
  .footer__bottom-right { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  
  .footer__payment { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  .footer__payment-icon { width: 38px; height: 24px; }

  .footer__social { display: flex; gap: 16px; list-style: none; margin: 0; padding: 0; }
  .footer__social a {
    color: var(--color-text-secondary, #a1a1a1);
    display: inline-flex;
    transition: color 200ms ease, transform 200ms ease;
  }
  .footer__social a:hover { color: var(--color-text-primary, #ffffff); transform: translateY(-2px); }
  .footer__social svg { width: 18px; height: 18px; }

  /* Voltar ao Topo */
  .footer__back-to-top {
    background: none;
    border: none;
    color: var(--color-text-secondary, #a1a1a1);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    transition: color 200ms ease;
  }
  .footer__back-to-top:hover { color: var(--color-text-primary, #ffffff); }
  .footer__back-to-top-icon { font-size: 14px; line-height: 1; }

  /* Políticas e CNPJ */
  .footer__legal-container { display: flex; flex-direction: column; gap: 8px; }
  .footer__legal { display: flex; gap: 16px; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  .footer__legal a {
    font-size: var(--f0, 11px);
    color: var(--color-text-muted, #777777);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .footer__legal a:hover { color: var(--color-text-primary, #ffffff); text-decoration: underline; }

  .footer__company-info {
    font-size: var(--f0, 11px);
    color: var(--color-text-muted, #777777);
    line-height: 1.5;
  }

  .footer__copyright { font-size: var(--f0, 11px); color: var(--color-text-muted, #777777); margin: 0; }
  .footer__credit a { color: inherit; text-decoration: underline; }
  .footer__credit a:hover { color: var(--color-accent-readable, #C9A24D); }

  /* Ajustes Mobile */
  @media screen and (max-width: 1000px) {
    .footer__top { grid-template-columns: 1fr; gap: 0; padding-top: 20px; }
    .footer__block { padding: 18px 0; border-top: 1px solid var(--color-border, rgba(255, 255, 255, 0.1)); }
    .footer__block--brand { border-top: none; padding-top: 0; }
    .footer__accordion-toggle { cursor: pointer; margin-bottom: 0; }
    .footer__accordion[open] .footer__accordion-toggle { margin-bottom: 16px; }
    .footer__accordion-icon { display: inline-flex; }
    .footer__accordion[open] .footer__accordion-icon { transform: rotate(180deg); }
    
    .footer__bottom-primary,
    .footer__bottom-secondary {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  /* A partir de 1001px, os accordions ficam permanentemente abertos */
  @media screen and (min-width: 1001px) {
    .footer__accordion > *:not(summary) { display: block !important; }
  }
</style>

<script>
  /* Script para funcionamento do botão Voltar ao Topo */
  document.addEventListener('DOMContentLoaded', function () {
    var backToTopBtn = document.querySelector('[data-back-to-top]');
    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', function () {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Rodapé (Footer)",
  "settings": [
    {
      "type": "header",
      "content": "Informações da Empresa (CNPJ & Legal)"
    },
    {
      "type": "inline_richtext",
      "id": "company_info",
      "label": "Razão Social, CNPJ e Endereço",
      "default": "Sua Empresa LTDA | CNPJ: 00.000.000/0001-00 | Rua Exemplo, 123 - São Paulo/SP",
      "info": "Exibido na parte inferior para conformidade legal."
    },
    {
      "type": "header",
      "content": "Opções do Rodapé"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "Exibir redes sociais (Configuradas nas Definições do Tema)"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "default": true,
      "label": "Exibir ícones de pagamento"
    },
    {
      "type": "checkbox",
      "id": "show_back_to_top",
      "default": true,
      "label": "Exibir botão 'Voltar ao topo'"
    },
    {
      "type": "header",
      "content": "Espaçamento da Seção"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento Superior",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento Inferior",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca e Manifesto",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logotipo do Rodapé"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 80,
          "max": 240,
          "step": 10,
          "unit": "px",
          "label": "Largura da Logo",
          "default": 160
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto do Manifesto / Sobre a Marca",
          "default": "<p>Criamos produtos atemporais com materiais nobres e atenção aos mínimos detalhes.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu de Navegação",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Links úteis",
          "label": "Título da Coluna"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu Selecionado"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Atendimento & Contato",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Atendimento",
          "label": "Título da Coluna"
        },
        {
          "type": "text",
          "id": "whatsapp",
          "label": "Número do WhatsApp",
          "default": "(11) 99999-9999"
        },
        {
          "type": "text",
          "id": "email",
          "label": "E-mail de Suporte",
          "default": "suporte@sualoja.com.br"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Horário de Atendimento",
          "default": "Seg. à Sex. das 09h às 18h"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texto Livre",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Conteúdo de Texto"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Assine nossa newsletter",
          "label": "Título"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Subtítulo / Descrição",
          "default": "<p>Receba novidades exclusivas e 10% OFF no seu primeiro pedido.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rodapé (Footer)",
      "blocks": [
        { "type": "brand" },
        { "type": "menu" },
        { "type": "contact" },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}