{%- comment -%}
  ============================================================
  MARQUEE / CARROSSEL CONTINUO DE AVISOS (TICKER)
  ============================================================
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <div 
    class="ticker" 
    data-section-id="{{ section.id }}"
    style="
      --ticker-bg: {{ section.settings.bg_color }};
      --ticker-color: {{ section.settings.text_color }};
      --ticker-speed: {{ section.settings.speed }}s;
    "
  >
    <div class="ticker__wrapper {% if section.settings.pause_on_hover %}ticker__wrapper--pause{% endif %}">
      {%- comment -%} Repetimos o grupo 4 vezes para garantir preenchimento em qualquer resolução sem lacunas {%- endcomment -%}
      {%- for i in (1..4) -%}
        <div class="ticker__track" {% if i > 1 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <div class="ticker__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="ticker__link">
                  <span>{{ block.settings.text | escape }}</span>
                </a>
              {%- else -%}
                <span>{{ block.settings.text | escape }}</span>
              {%- endif -%}

              {%- if section.settings.show_separator -%}
                <span class="ticker__separator" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="6" cy="6" r="4" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <style>
    .ticker {
      background-color: var(--ticker-bg, #000000);
      color: var(--ticker-color, #ffffff);
      overflow: hidden;
      padding: 10px 0;
      white-space: nowrap;
      position: relative;
      z-index: 101;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      user-select: none;
    }

    .ticker__wrapper {
      display: flex;
      width: max-content;
      will-change: transform;
    }

    .ticker__wrapper--pause:hover .ticker__track {
      animation-play-state: paused;
    }

    .ticker__track {
      display: flex;
      align-items: center;
      flex-shrink: 0;
      animation: tickerMarquee var(--ticker-speed, 20s) linear infinite;
    }

    .ticker__item {
      display: inline-flex;
      align-items: center;
      gap: 24px;
      padding: 0 12px;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .ticker__link {
      color: inherit;
      text-decoration: none;
      transition: opacity 200ms ease;
    }

    .ticker__link:hover {
      opacity: 0.8;
    }

    .ticker__separator {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0.6;
    }

    @keyframes tickerMarquee {
      0% {
        transform: translateX(0%);
      }
      100% {
        transform: translateX(-100%);
      }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Barra Contínua (Ticker)",
  "class": "section-ticker",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor do Fundo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do Texto",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Velocidade da Animação",
      "info": "Menos segundos = mais rápido. Mais segundos = mais lento.",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Exibir Ícone Separador",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pausar ao passar o mouse",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Aviso",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "FRETE GRÁTIS ACIMA DE R$585!"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra Contínua (Ticker)",
      "blocks": [
        { "type": "announcement", "settings": { "text": "FRETE GRÁTIS ACIMA DE R$585!" } },
        { "type": "announcement", "settings": { "text": "EM ATÉ 10X SEM JUROS" } },
        { "type": "announcement", "settings": { "text": "CUPOM PRIMEIRA COMPRA: WELCOME10" } }
      ]
    }
  ]
}
{% endschema %}