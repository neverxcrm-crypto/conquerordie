{%- comment -%}
  ============================================================
  ANNOUNCEMENT BAR / MARQUEE — Carrossel Contínuo Infinito
  ============================================================
{%- endcomment -%}

{%- assign avisos = section.blocks -%}
{%- assign total = avisos.size -%}

{%- if total > 0 -%}
  <section
    class="aviso-marquee{% if section.settings.enable_gold_effect %} aviso--ouro{% endif %}"
    data-section-id="{{ section.id }}"
    aria-label="{{ 'sections.announcement.label' | t }}"
    style="
      --aviso-bg: {{ section.settings.bg_color }};
      --aviso-cor: {{ section.settings.text_color }};
      --aviso-fonte: {{ section.settings.font_size }}px;
      --aviso-peso: {{ section.settings.font_weight }};
      --aviso-caixa: {{ section.settings.text_transform }};
      --aviso-tracking: {{ section.settings.letter_spacing }}px;
      --aviso-italico: {% if section.settings.enable_italic %}italic{% else %}normal{% endif %};
      --aviso-duracao: {{ section.settings.speed | default: 25 }}s;
    "
  >
    <div class="aviso-marquee__container">
      <div class="aviso-marquee__track">
        {%- comment -%}
          Duplicamos o grupo (1..4) para garantir largura suficiente em telas ultrawide
          e criar o ciclo infinito continuo (-50% transform).
        {%- endcomment -%}
        {%- for i in (1..4) -%}
          <div class="aviso-marquee__group" {% if i > 1 %}aria-hidden="true"{% endif %}>
            {%- for block in avisos -%}
              <div class="aviso-marquee__item" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="aviso-marquee__texto aviso-marquee__texto--link" {% if i > 1 %}tabindex="-1"{% endif %}>
                    <span>{{ block.settings.text | escape }}</span>
                    <svg class="aviso-marquee__seta" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false">
                      <path d="M3 9l6-6M4 3h5v5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                {%- else -%}
                  <span class="aviso-marquee__texto">{{ block.settings.text | escape }}</span>
                {%- endif -%}

                <span class="aviso-marquee__separador" aria-hidden="true">•</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <style>
    .aviso-marquee {
      position: relative;
      z-index: 10;
      background-color: var(--aviso-bg, #000000);
      border-block: 1px solid rgba(201, 162, 77, 0.28);
      user-select: none;
      overflow: hidden;
      padding-block: 10px;
      width: 100%;
    }

    .aviso-marquee__container {
      display: flex;
      overflow: hidden;
      width: 100%;
    }

    .aviso-marquee__track {
      display: inline-flex;
      width: fit-content;
      width: max-content;
      min-width: max-content;
      white-space: nowrap;
      will-change: transform;
      animation: aviso-marquee-loop var(--aviso-duracao, 25s) linear infinite;
      animation-play-state: running;
    }

    .aviso-marquee__group {
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }

    .aviso-marquee__item {
      display: inline-flex;
      align-items: center;
    }

    .aviso-marquee__texto {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-ui-family, inherit);
      font-size: var(--aviso-fonte, 12px);
      font-style: var(--aviso-italico, normal);
      font-weight: var(--aviso-peso, 600);
      text-transform: var(--aviso-caixa, uppercase);
      letter-spacing: var(--aviso-tracking, 1.2px);
      color: var(--aviso-cor, #ffffff);
      text-decoration: none;
      line-height: 1;
    }

    .aviso-marquee__separador {
      display: inline-block;
      margin-inline: 24px;
      color: var(--cod-gold, #C9A24D);
      opacity: 0.5;
      font-size: 10px;
    }

    /* Efeito Ouro Metálico */
    .aviso--ouro .aviso-marquee__texto {
      background: linear-gradient(100deg, #FBF0B9 0%, #E3C98B 28%, #C9A24D 55%, #E9D49A 82%, #FBF0B9 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }

    .aviso--ouro .aviso-marquee__seta {
      color: var(--cod-gold, #C9A24D);
      -webkit-text-fill-color: currentColor;
    }

    .aviso-marquee__seta {
      width: 10px;
      height: 10px;
      flex: none;
      transition: transform var(--dur-normal, 0.2s) var(--ease-out, ease);
    }

    .aviso-marquee__texto--link:hover .aviso-marquee__seta {
      transform: translate(2px, -2px);
    }

    @keyframes aviso-marquee-loop {
      0% {
        transform: translate3d(0, 0, 0);
      }
      100% {
        transform: translate3d(-50%, 0, 0);
      }
    }

    /* Mobile */
    @media screen and (max-width: 749px) {
      .aviso-marquee {
        padding-block: 8px;
      }
      .aviso-marquee__texto {
        font-size: max(10px, calc(var(--aviso-fonte, 12px) - 1px));
      }
      .aviso-marquee__separador {
        margin-inline: 16px;
      }
    }

    /* Acessibilidade (Movimento Reduzido) */
    @media (prefers-reduced-motion: reduce) {
      .aviso-marquee__container {
        overflow-x: auto;
      }
      .aviso-marquee__track {
        animation: none;
      }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Marquee de avisos",
  "class": "section-aviso-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Animação"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Tempo de rotação",
      "info": "Menos segundos = rolagem mais rápida. A rolagem pausa ao passar o mouse.",
      "default": 25
    },
    {
      "type": "header",
      "content": "Tipografia"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Tamanho da fonte",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "enable_italic",
      "label": "Texto em itálico",
      "default": false
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Espessura da fonte",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Médio (500)" },
        { "value": "600", "label": "Semi-negrito (600)" },
        { "value": "700", "label": "Negrito (700)" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Caixa do texto",
      "options": [
        { "value": "uppercase", "label": "MAIÚSCULAS" },
        { "value": "capitalize", "label": "Primeiras Letras Maiúsculas" },
        { "value": "none", "label": "Normal (conforme digitado)" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 4,
      "step": 0.1,
      "unit": "px",
      "label": "Espaçamento entre letras",
      "default": 1.2
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "checkbox",
      "id": "enable_gold_effect",
      "label": "Texto em ouro metálico",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto (quando o ouro estiver desativado)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor do fundo da barra",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Aviso",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "FRETE GRÁTIS ACIMA DE R$ 585"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee de avisos",
      "blocks": [
        { "type": "announcement", "settings": { "text": "FRETE GRÁTIS ACIMA DE R$ 585" } },
        { "type": "announcement", "settings": { "text": "10% OFF NA PRIMEIRA COMPRA" } },
        { "type": "announcement", "settings": { "text": "ENVIO RÁPIDO PARA TODO O BRASIL" } },
        { "type": "announcement", "settings": { "text": "PARCELE EM ATÉ 10X SEM JUROS" } }
      ]
    }
  ]
}
{% endschema %}
