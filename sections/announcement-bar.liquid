{%- comment -%}
  ============================================================
  MARQUEE / TICKER CONTINUO — EDIÇÃO OURO PREMIUM (CUSTOMIZÁVEL)
  ============================================================
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <div 
    class="ticker ticker--gold-edition" 
    data-section-id="{{ section.id }}"
    style="
      --ticker-bg: {{ section.settings.bg_color }};
      --ticker-speed: {{ section.settings.speed }}s;
      --ticker-font-size: {{ section.settings.font_size }}px;
      --ticker-font-style: {% if section.settings.enable_italic %}italic{% else %}normal{% endif %};
      --ticker-font-weight: {{ section.settings.font_weight }};
      --ticker-text-transform: {{ section.settings.text_transform }};
      --ticker-letter-spacing: {{ section.settings.letter_spacing }}px;
      --ticker-custom-color: {{ section.settings.text_color }};
    "
  >
    <div class="ticker__wrapper {% if section.settings.pause_on_hover %}ticker__wrapper--pause{% endif %}">
      {%- for i in (1..4) -%}
        <div class="ticker__track" {% if i > 1 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <div class="ticker__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="ticker__link">
                  <span class="{% if section.settings.enable_gold_effect %}ticker__text-gold{% else %}ticker__text-custom{% endif %}">
                    {{ block.settings.text | escape }}
                  </span>
                </a>
              {%- else -%}
                <span class="{% if section.settings.enable_gold_effect %}ticker__text-gold{% else %}ticker__text-custom{% endif %}">
                  {{ block.settings.text | escape }}
                </span>
              {%- endif -%}

              {%- if section.settings.show_separator -%}
                <span class="ticker__separator" aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="5" cy="5" r="3.5" stroke="url(#gold-gradient-{{ section.id }})" stroke-width="1.5"/>
                    <defs>
                      <linearGradient id="gold-gradient-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#FFE57F" />
                        <stop offset="50%" stop-color="#D4AF37" />
                        <stop offset="100%" stop-color="#AA771C" />
                      </linearGradient>
                    </defs>
                  </svg>
                </span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <style>
    /* Estilo Geral da Barra */
    .ticker--gold-edition {
      background-color: var(--ticker-bg, #08080a);
      overflow: hidden;
      padding: 12px 0;
      white-space: nowrap;
      position: relative;
      z-index: 101;
      border-top: 1px solid rgba(212, 175, 55, 0.25);
      border-bottom: 1px solid rgba(212, 175, 55, 0.35);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
      user-select: none;
    }

    .ticker__wrapper {
      display: flex;
      width: max-content;
      will-change: transform;
    }

    .ticker__wrapper--pause:hover .ticker__track {
      animation-play-state: paused;
    }

    .ticker__track {
      display: flex;
      align-items: center;
      flex-shrink: 0;
      animation: tickerMarquee var(--ticker-speed, 45s) linear infinite;
    }

    .ticker__item {
      display: inline-flex;
      align-items: center;
      gap: 24px;
      padding: 0 16px;
      font-size: var(--ticker-font-size, 13px);
      font-style: var(--ticker-font-style, normal);
      font-weight: var(--ticker-font-weight, 700);
      text-transform: var(--ticker-text-transform, uppercase);
      letter-spacing: var(--ticker-letter-spacing, 1.5px);
    }

    /* Efeito Ouro Metálico Reluzente */
    .ticker__text-gold {
      background: linear-gradient(
        110deg,
        #FBF0B9 0%,
        #DFBA63 20%,
        #FFF5C0 40%,
        #B8860B 60%,
        #E6C675 80%,
        #FBF0B9 100%
      );
      background-size: 200% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: goldShimmer 8s linear infinite;
      filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6));
    }

    .ticker__text-custom {
      color: var(--ticker-custom-color, #ffffff);
    }

    .ticker__link {
      text-decoration: none;
      transition: opacity 200ms ease, filter 200ms ease;
    }

    .ticker__link:hover {
      opacity: 0.85;
      filter: drop-shadow(0 0 6px rgba(212, 175, 55, 0.6));
    }

    .ticker__separator {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      filter: drop-shadow(0 0 4px rgba(212, 175, 55, 0.5));
    }

    @keyframes tickerMarquee {
      0% {
        transform: translateX(0%);
      }
      100% {
        transform: translateX(-100%);
      }
    }

    @keyframes goldShimmer {
      0% {
        background-position: 0% center;
      }
      100% {
        background-position: 200% center;
      }
    }

    /* ==========================================================
       PERFORMANCE NO TOQUE — brilho parado
       ==========================================================
       goldShimmer anima background-position. Diferente de transform
       e opacity, background-position NAO pode ser animado na GPU: o
       navegador redesenha o texto a cada frame — e aqui cada
       redesenho passa por background-clip: text mais um drop-shadow,
       em todos os itens da barra ao mesmo tempo, para sempre.

       A barra fica no topo, entao na maior parte da navegacao esse
       custo e pago por um efeito que nem esta na tela.

       No celular o degrade de ouro continua identico — so para de
       deslizar. A marquise (tickerMarquee) fica: ela anima transform,
       que a GPU resolve sem repintar nada.
       ========================================================== */
    @media (max-width: 1000px), (pointer: coarse) {
      .ticker__text-gold {
        animation: none;
        background-size: 100% auto;
        background-position: 0 center;
      }
      /* O drop-shadow fica: com o brilho parado a barra e pintada
         uma vez so, entao a sombra nao custa mais nada por frame. */
    }

    @media (prefers-reduced-motion: reduce) {
      .ticker__track,
      .ticker__text-gold { animation: none; }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Barra Contínua (Ouro)",
  "class": "section-ticker",
  "settings": [
    {
      "type": "header",
      "content": "⚡ Animação & Velocidade"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 180,
      "step": 5,
      "unit": "s",
      "label": "Tempo da Volta Completa",
      "info": "Aumente o valor para deixar o movimento MAIS LENTO (Exemplo: 50s a 90s para deslizamento lento).",
      "default": 45
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pausar ao passar o mouse",
      "default": true
    },
    {
      "type": "header",
      "content": "✒️ Tipografia & Estilo de Texto"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamanho da Fonte",
      "default": 13
    },
    {
      "type": "checkbox",
      "id": "enable_italic",
      "label": "Texto em Itálico",
      "default": false
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Espessura da Fonte",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Médio (500)" },
        { "value": "600", "label": "Semi-Negrito (600)" },
        { "value": "700", "label": "Negrito (700)" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Caixa do Texto",
      "options": [
        { "value": "uppercase", "label": "MAIÚSCULAS" },
        { "value": "capitalize", "label": "Primeiras Letras Maiúsculas" },
        { "value": "none", "label": "Normal (Conforme Digitado)" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "label": "Espaçamento Entre Letras",
      "default": 1.5
    },
    {
      "type": "header",
      "content": "🎨 Cores & Efeitos Metálicos"
    },
    {
      "type": "checkbox",
      "id": "enable_gold_effect",
      "label": "Ativar Efeito Ouro Metálico Animado",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do Texto (quando Ouro estiver desativado)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor do Fundo da Barra",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Exibir Separador Dourado",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Aviso",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "FRETE GRÁTIS EM COMPRAS ACIMA DE R$585"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra Contínua (Ouro)",
      "blocks": [
        { "type": "announcement", "settings": { "text": "FRETE GRÁTIS EM COMPRAS ACIMA DE R$585" } },
        { "type": "announcement", "settings": { "text": "PARCELE EM ATÉ 10X SEM JUROS" } },
        { "type": "announcement", "settings": { "text": "QUALIDADE & ELEGÂNCIA EXCLUSIVA" } }
      ]
    }
  ]
}
{% endschema %}