{%- comment -%}
  ============================================================
  BRAND STORY — manifesto da marca + pontos de confiança
  ============================================================
{%- endcomment -%}

{%- liquid
  assign benefits = section.blocks | where: 'type', 'benefit'
-%}

<div
  class="brand-story brand-story--media-{{ section.settings.image_position }} brand-story--image-{{ section.settings.image_height }}"
  data-section-id="{{ section.id }}"
>
  <div class="brand-story__media" data-parallax="0.1">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          loading: 'lazy',
          class: 'brand-story__image',
          widths: '600, 900, 1200, 1600',
          sizes: '(min-width: 1000px) 45vw, 100vw',
          alt: section.settings.image.alt | default: section.settings.heading | escape
      }}
    {%- else -%}
      <div class="brand-story__image brand-story__placeholder">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <div class="brand-story__panel">
    <div class="brand-story__grid {% if benefits.size == 0 %}brand-story__grid--single{% endif %}">
      <div class="brand-story__content" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="brand-story__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="brand-story__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="button brand-story__cta">
            {{ section.settings.button_label | escape }}
            {% render 'icon', name: 'arrow-right' %}
          </a>
        {%- endif -%}
      </div>

      {%- if benefits.size > 0 -%}
        <ul class="brand-story__benefits" role="list" data-reveal>
          {%- for block in benefits -%}
            <li class="brand-story__benefit" {{ block.shopify_attributes }}>
              <span class="brand-story__benefit-icon">{% render 'icon', name: block.settings.icon %}</span>
              <span class="brand-story__benefit-copy">
                <span class="brand-story__benefit-title">{{ block.settings.title | escape }}</span>
                {%- if block.settings.text != blank -%}
                  <span class="brand-story__benefit-text">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .brand-story {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: stretch;
    background-color: var(--color-background);
  }
  .brand-story--media-right { grid-template-columns: 1.2fr 0.8fr; }
  .brand-story--media-right .brand-story__media { order: 2; }

  .brand-story__media {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  /* Opções de tamanho/proporção da imagem */
  .brand-story--image-full .brand-story__media {
    min-height: 420px;
    height: 100%;
  }
  .brand-story--image-full .brand-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .brand-story--image-adapt .brand-story__media {
    min-height: auto;
    height: auto;
  }
  .brand-story--image-adapt .brand-story__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .brand-story--image-portrait .brand-story__media {
    aspect-ratio: 4 / 5;
    min-height: auto;
  }
  .brand-story--image-portrait .brand-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .brand-story--image-square .brand-story__media {
    aspect-ratio: 1 / 1;
    min-height: auto;
  }
  .brand-story--image-square .brand-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .brand-story__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface);
    height: 100%;
    min-height: 400px;
  }

  .brand-story__panel {
    display: flex;
    align-items: center;
    padding: var(--space-section) var(--page-gutter);
  }
  .brand-story__grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
    width: 100%;
    max-width: 920px;
  }
  .brand-story__grid--single { grid-template-columns: 1fr; }

  .brand-story__content .eyebrow { margin-bottom: 20px; }
  .brand-story__heading { font-size: var(--f7); margin-bottom: 20px; }
  .brand-story__text {
    font-size: var(--f2);
    color: var(--color-text-secondary);
    margin-bottom: 32px;
  }
  .brand-story__text p { margin: 0 0 12px; }
  .brand-story__cta { min-width: 180px; }

  /* Benefícios */
  .brand-story__benefits {
    list-style: none;
    margin: 0;
    padding: 0 0 0 clamp(24px, 3vw, 40px);
    border-left: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-md);
    min-width: 230px;
  }
  .brand-story__benefit { display: flex; align-items: flex-start; gap: var(--space-xs); }
  .brand-story__benefit-icon { color: var(--color-text-muted); flex-shrink: 0; line-height: 0; }
  .brand-story__benefit-icon svg { width: 20px; height: 20px; }
  .brand-story__benefit-copy { display: flex; flex-direction: column; gap: 2px; }
  .brand-story__benefit-title {
    font-family: var(--font-ui-family);
    font-size: var(--f0);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-primary);
  }
  .brand-story__benefit-text { font-size: var(--f1); color: var(--color-text-muted); }

  @media screen and (max-width: 1000px) {
    .brand-story,
    .brand-story--media-right { grid-template-columns: 1fr; }
    .brand-story--media-right .brand-story__media { order: 0; }
    .brand-story--image-full .brand-story__media { min-height: 50vh; }
    .brand-story__grid,
    .brand-story__grid--single { grid-template-columns: 1fr; gap: var(--space-lg); }
    .brand-story__benefits {
      padding: 32px 0 0;
      border-left: none;
      border-top: 1px solid var(--color-border);
      min-width: 0;
    }
    .brand-story__cta { width: 100%; }
  }
</style>

{% schema %}
{
  "name": "t:sections.brand_story.name",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.brand_story.settings.image.label" },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        { "value": "left", "label": "t:sections.brand_story.settings.image_position.options__1.label" },
        { "value": "right", "label": "t:sections.brand_story.settings.image_position.options__2.label" }
      ],
      "default": "left",
      "label": "t:sections.brand_story.settings.image_position.label"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        { "value": "full", "label": "Altura total (Preencher o bloco)" },
        { "value": "adapt", "label": "Adaptar à imagem (Tamanho natural)" },
        { "value": "portrait", "label": "Proporção Retrato (4:5)" },
        { "value": "square", "label": "Proporção Quadrada (1:1)" }
      ],
      "default": "full",
      "label": "Tamanho / Altura da imagem"
    },
    { "type": "text", "id": "eyebrow", "label": "t:sections.brand_story.settings.eyebrow.label", "default": "NOSSO MANIFESTO" },
    { "type": "text", "id": "heading", "label": "t:sections.brand_story.settings.heading.label", "default": "Design atemporal criado com propósito e precisão" },
    { "type": "richtext", "id": "text", "label": "t:sections.brand_story.settings.text.label", "default": "<p>Acreditamos que o essencial não precisa ser comum. Cada peça é desenvolvida selecionando matérias-primas de alta durabilidade e processos éticos.</p>" },
    { "type": "text", "id": "button_label", "label": "t:sections.brand_story.settings.button_label.label", "default": "CONHEÇA A COLEÇÃO" },
    { "type": "url", "id": "button_link", "label": "t:sections.brand_story.settings.button_link.label" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:sections.brand_story.blocks.benefit.name",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "quality", "label": "t:sections.brand_story.blocks.benefit.settings.icon.options__1.label" },
            { "value": "shipping", "label": "t:sections.brand_story.blocks.benefit.settings.icon.options__2.label" },
            { "value": "secure", "label": "t:sections.brand_story.blocks.benefit.settings.icon.options__3.label" },
            { "value": "support", "label": "t:sections.brand_story.blocks.benefit.settings.icon.options__4.label" }
          ],
          "default": "quality",
          "label": "t:sections.brand_story.blocks.benefit.settings.icon.label"
        },
        { "type": "text", "id": "title", "label": "t:sections.brand_story.blocks.benefit.settings.title.label", "default": "PRODUÇÃO AUTORAL" },
        { "type": "text", "id": "text", "label": "t:sections.brand_story.blocks.benefit.settings.text.label", "default": "Desenvolvido artesanalmente com materiais nobres." }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.brand_story.name",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "quality", "title": "QUALIDADE PREMIUM", "text": "Acabamento rigoroso em cada detalhe." } },
        { "type": "benefit", "settings": { "icon": "shipping", "title": "ENVIO ASSEGURADO", "text": "Entrega expressa e rastreada para todo o país." } },
        { "type": "benefit", "settings": { "icon": "secure", "title": "PAGAMENTO SEGURO", "text": "Criptografia de ponta a ponta na sua compra." } },
        { "type": "benefit", "settings": { "icon": "support", "title": "SUPORTE EXCLUSIVO", "text": "Atendimento humanizado antes e após o pedido." } }
      ]
    }
  ]
}
{% endschema %}