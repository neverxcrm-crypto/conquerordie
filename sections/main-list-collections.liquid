{%- comment -%}
  ============================================================
  MAIN LIST COLLECTIONS — grade com todas as coleções da loja
  ============================================================

  O QUE FAZ:
  Renderiza um grid com TODAS as coleções da loja, cada uma como
  painel editorial (snippets/collection-panel — o mesmo da home,
  com a faixa lateral e o nome na vertical). 3 colunas no desktop,
  2 no tablet, 1 no celular. Paginação nativa de 12 por página.

  ONDE É USADA:
  Template list-collections (página /collections que lista as coleções).

  PRINCIPAIS PARTES:
  - {%- paginate collections by 12 -%}: paginação da lista de coleções
  - Imagem/título/fallbacks: resolvidos dentro do snippet
  - render 'pagination': snippet de navegação entre páginas
  - Settings: heading, rótulos de contagem e CTA dos painéis

  OBSERVAÇÕES:
  O CSS é escopado por #shopify-section-{{ section.id }} para não vazar.
{%- endcomment -%}

<div class="list-collections page-width" data-section-id="{{ section.id }}">
  <header class="list-collections__header" data-reveal>
    <p class="eyebrow">{{ collections.size }} {{ section.settings.count_label | escape }}</p>
    {%- if section.settings.heading != blank -%}
      <h1 class="list-collections__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
  </header>

  {%- paginate collections by 12 -%}
    <ul class="list-collections__grid" role="list">
      {%- for collection in collections -%}
        {%- assign panel_index = paginate.current_offset | plus: forloop.index -%}
        <li class="list-collections__item" data-reveal>
          {%- render 'collection-panel',
            collection: collection,
            index: panel_index,
            cta: section.settings.card_cta,
            show_count: true,
            count_label: section.settings.products_label,
            sizes: '(min-width: 1001px) 30vw, (min-width: 601px) 50vw, 90vw',
            parallax: false
          -%}
        </li>
      {%- endfor -%}
    </ul>

    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

<style>
  #shopify-section-{{ section.id }} .list-collections {
    padding-top: clamp(32px, 5vw, 72px);
    padding-bottom: var(--space-section);
  }
  #shopify-section-{{ section.id }} .list-collections__header {
    display: grid;
    gap: 16px;
    margin-bottom: clamp(28px, 4vw, 56px);
  }
  #shopify-section-{{ section.id }} .list-collections__heading {
    font-size: var(--f8);
    text-transform: uppercase;
    margin: 0;
  }
  /* 3 colunas retrato no desktop, 2 no tablet, 1 no celular */
  #shopify-section-{{ section.id }} .list-collections__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 1.2vw, 18px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .collection-panel { aspect-ratio: 3 / 4; height: auto; }
  @media screen and (max-width: 1000px) {
    #shopify-section-{{ section.id }} .list-collections__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 600px) {
    #shopify-section-{{ section.id }} .list-collections__grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .collection-panel { aspect-ratio: 4 / 5; }
  }
  #shopify-section-{{ section.id }} .pagination {
    margin-top: 40px;
  }
  #shopify-section-{{ section.id }} .pagination__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* A paginacao NAO e redefinida aqui.
     Existia uma copia local, com alvo de 40px (abaixo do minimo de
     toque) e fonte maior que a do resto do tema — era a terceira
     definicao concorrente do mesmo componente. A versao unica vive
     em assets/base.css, na camada de componentes compartilhados. */
  #shopify-section-{{ section.id }} a.pagination__item:hover {
    border-color: var(--color-border);
  }
  #shopify-section-{{ section.id }} .pagination__item--current {
    border-color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
  }
</style>

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "tag": "section",
  "class": "section-main-list-collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Collections",
      "label": "t:sections.main_list_collections.settings.heading.label"
    },
    {
      "type": "text",
      "id": "count_label",
      "default": "coleções",
      "label": "t:sections.main_list_collections.settings.count_label.label"
    },
    {
      "type": "text",
      "id": "products_label",
      "default": "peças",
      "label": "t:sections.main_list_collections.settings.products_label.label"
    },
    {
      "type": "text",
      "id": "card_cta",
      "default": "Explorar",
      "label": "t:sections.main_list_collections.settings.card_cta.label"
    }
  ]
}
{% endschema %}
