{%- comment -%}
  ============================================================
  MAIN SEARCH — página de resultados de busca
  ============================================================

  O QUE FAZ:
  Renderiza o formulário de busca e os resultados mistos da loja
  (produtos, artigos de blog e páginas) com paginação. Usa GET,
  funcionando sem JavaScript.

  ONDE É USADA:
  No template de busca (templates/search.json), como section
  principal da página /search.

  PRINCIPAIS PARTES:
  - search__form: form GET para routes.search_url com o input de
    busca (name="q") preenchido com search.terms.
  - Bloco de resultados exibido só quando search.performed:
    mostra estado vazio (no_results) ou a contagem de resultados.
  - {% paginate search.results by 20 %}: percorre os itens e, via
    case item.object_type, renderiza cada tipo — 'product' usa o
    snippet 'card-product'; 'article' e 'page' montam um link com
    título e trecho (excerpt/content). O else cobre outros tipos.
  - Snippet 'pagination' ao final da lista.

  OBSERVAÇÕES:
  - Não tem settings no schema — comportamento fixo.
  - Trechos de artigo/página usam strip_html + truncatewords: 25.
  - Estilos inline no <style>, escopados por
    #shopify-section-{{ section.id }}.
{%- endcomment -%}

<div class="search page-width" data-section-id="{{ section.id }}">
  <header class="page-header search__header">
    <div class="page-header__inner">
      <h1 class="page-header__title">{{ 'templates.search.title' | t }}</h1>
    </div>

    {%- comment -%}
      Campo grande, com o ícone dentro e o botão como seta: a busca é
      a tarefa da página, então ela tem o peso de um título — e não o
      de um campo de formulário qualquer.
    {%- endcomment -%}
    <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
      <label class="visually-hidden" for="SearchInput-{{ section.id }}">
        {{ 'general.search.search' | t }}
      </label>
      <span class="search__icon" aria-hidden="true">{% render 'icon', name: 'search' %}</span>
      <input
        type="search"
        name="q"
        id="SearchInput-{{ section.id }}"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
        spellcheck="false"
        autocomplete="off"
        class="field__input search__input"
      >
      <button type="submit" class="search__submit" aria-label="{{ 'general.search.submit' | t }}">
        {% render 'icon', name: 'arrow-right' %}
      </button>
    </form>
  </header>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <div class="empty-state">
        <p class="empty-state__titulo">{{ 'templates.search.no_results_title' | t }}</p>
        <p class="empty-state__texto">{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button">
          {{ 'templates.search.browse_all' | t }}
        </a>
      </div>
    {%- else -%}
      <p class="toolbar__count search__count">
        {%- if search.results_count == 1 -%}
          {{ 'templates.search.results_with_count' | t: count: search.results_count, terms: search.terms }}
        {%- else -%}
          {{ 'templates.search.results_with_count_plural' | t: count: search.results_count, terms: search.terms }}
        {%- endif -%}
      </p>

      {%- paginate search.results by 20 -%}
        <ul class="search__results product-grid" role="list">
          {%- for item in search.results -%}
            <li class="search__result">
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'card-product', card_product: item %}

                {%- when 'article' -%}
                  <a href="{{ item.url }}" class="search__result-link">
                    {%- if item.image -%}
                      <div class="search__result-media">
                        {{
                          item.image
                          | image_url: width: 720
                          | image_tag:
                            loading: 'lazy',
                            widths: '180, 360, 540, 720',
                            sizes: '(min-width: 1000px) 25vw, 50vw',
                            class: 'search__result-image',
                            alt: item.title | escape
                        }}
                      </div>
                    {%- endif -%}
                    <div class="search__result-info">
                      <h3 class="search__result-title">{{ item.title | escape }}</h3>
                      {%- if item.excerpt != blank -%}
                        <p class="search__result-excerpt">{{ item.excerpt | strip_html | truncatewords: 25 }}</p>
                      {%- endif -%}
                    </div>
                  </a>

                {%- when 'page' -%}
                  <a href="{{ item.url }}" class="search__result-link">
                    <div class="search__result-info">
                      <h3 class="search__result-title">{{ item.title | escape }}</h3>
                      {%- if item.content != blank -%}
                        <p class="search__result-excerpt">{{ item.content | strip_html | truncatewords: 25 }}</p>
                      {%- endif -%}
                    </div>
                  </a>

                {%- else -%}
                  <a href="{{ item.url }}" class="search__result-link">
                    <div class="search__result-info">
                      <h3 class="search__result-title">{{ item.title | escape }}</h3>
                    </div>
                  </a>
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>

        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</div>

<style>
  #shopify-section-{{ section.id }} .search { padding-bottom: var(--space-section); }
  #shopify-section-{{ section.id }} .search__header { padding-bottom: var(--space-lg); }

  #shopify-section-{{ section.id }} .search__form {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 640px;
    margin-top: var(--space-md);
  }
  #shopify-section-{{ section.id }} .search__icon {
    position: absolute;
    left: 0;
    display: inline-flex;
    color: var(--color-text-muted);
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .search__icon svg { width: 18px; height: 18px; }
  /* Campo sem caixa: só um fio embaixo. Numa página cuja tarefa é
     digitar, a moldura não acrescenta nada — o texto é que manda. */
  #shopify-section-{{ section.id }} .search__input {
    flex: 1;
    min-height: 56px;
    padding: 0 48px 0 30px;
    font-size: var(--f4);
    color: var(--color-text-primary);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--color-border-strong);
    border-radius: 0;
    box-shadow: none;
  }
  #shopify-section-{{ section.id }} .search__input:focus {
    border-bottom-color: var(--color-accent);
    box-shadow: none;
  }
  #shopify-section-{{ section.id }} .search__input::-webkit-search-cancel-button { display: none; }
  #shopify-section-{{ section.id }} .search__submit {
    position: absolute;
    right: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-text-primary);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color var(--dur-normal) var(--ease-out), transform var(--dur-normal) var(--ease-out);
  }
  #shopify-section-{{ section.id }} .search__submit:hover { color: var(--color-accent-readable); transform: translateX(3px); }
  #shopify-section-{{ section.id }} .search__submit svg { width: 18px; height: 18px; }

  #shopify-section-{{ section.id }} .search__count {
    display: block;
    padding-block: var(--space-sm);
    border-block: 1px solid var(--color-border);
    margin-bottom: var(--space-lg);
  }

  #shopify-section-{{ section.id }} .search__results { margin: 0; padding: 0; list-style: none; }

  /* Resultados que não são produto (artigo, página): linha simples */
  #shopify-section-{{ section.id }} .search__result-link {
    display: grid;
    gap: var(--space-2xs);
    color: inherit;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .search__result-link img {
    width: 100%;
    height: auto;
    border-radius: var(--media-radius);
  }
  #shopify-section-{{ section.id }} .search__result-title {
    font-family: var(--font-ui-family);
    font-size: var(--f2);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
  }
  #shopify-section-{{ section.id }} .search__result-type {
    font-size: var(--f0);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media screen and (max-width: 1000px) {
    #shopify-section-{{ section.id }} .search__input { min-height: 48px; font-size: var(--f3); }
  }
</style>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "tag": "section",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
