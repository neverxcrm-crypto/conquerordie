{%- comment -%}
  ============================================================
  COLLECTION LIST — "Escolha seu lado"
  ============================================================

  O QUE FAZ:
  Galeria editorial de coleções curadas pelo lojista. Cada coleção é
  um painel retrato com a foto inteira e uma FAIXA LATERAL de vidro
  escuro onde o nome da coleção corre na vertical (lido de baixo
  para cima, como etiqueta de arara). É o momento de IDENTIFICAÇÃO
  da narrativa da home.

  ONDE É USADA:
  Home (templates/index.json) e qualquer página via preset.

  PAINEL:
  snippets/collection-panel.liquid (markup) + base.css "Collection
  panel" (estilo). Aqui fica só o layout em volta: intro, acordeão,
  trilho mobile, entrada e progresso.
{%- endcomment -%}

{%- liquid
  assign has_intro = false
  if section.settings.heading != blank or section.settings.text != blank
    assign has_intro = true
  endif
  assign total = section.blocks.size
  assign total_label = total | prepend: '0' | slice: -2, 2
-%}

<div
  class="collection-list"
  data-section-id="{{ section.id }}"
  style="--cl-count: {{ total | at_least: 1 }}; --cl-height: {{ section.settings.panel_height }}px;"
>
  <div class="page-width">
    {%- if has_intro -%}
      <header class="collection-list__intro" data-reveal-group>
        <div class="collection-list__intro-main">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            {%- assign heading_lines = section.settings.heading | newline_to_br | split: '<br />' -%}
            <h2 class="collection-list__heading">
              {%- for line in heading_lines -%}
                <span class="collection-list__line" data-reveal="mask">
                  <span class="collection-list__line-inner reveal-mask__inner">{{ line | strip }}</span>
                </span>
              {%- endfor -%}
            </h2>
          {%- endif -%}
        </div>
        <div class="collection-list__intro-aside" data-reveal>
          {%- if section.settings.text != blank -%}
            <p class="collection-list__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link | default: routes.collections_url }}" class="arrow-link collection-list__cta">
              {{ section.settings.button_label | escape }}
              {% render 'icon', name: 'arrow-right' %}
            </a>
          {%- endif -%}
        </div>
      </header>
    {%- endif -%}

    <ul class="collection-list__rail" role="list" data-collection-rail>
      {%- for block in section.blocks -%}
        {%- assign collection_obj = block.settings.collection -%}
        {%- assign card_image = block.settings.image | default: collection_obj.featured_image -%}
        {%- assign card_title = block.settings.title | default: collection_obj.title -%}

        <li class="collection-list__item is-revealed" data-reveal data-collection-item {{ block.shopify_attributes }}>
          {%- render 'collection-panel',
            collection: collection_obj,
            image: card_image,
            title: card_title,
            text: block.settings.text,
            index: forloop.index,
            cta: section.settings.card_cta,
            show_count: section.settings.show_count,
            count_label: section.settings.count_label,
            sizes: '(min-width: 1001px) 40vw, (min-width: 601px) 50vw, 80vw',
            parallax: true
          -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if total > 1 -%}
      <div class="collection-list__progress" aria-hidden="true">
        <span class="collection-list__counter"><span data-collection-current>01</span> / {{ total_label }}</span>
        <span class="collection-list__bar"><span class="collection-list__bar-fill" data-collection-bar></span></span>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .collection-list {
    --cl-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --cl-gap: clamp(8px, 0.9vw, 14px);
    --cl-radius: 16px;
    padding-top: var(--space-section, 60px);
    padding-bottom: var(--space-section, 60px);
    background-color: var(--color-background, #000000);
    overflow: hidden;
  }

  /* ---------- Intro ---------- */
  #shopify-section-{{ section.id }} .collection-list__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(20px, 4vw, 64px);
    margin-bottom: clamp(28px, 4vw, 56px);
  }
  #shopify-section-{{ section.id }} .collection-list__intro .eyebrow { margin-bottom: 18px; }
  #shopify-section-{{ section.id }} .collection-list__heading {
    font-family: var(--font-display-family, inherit);
    font-size: var(--f8, 2.5rem);
    font-weight: var(--font-weight-bold, 700);
    line-height: 0.95;
    letter-spacing: var(--tracking-display, -0.02em);
    text-transform: uppercase;
    margin: 0;
    text-wrap: balance;
  }
  #shopify-section-{{ section.id }} .collection-list__line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em 0.1em;
    margin-block: -0.06em -0.1em;
  }
  #shopify-section-{{ section.id }} .collection-list__line-inner { display: block; }
  #shopify-section-{{ section.id }} .collection-list__intro-aside {
    justify-self: end;
    max-width: 24rem;
    display: grid;
    gap: 18px;
    justify-items: start;
    padding-bottom: 6px;
  }
  #shopify-section-{{ section.id }} .collection-list__text {
    font-size: var(--f2, 0.95rem);
    color: var(--color-text-secondary, rgba(255, 255, 255, 0.7));
    margin: 0;
  }
  #shopify-section-{{ section.id }} .collection-list__cta { color: var(--color-text-primary, #ffffff); }

  /* ---------- Trilho ---------- */
  #shopify-section-{{ section.id }} .collection-list__rail {
    display: flex;
    gap: var(--cl-gap);
    list-style: none;
    margin: 0;
    padding: 0;
    outline: none;
  }
  #shopify-section-{{ section.id }} .collection-list__item {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
  }

  /* ---------- Correção e Garantia de Exibição das Imagens ---------- */
  #shopify-section-{{ section.id }} .collection-panel {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #141416;
    overflow: hidden;
    border-radius: var(--cl-radius);
  }

  #shopify-section-{{ section.id }} .collection-panel__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .collection-panel__image,
  #shopify-section-{{ section.id }} .collection-panel img,
  #shopify-section-{{ section.id }} .collection-panel svg {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
    filter: brightness(0.95) contrast(1.05);
  }

  /* Garante que o sombreamento do painel seja um gradiente suave em vez de preto sólido */
  #shopify-section-{{ section.id }} .collection-panel__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.75) 0%,
      rgba(0, 0, 0, 0.25) 50%,
      rgba(0, 0, 0, 0) 100%
    ) !important;
    opacity: 0.65 !important;
    pointer-events: none;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .collection-list__item:hover .collection-panel__shade {
    opacity: 0.35 !important;
  }

  /* Fallback visual caso nenhuma coleção/imagem esteja selecionada */
  #shopify-section-{{ section.id }} .collection-panel:not(:has(img)):not(:has(svg)) .collection-panel__frame {
    background: linear-gradient(135deg, #2a2a32 0%, #101014 100%);
  }

  /* ---------- Progresso (trilho mobile) ---------- */
  #shopify-section-{{ section.id }} .collection-list__progress { display: none; }

  /* ==========================================================
     DESKTOP — acordeão horizontal
     ========================================================== */
  @media screen and (min-width: 1001px) {
    #shopify-section-{{ section.id }} .collection-list__rail {
      height: min(clamp(420px, 44vw, var(--cl-height, 600px)), calc(100vh - var(--header-height, 80px) - 48px));
      min-height: 400px;
    }
    #shopify-section-{{ section.id }} .collection-list__item {
      transition: flex-grow 800ms var(--cl-ease);
    }
  }

  @media screen and (min-width: 1001px) and (hover: hover) {
    #shopify-section-{{ section.id }} .collection-list__item:hover,
    #shopify-section-{{ section.id }} .collection-list__item:focus-within {
      flex-grow: 1.9;
    }
    #shopify-section-{{ section.id }} .collection-list__item:hover .collection-panel__info,
    #shopify-section-{{ section.id }} .collection-list__item:focus-within .collection-panel__info {
      transition-delay: 180ms;
    }
    #shopify-section-{{ section.id }} .collection-list__rail:hover .collection-list__item:not(:hover) .collection-panel__shade {
      opacity: 0.75 !important;
    }
  }

  /* Mode animado GSAP */
  #shopify-section-{{ section.id }} .collection-list__rail.is-enhanced .collection-list__item {
    transition: clip-path 1100ms var(--cl-ease) !important;
  }
  #shopify-section-{{ section.id }} .collection-list__rail.is-depth .collection-panel__shade,
  #shopify-section-{{ section.id }} .collection-list__rail.is-enhanced .collection-panel__image,
  #shopify-section-{{ section.id }} .collection-list__rail.is-enhanced .collection-panel__shade,
  #shopify-section-{{ section.id }} .collection-list__rail.is-enhanced .collection-panel__info {
    transition: none !important;
  }
  #shopify-section-{{ section.id }} .collection-list__rail.is-enhanced .collection-panel { cursor: pointer; }

  /* ==========================================================
     TABLET / MOBILE — trilho com scroll-snap
     ========================================================== */
  @media screen and (max-width: 1000px) {
    #shopify-section-{{ section.id }} .collection-list__intro {
      grid-template-columns: 1fr;
      align-items: start;
    }
    #shopify-section-{{ section.id }} .collection-list__intro-aside { justify-self: start; }

    #shopify-section-{{ section.id }} .collection-list__rail {
      overflow-x: auto;
      touch-action: pan-x;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-gutter, 16px);
      margin-inline: calc(var(--page-gutter, 16px) * -1);
      padding-inline: var(--page-gutter, 16px);
      padding-bottom: 28px;
      margin-bottom: -28px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    #shopify-section-{{ section.id }} .collection-list__rail::-webkit-scrollbar { display: none; }
    #shopify-section-{{ section.id }} .collection-list__item {
      flex: 0 0 clamp(270px, 44vw, 390px);
      scroll-snap-align: start;
    }
    #shopify-section-{{ section.id }} .collection-panel {
      height: auto;
      aspect-ratio: 3 / 4;
      transform-origin: center 60%;
    }
    #shopify-section-{{ section.id }} .collection-list__progress {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-top: 24px;
    }
    #shopify-section-{{ section.id }} .collection-list__counter {
      font-family: var(--font-ui-family, inherit);
      font-size: var(--f0, 0.75rem);
      font-weight: 500;
      letter-spacing: var(--tracking-label, 0.05em);
      color: var(--color-text-muted, rgba(255, 255, 255, 0.5));
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    #shopify-section-{{ section.id }} .collection-list__counter [data-collection-current] { color: var(--color-text-primary, #ffffff); }
    #shopify-section-{{ section.id }} .collection-list__bar {
      position: relative;
      flex: 1;
      height: 1px;
      background-color: var(--color-border-strong, rgba(255, 255, 255, 0.2));
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .collection-list__bar-fill {
      position: absolute;
      inset: 0;
      background-color: var(--color-accent, #C9A24D);
      transform-origin: left center;
      transform: scaleX(calc(1 / var(--cl-count, 4)));
      transition: transform 200ms linear;
    }
  }

  @media screen and (max-width: 600px) {
    #shopify-section-{{ section.id }} .collection-list__item { flex-basis: 78vw; }
  }

  /* Entrada — Revelação sem bloquear o layout */
  .js #shopify-section-{{ section.id }} .collection-list__item[data-reveal] {
    opacity: 1;
    transform: none;
    clip-path: inset(0 round var(--cl-radius)) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .collection-list__item { transition-duration: 0.01ms !important; }
    .js #shopify-section-{{ section.id }} .collection-list__item[data-reveal] { clip-path: none !important; }
  }
</style>

<script>
  (function () {
    var raf = window.requestAnimationFrame || function (callback) { return window.setTimeout(callback, 16); };
    var SECTION_ID = 'shopify-section-{{ section.id }}';

    function init() {
      var section = document.getElementById(SECTION_ID);
      if (!section || section.__codCollections) return;
      section.__codCollections = true;

      var rail = section.querySelector('[data-collection-rail]');
      if (!rail) return;
      var items = Array.prototype.slice.call(rail.querySelectorAll('[data-collection-item]'));
      var bar = section.querySelector('[data-collection-bar]');
      var current = section.querySelector('[data-collection-current]');

      var trilho = { max: 0, visivel: 1 };
      function medirTrilho() {
        var total = Math.max(rail.scrollWidth, 1);
        trilho.max = rail.scrollWidth - rail.clientWidth;
        trilho.visivel = rail.clientWidth / total;
      }

      var progressTick = false;
      var ultimoIndice = '';
      function updateProgress() {
        progressTick = false;
        if (!bar) return;
        var ratio = trilho.max > 0 ? rail.scrollLeft / trilho.max : 0;
        var scale = trilho.visivel + (1 - trilho.visivel) * ratio;
        bar.style.transform = 'scaleX(' + Math.min(1, Math.max(0.04, scale)) + ')';
        if (current && items.length) {
          var indice = ('0' + (Math.round(ratio * (items.length - 1)) + 1)).slice(-2);
          if (indice !== ultimoIndice) {
            ultimoIndice = indice;
            current.textContent = indice;
          }
        }
      }

      function remedirTrilho() {
        medirTrilho();
        updateProgress();
      }

      rail.addEventListener('scroll', function () {
        if (!progressTick) { progressTick = true; raf(updateProgress); }
      }, { passive: true });
      window.addEventListener('resize', remedirTrilho);
      window.addEventListener('load', remedirTrilho);
      document.addEventListener('shopify:section:load', remedirTrilho);
      remedirTrilho();

      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var gsap = window.gsap;
      if (reduced || !gsap) return;

      var panels = items.map(function (item) {
        var panel = item.querySelector('.collection-panel');
        if (!panel) return null;
        return {
          item: item,
          panel: panel,
          img: panel.querySelector('.collection-panel__image, img'),
          shade: panel.querySelector('.collection-panel__shade'),
          info: panel.querySelector('.collection-panel__info'),
          title: panel.querySelector('.collection-panel__title-inner, .collection-panel__title'),
          text: panel.querySelector('.collection-panel__text'),
          meta: panel.querySelector('.collection-panel__meta'),
          arrow: panel.querySelector('.collection-panel__arrow svg')
        };
      }).filter(Boolean);

      var mm = gsap.matchMedia();

      /* DESKTOP — Acordeão com inércia */
      mm.add('(min-width: 1001px) and (hover: hover)', function () {
        var ac = typeof window.AbortController === 'function' ? new AbortController() : null;
        var on = function (el, type, fn) {
          if (!el) return;
          el.addEventListener(type, fn, ac ? { signal: ac.signal } : false);
        };
        var active = null;
        var timer = null;

        rail.classList.add('is-enhanced');

        panels.forEach(function (p) {
          gsap.set(p.item, { flexGrow: 1 });
          if (p.shade) gsap.set(p.shade, { opacity: 0.65 });
          if (p.img) gsap.set(p.img, { scale: 1, xPercent: 0, yPercent: 0 });
          if (p.info) gsap.set(p.info, { autoAlpha: 1, y: 0 });

          if (p.title) gsap.set(p.title, { yPercent: 0 });
          if (p.text || p.meta) gsap.set([p.text, p.meta].filter(Boolean), { autoAlpha: 1, y: 0 });

          if (p.img) p.imgX = gsap.quickTo(p.img, 'xPercent', { duration: 1.4, ease: 'power3.out' });
          if (p.img) p.imgY = gsap.quickTo(p.img, 'yPercent', { duration: 1.4, ease: 'power3.out' });
        });

        function invalidarRects() {
          panels.forEach(function (q) { q.rect = null; });
        }

        on(window, 'scroll', invalidarRects);
        on(window, 'resize', invalidarRects);

        function setActive(index) {
          if (active === index) return;
          active = index;
          var idle = index === null;

          panels.forEach(function (p, i) {
            var isOn = i === index;
            gsap.to(p.item, {
              flexGrow: idle ? 1 : (isOn ? 2.15 : 0.8),
              duration: 1.15,
              ease: 'expo.out',
              overwrite: 'auto'
            });
            if (p.shade) {
              gsap.to(p.shade, {
                opacity: idle ? 0.65 : (isOn ? 0.35 : 0.85),
                duration: 0.9,
                ease: 'power2.out',
                overwrite: 'auto'
              });
            }
            if (p.img) {
              gsap.to(p.img, {
                scale: isOn ? 1.08 : 1,
                duration: isOn ? 1.8 : 1.2,
                ease: 'power3.out',
                overwrite: 'auto'
              });
            }
          });
        }

        panels.forEach(function (p, i) {
          on(p.item, 'mouseenter', function () {
            window.clearTimeout(timer);
            timer = window.setTimeout(function () { setActive(i); }, active === null ? 40 : 80);
          });
          on(p.item, 'focusin', function () { window.clearTimeout(timer); setActive(i); });
        });

        on(rail, 'mouseleave', function () {
          window.clearTimeout(timer);
          timer = window.setTimeout(function () { setActive(null); }, 140);
        });

        return function () {
          window.clearTimeout(timer);
          if (ac) ac.abort();
          rail.classList.remove('is-enhanced');
        };
      });

      /* TABLET / MOBILE — Profundidade no trilho */
      mm.add('(max-width: 1000px)', function () {
        var ac = typeof window.AbortController === 'function' ? new AbortController() : null;
        var tick = false;
        rail.classList.add('is-depth');

        function paint() {
          tick = false;
          var anchor = rail.getBoundingClientRect().left + parseFloat(getComputedStyle(rail).paddingLeft || 0);
          panels.forEach(function (p) {
            var box = p.item.getBoundingClientRect();
            var d = Math.min(1, Math.abs(box.left - anchor) / Math.max(box.width, 1));
            gsap.set(p.panel, { scale: 1 - d * 0.05 });
            if (p.shade) gsap.set(p.shade, { opacity: 0.5 + d * 0.3 });
          });
        }

        var onRailScroll = function () {
          if (!tick) { tick = true; raf(paint); }
        };
        rail.addEventListener('scroll', onRailScroll, ac ? { passive: true, signal: ac.signal } : false);

        paint();

        return function () { if (ac) ac.abort(); rail.classList.remove('is-depth'); };
      });
    }

    if (typeof window.CODReady === 'function') {
      window.CODReady(init);
    } else if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

{% schema %}
{
  "name": "Lista de coleções",
  "tag": "section",
  "class": "section-collection-list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Subtítulo / Eyebrow", "default": "NARRATIVA" },
    { "type": "textarea", "id": "heading", "default": "ESCOLHA\nSEU LADO", "label": "Título Principal" },
    { "type": "text", "id": "text", "label": "Texto Descritivo" },
    { "type": "text", "id": "button_label", "label": "Texto do Botão", "default": "Ver Coleções" },
    { "type": "url", "id": "button_link", "label": "Link do Botão" },
    {
      "type": "range",
      "id": "panel_height",
      "min": 440,
      "max": 760,
      "step": 20,
      "unit": "px",
      "default": 600,
      "label": "Altura dos Painéis (Desktop)"
    },
    { "type": "text", "id": "card_cta", "default": "Explorar", "label": "Texto da Tag dos Cards" },
    { "type": "checkbox", "id": "show_count", "default": true, "label": "Exibir Contagem de Itens" },
    { "type": "text", "id": "count_label", "default": "peças", "label": "Rótulo de Contagem" }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "Coleção",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "image_picker", "id": "image", "label": "Imagem Personalizada" },
        { "type": "text", "id": "title", "label": "Título Personalizado" },
        { "type": "text", "id": "text", "label": "Descrição Curta" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Lista de Coleções (Escolha seu lado)",
      "blocks": [
        { "type": "featured_collection" },
        { "type": "featured_collection" },
        { "type": "featured_collection" },
        { "type": "featured_collection" }
      ]
    }
  ]
}
{% endschema %}
