{
  "name": "Slider Premium",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Dimensões do Slider"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        { "value": "short", "label": "Pequeno" },
        { "value": "default", "label": "Padrão" },
        { "value": "tall", "label": "Tela Cheia (100vh)" }
      ],
      "default": "default",
      "label": "Altura do Banner"
    },
    {
      "type": "select",
      "id": "content_position",
      "options": [
        { "value": "topo", "label": "Em cima" },
        { "value": "centro", "label": "No meio" },
        { "value": "rodape", "label": "Embaixo" }
      ],
      "default": "centro",
      "label": "Posição do texto",
      "info": "No meio é o mais seguro no computador. No celular ele desce para o terço de baixo sozinho, porque lá a foto é alta e o texto no meio cobriria o produto."
    },
    {
      "type": "header",
      "content": "Configurações de Transição"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Ativar rotação automática",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Tempo de troca dos slides",
      "default": 5
    },
    {
      "type": "header",
      "content": "Interface"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar setas (Apenas Desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Mostrar indicador (Bolinhas)",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem Desktop"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagem Mobile (Opcional)",
          "info": "Se vazio, usará a imagem desktop ajustada."
        },
        {
          "type": "header",
          "content": "Aparência da Máscara (Overlay)"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Cor do Escurecimento",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Opacidade da Máscara",
          "default": 20,
          "info": "Aumente para melhorar a leitura em fotos claras."
        },
        {
          "type": "header",
          "content": "Conteúdo de Texto"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Alinhamento do Texto",
          "options": [
            { "value": "left", "label": "Esquerda" },
            { "value": "center", "label": "Centro" },
            { "value": "right", "label": "Direita" }
          ],
          "default": "left"
