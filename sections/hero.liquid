{%- comment -%}
  ============================================================
  HERO — Abertura Editorial Customizável (OS 2.0)
  ============================================================
{%- endcomment -%}
{%- liquid
  assign slides = section.blocks
  assign slide_count = slides.size
-%}

<div
  class="hero hero--{{ section.settings.height }}"
  data-section-id="{{ section.id }}"
  {% if slide_count > 1 %}data-hero-carousel role="region" aria-roledescription="carousel" aria-label="{{ shop.name | escape }}"{% endif %}
>
  <ul class="hero__slides" role="list">
    {%- for block in slides -%}
      {%- liquid
        if forloop.first
          assign slide_loading = 'eager'
          assign slide_priority = 'high'
        else
          assign slide_loading = 'lazy'
          assign slide_priority = 'auto'
        endif

        assign overlay_alpha = block.settings.overlay_opacity | divided_by: 100.0
      -%}

      <li
        class="hero__slide hero__slide--{{ block.id }} hero__slide--valign-{{ block.settings.desktop_position }} hero__slide--align-{{ block.settings.desktop_alignment }} hero__slide--mobile-align-{{ block.settings.mobile_alignment }} {% if forloop.first %}is-active{% endif %}"
        data-hero-slide
        style="
          --slide-text-color: {{ block.settings.text_color }};
          --slide-eyebrow-color: {{ block.settings.eyebrow_color }};
          --slide-cta-bg: {{ block.settings.button_bg_color }};
          --slide-cta-text: {{ block.settings.button_text_color }};
          --slide-overlay-opacity: {{ overlay_alpha }};
        "
        {% if slide_count > 1 %}
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} / {{ slide_count }}"
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="hero__media">
          {%- if block.settings.image != blank -%}
            {%- if block.settings.image_mobile != blank -%}
              <picture>
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {{ block.settings.image_mobile | image_url: width: 750 }} 750w,
                    {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w
                  "
                  sizes="100vw"
                >
                {{
                  block.settings.image
                  | image_url: width: 3000
                  | image_tag:
                    loading: slide_loading,
                    fetchpriority: slide_priority,
                    class: 'hero__image',
                    widths: '900, 1200, 1600, 2000, 2600, 3000',
                    sizes: '100vw',
                    alt: block.settings.image.alt | default: block.settings.heading | escape
                }}
              </picture>
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 3000
                | image_tag:
                  loading: slide_loading,
                  fetchpriority: slide_priority,
                  class: 'hero__image',
                  widths: '900, 1200, 1600, 2000, 2600, 3000',
                  sizes: '100vw',
                  alt: block.settings.image.alt | default: block.settings.heading | escape
              }}
            {%- endif -%}
          {%- else -%}
            <div class="hero__image hero__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
          <div class="hero__overlay" aria-hidden="true"></div>
        </div>

        <div class="hero__content page-width">
          <div class="hero__text">
            {%- if block.settings.eyebrow != blank -%}
              <p class="eyebrow hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              {%- if forloop.first -%}
                <h1 class="hero__heading hero__heading--{{ block.settings.heading_size }}">{{ block.settings.heading | newline_to_br }}</h1>
              {%- else -%}
                <p class="hero__heading hero__heading--{{ block.settings.heading_size }}" role="heading" aria-level="2">{{ block.settings.heading | newline_to_br }}</p>
              {%- endif -%}
            {%- endif -%}

            {%- if block.settings.subheading != blank -%}
              <p class="hero__subheading">{{ block.settings.subheading | escape }}</p>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="hero__body rte">{{ block.settings.text }}</div>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="button hero__cta hero__cta--{{ block.settings.button_style }}">
                <span>{{ block.settings.button_label | escape }}</span>
                {% render 'icon', name: 'arrow-right' %}
              </a>
            {%- endif -%}
          </div>
        </div>
      </li>
    {%- endfor -%}
  </ul>

  {%- if slide_count > 1 -%}
    <div class="hero__indicator">
      <button type="button" class="hero__nav tap-target" data-hero-prev aria-label="{{ 'general.slider.previous' | t }}">
        {% render 'icon', name: 'arrow-right' %}
      </button>
      <p class="hero__counter" aria-live="polite">
        <span class="hero__counter-current" data-hero-current>01</span>
        <span class="hero__counter-total">{{ slide_count | prepend: '0' | slice: -2, 2 }}</span>
      </p>
      <button type="button" class="hero__nav tap-target" data-hero-next aria-label="{{ 'general.slider.next' | t }}">
        {% render 'icon', name: 'arrow-right' %}
      </button>
    </div>
  {%- endif -%}
</div>

<style>
  .hero {
    margin-top: calc(-1 * var(--header-height, 70px));
    position: relative;
    background-color: #000000;
    overflow: hidden;
  }
  .hero__slides { list-style: none; margin: 0; padding: 0; display: grid; }
  
  .hero__slide {
    grid-area: 1 / 1;
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 88vh;
    opacity: 0;
    visibility: hidden;
    transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1), visibility 600ms;
    color: var(--slide-text-color, #ffffff);
  }

  .hero__slide.is-active { opacity: 1; visibility: visible; }
  .hero--short .hero__slide { min-height: 70vh; }
  .hero--tall .hero__slide { min-height: 94vh; }

  /* Mídia & Overlays */
  .hero__media { position: absolute; inset: 0; }
  .hero__image { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero__placeholder { display: flex; align-items: center; justify-content: center; background-color: #121212; }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: #000000;
    opacity: var(--slide-overlay-opacity, 0.4);
    pointer-events: none;
  }

  /* Posicionamento & Alinhamento Desktop */
  @media screen and (min-width: 1001px) {
    .hero__slide--valign-top { align-items: flex-start; padding-top: calc(var(--header-height, 70px) + 40px); }
    .hero__slide--valign-center { align-items: center; }
    .hero__slide--valign-bottom { align-items: flex-end; }

    .hero__slide--align-left .hero__text { margin-right: auto; margin-left: 0; text-align: left; }
    .hero__slide--align-center .hero__text { margin-right: auto; margin-left: auto; text-align: center; }
    .hero__slide--align-right .hero__text { margin-left: auto; margin-right: 0; text-align: right; }
  }

  /* Alinhamento Mobile */
  @media screen and (max-width: 1000px) {
    .hero__slide--mobile-align-left .hero__text { text-align: left; margin-right: auto; margin-left: 0; }
    .hero__slide--mobile-align-center .hero__text { text-align: center; margin-right: auto; margin-left: auto; }
    .hero__slide--mobile-align-right .hero__text { text-align: right; margin-left: auto; margin-right: 0; }
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-bottom: clamp(48px, 8vh, 100px);
  }

  .hero__text { max-width: 36rem; width: 100%; }

  /* Typografias Customizáveis */
  .hero__eyebrow {
    margin-bottom: 16px;
    color: var(--slide-eyebrow-color, #d4a640);
    font-size: var(--f1, 0.85rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .hero__heading {
    margin-bottom: 20px;
    color: var(--slide-text-color, #ffffff);
    line-height: 1.1;
  }
  .hero__heading--small { font-size: var(--f6, 2rem); }
  .hero__heading--medium { font-size: var(--f8, 3rem); }
  .hero__heading--large { font-size: clamp(2.5rem, 5vw, 4.2rem); }

  .hero__subheading {
    font-family: var(--font-ui-family, inherit);
    font-size: var(--f2, 0.95rem);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--slide-text-color, #ffffff);
    margin-bottom: 16px;
    opacity: 0.9;
  }

  .hero__body {
    font-size: var(--f2, 1rem);
    color: var(--slide-text-color, #ffffff);
    opacity: 0.8;
    margin-bottom: 28px;
    max-width: 34ch;
  }
  .hero__slide--align-center .hero__body,
  .hero__slide--mobile-align-center .hero__body { margin-left: auto; margin-right: auto; }
  .hero__body p { margin: 0 0 6px; }

  /* Estilos do Botão CTA & Hover Customizado */
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 180px;
    padding: 14px 28px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    transition: transform 250ms ease, background-color 250ms ease, border-color 250ms ease, color 250ms ease;
  }

  .hero__cta--solid {
    background-color: var(--slide-cta-bg, #ffffff);
    color: var(--slide-cta-text, #000000);
    border: 1px solid var(--slide-cta-bg, #ffffff);
  }

  .hero__cta--outline {
    background-color: transparent;
    color: var(--slide-text-color, #ffffff);
    border: 1px solid var(--slide-text-color, #ffffff);
  }

  .hero__cta svg {
    transition: transform 250ms ease, stroke 250ms ease, fill 250ms ease, color 250ms ease;
  }

  /* Hover com Borda Branca, Texto Branco e Seta Branca */
  .hero__cta:hover {
    transform: translateY(-2px);
    background-color: transparent !important;
    border-color: #ffffff !important;
    color: #ffffff !important;
  }

  .hero__cta:hover span,
  .hero__cta:hover svg {
    color: #ffffff !important;
    stroke: #ffffff !important;
    fill: #ffffff !important;
  }

  /* Indicador do Carrossel */
  .hero__indicator {
    position: absolute;
    right: var(--page-gutter, 20px);
    bottom: clamp(48px, 8vh, 100px);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .hero__counter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: var(--f1, 0.85rem);
    font-weight: 500;
    color: #ffffff;
    margin: 0;
  }
  .hero__counter-total { opacity: 0.5; }
  .hero__counter-total::before {
    content: '';
    display: block;
    width: 1px;
    height: 24px;
    margin: 0 auto 6px;
    background-color: rgba(255, 255, 255, 0.3);
  }
  .hero__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: #ffffff;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 200ms ease;
  }
  .hero__nav:hover { opacity: 1; }
  .hero__nav svg { width: 14px; height: 14px; }
  [data-hero-prev] svg { transform: rotate(-90deg); }
  [data-hero-next] svg { transform: rotate(90deg); }

  @media screen and (max-width: 749px) {
    .hero__slide { min-height: 78vh; }
    .hero--tall .hero__slide { min-height: 86vh; }
    .hero__cta { width: 100%; }
    .hero__indicator { flex-direction: row; bottom: 20px; right: var(--page-gutter, 20px); }
    .hero__counter { flex-direction: row; gap: 4px; }
    .hero__counter-total::before { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide { transition-duration: 0.01ms !important; }
  }
</style>

{%- if slide_count > 1 -%}
  <script>
    (function () {
      var root = document.querySelector('[data-hero-carousel][data-section-id="{{ section.id }}"]');
      if (!root) return;

      var slides = Array.prototype.slice.call(root.querySelectorAll('[data-hero-slide]'));
      var current = root.querySelector('[data-hero-current]');
      var index = 0;

      function pad(n) { return (n < 10 ? '0' : '') + n; }

      function show(next) {
        index = (next + slides.length) % slides.length;
        slides.forEach(function (slide, i) {
          var active = i === index;
          slide.classList.toggle('is-active', active);
          if (active) {
            slide.removeAttribute('aria-hidden');
            slide.removeAttribute('inert');
          } else {
            slide.setAttribute('aria-hidden', 'true');
            slide.setAttribute('inert', '');
          }
        });
        if (current) current.textContent = pad(index + 1);
      }

      show(0);

      var prev = root.querySelector('[data-hero-prev]');
      var next = root.querySelector('[data-hero-next]');
      if (prev) prev.addEventListener('click', function () { show(index - 1); });
      if (next) next.addEventListener('click', function () { show(index + 1); });

      root.addEventListener('keydown', function (event) {
        if (event.key === 'ArrowLeft') { show(index - 1); }
        if (event.key === 'ArrowRight') { show(index + 1); }
      });

      var startX = 0;
      var startY = 0;
      root.addEventListener('touchstart', function (event) {
        startX = event.changedTouches[0].clientX;
        startY = event.changedTouches[0].clientY;
      }, { passive: true });
      root.addEventListener('touchend', function (event) {
        var dx = event.changedTouches[0].clientX - startX;
        var dy = event.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy)) {
          show(dx < 0 ? index + 1 : index - 1);
        }
      }, { passive: true });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Altura da Seção",
      "options": [
        { "value": "short", "label": "Pequeno (70vh)" },
        { "value": "default", "label": "Padrão (88vh)" },
        { "value": "tall", "label": "Grande (94vh)" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide do Hero",
      "settings": [
        {
          "type": "header",
          "content": "🖼️ Mídia & Imagens"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem Desktop"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagem Mobile (Retrato)",
          "info": "Opcional. Recomendado para evitar cortes na composição em telas verticais."
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "label": "Escurecimento da Imagem (Overlay)",
          "default": 40
        },
        {
          "type": "header",
          "content": "📐 Layout & Alinhamento"
        },
        {
          "type": "select",
          "id": "desktop_position",
          "label": "Posição Vertical (Desktop)",
          "options": [
            { "value": "top", "label": "Topo" },
            { "value": "center", "label": "Centro" },
            { "value": "bottom", "label": "Base" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "desktop_alignment",
          "label": "Alinhamento do Texto (Desktop)",
          "options": [
            { "value": "left", "label": "Esquerda" },
            { "value": "center", "label": "Centro" },
            { "value": "right", "label": "Direita" }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "mobile_alignment",
          "label": "Alinhamento do Texto (Mobile)",
          "options": [
            { "value": "left", "label": "Esquerda" },
            { "value": "center", "label": "Centro" },
            { "value": "right", "label": "Direita" }
          ],
          "default": "left"
        },
        {
          "type": "header",
          "content": "✏️ Conteúdo do Slide"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow / Selo de Campanha",
          "default": "Drop 002 — The Rebellion"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Título Principal (Heading)",
          "default": "Conquer\nor Die"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Tamanho do Título",
          "options": [
            { "value": "small", "label": "Pequeno" },
            { "value": "medium", "label": "Médio" },
            { "value": "large", "label": "Grande / Display" }
          ],
          "default": "medium"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subtítulo",
          "default": "NOT MADE TO BLEND IN."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Descrição",
          "default": "<p>Mais que roupas, uma mentalidade. Conquiste o que é seu.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do Botão (CTA)",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link do Botão"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Estilo do Botão",
          "options": [
            { "value": "solid", "label": "Sólido" },
            { "value": "outline", "label": "Contorno / Outline" }
          ],
          "default": "solid"
        },
        {
          "type": "header",
          "content": "🎨 Cores Personalizadas"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Cor dos Textos",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "eyebrow_color",
          "label": "Cor do Eyebrow",
          "default": "#d4a640"
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "Fundo do Botão (Sólido)",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Texto do Botão (Sólido)",
          "default": "#000000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}