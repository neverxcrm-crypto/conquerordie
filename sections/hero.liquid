{%- comment -%}
  ============================================================
  HERO — Slider com Autoplay (5s), Deslize Lateral e Setas
  ============================================================
{%- endcomment -%}
{%- liquid
  assign slides = section.blocks
  assign slide_count = slides.size
-%}
<div
  class="hero scheme-dark hero--{{ section.settings.height }}"
  data-section-id="{{ section.id }}"
  data-header-overlay
  {% if slide_count > 1 %}data-hero-carousel role="region" aria-roledescription="carousel" aria-label="{{ shop.name | escape }}" tabindex="0"{% endif %}
>
  <ul class="hero__slides" role="list">
    {%- for block in slides -%}
      <li
        class="hero__slide {% if forloop.first %}is-active{% endif %}"
        data-hero-slide
        {% if slide_count > 1 %}
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} / {{ slide_count }}"
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {%- liquid
          if forloop.first
            assign slide_loading = 'eager'
            assign slide_priority = 'high'
          else
            assign slide_loading = 'lazy'
            assign slide_priority = 'auto'
          endif
        -%}

        <!-- Imagem do Banner -->
        <div class="hero__media">
          {%- if block.settings.image != blank -%}
            {%- if block.settings.image_mobile != blank -%}
              <picture>
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {{ block.settings.image_mobile | image_url: width: 750 }} 750w,
                    {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w
                  "
                  sizes="100vw"
                >
                {{
                  block.settings.image
                  | image_url: width: 3000
                  | image_tag:
                    loading: slide_loading,
                    fetchpriority: slide_priority,
                    class: 'hero__image',
                    widths: '900, 1200, 1600, 2000, 2600, 3000',
                    sizes: '100vw',
                    alt: block.settings.image.alt | default: block.settings.heading | escape
                }}
              </picture>
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 3000
                | image_tag:
                  loading: slide_loading,
                  fetchpriority: slide_priority,
                  class: 'hero__image',
                  widths: '900, 1200, 1600, 2000, 2600, 3000',
                  sizes: '100vw',
                  alt: block.settings.image.alt | default: block.settings.heading | escape
              }}
            {%- endif -%}
          {%- else -%}
            <div class="hero__image hero__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        <!-- Conteúdo do Banner -->
        <div class="hero__content page-width">
          <div class="hero__text-container">

            <!-- Eyebrow -->
            {%- if block.settings.eyebrow != blank -%}
              <div class="hero__element hero__element--eyebrow">
                <p class="eyebrow hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>
              </div>
            {%- endif -%}

            <!-- Título -->
            {%- if block.settings.heading != blank -%}
              <div class="hero__element hero__element--heading">
                {%- if forloop.first -%}
                  <h1 class="hero__heading">{{ block.settings.heading | newline_to_br }}</h1>
                {%- else -%}
                  <p class="hero__heading" role="heading" aria-level="2">{{ block.settings.heading | newline_to_br }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

            <!-- Subtítulo -->
            {%- if block.settings.subheading != blank -%}
              <div class="hero__element hero__element--subheading">
                <p class="hero__subheading">{{ block.settings.subheading | escape }}</p>
              </div>
            {%- endif -%}

            <!-- Descrição -->
            {%- if block.settings.text != blank -%}
              <div class="hero__element hero__element--body">
                <div class="hero__body rte">{{ block.settings.text }}</div>
              </div>
            {%- endif -%}

            <!-- Botão CTA -->
            {%- if block.settings.button_label != blank -%}
              <div class="hero__element hero__element--cta">
                <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="button hero__cta">
                  <span>{{ block.settings.button_label | escape }}</span>
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 8px;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            {%- endif -%}

          </div>
        </div>
      </li>
    {%- endfor -%}
  </ul>

  {%- if slide_count > 1 -%}
    <!-- SETAS LATERAIS (NOVAS) -->
    <button type="button" class="hero__arrow hero__arrow--prev tap-target" data-hero-prev aria-label="Slide anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button type="button" class="hero__arrow hero__arrow--next tap-target" data-hero-next aria-label="Próximo slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>

    <!-- INDICADOR NUMÉRICO E SETAS PEQUENAS -->
    <div class="hero__indicator">
      <button type="button" class="hero__nav tap-target" data-hero-prev aria-label="Anterior">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      </button>
      <p class="hero__counter" aria-live="polite">
        <span class="hero__counter-current" data-hero-current>01</span>
        <span class="hero__counter-divider">/</span>
        <span class="hero__counter-total">{{ slide_count | prepend: '0' | slice: -2, 2 }}</span>
      </p>
      <button type="button" class="hero__nav tap-target" data-hero-next aria-label="Próximo">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </button>
    </div>
  {%- endif -%}
</div>

<style>
  .hero {
    margin-top: calc(-1 * var(--header-height, 70px));
    position: relative;
    background-color: var(--color-background, #000000);
    overflow: hidden;
    width: 100%;
  }

  .hero__slides {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex; /* Mantém o comportamento de carrossel deslizando */
    width: 100%;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .hero__slide {
    flex: 0 0 100%;
    min-width: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-sizing: border-box;
  }

  /* Alturas Dinâmicas Responsivas */
  .hero--short .hero__slide { min-height: clamp(420px, 60vh, 600px); }
  .hero--default .hero__slide { min-height: clamp(520px, 80vh, 850px); }
  .hero--tall .hero__slide { min-height: 100vh; min-height: 100dvh; }

  @media screen and (min-width: 1001px) {
    .hero__slide { justify-content: center; }
  }

  /* Mídia */
  .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface, #121212);
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      var(--photo-veil-bottom, linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 40%, transparent 80%)),
      var(--photo-veil-side, linear-gradient(to right, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.25) 50%, transparent 100%));
    pointer-events: none;
  }

  /* Conteúdo */
  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    box-sizing: border-box;
    padding-top: calc(var(--header-height, 70px) + max(20px, env(safe-area-inset-top, 0px)));
    padding-bottom: clamp(80px, 12vh, 140px);
  }

  @media screen and (min-width: 1001px) {
    .hero__content {
      padding-top: calc(var(--header-height, 70px) + 40px);
      padding-bottom: 60px;
    }
  }

  .hero__text-container {
    position: relative;
    max-width: min(42rem, 100%);
    width: 100%;
  }

  @media screen and (min-width: 1001px) {
    .hero__text-container { max-width: min(42rem, 52vw); }
  }

  /* Elementos de Texto */
  .hero__element {
    position: relative;
    display: block;
    isolation: isolate;
    max-width: 100%;
  }
  .hero__element--eyebrow { margin-bottom: 14px; }
  .hero__element--heading { margin-bottom: 16px; display: block; width: 100%; }
  .hero__element--subheading { margin-bottom: 16px; }
  .hero__element--body { margin-bottom: 28px; }
  .hero__element--cta { margin-top: 8px; display: inline-flex; width: auto; align-items: center; }

  /* Animações (Somente ativo) */
  .js .hero__slide .hero__element { opacity: 0; }
  .js .hero__slide.is-active .hero__element {
    animation: heroEntrada var(--dur-reveal, 560ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
    animation-delay: calc(var(--hero-i, 0) * 70ms);
  }
  .hero__element--eyebrow { --hero-i: 0; }
  .hero__element--heading { --hero-i: 1; }
  .hero__element--subheading { --hero-i: 2; }
  .hero__element--body { --hero-i: 3; }
  .hero__element--cta { --hero-i: 4; }

  @keyframes heroEntrada {
    from { opacity: 0; transform: translate3d(0, 14px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  .hero__slide.is-active .hero__image {
    animation: heroFoto 1200ms var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
  }
  @keyframes heroFoto {
    from { transform: scale(1.04); }
    to { transform: scale(1); }
  }

  /* Tipografia */
  .hero__heading {
    max-width: 12ch;
    font-size: clamp(2.4rem, 8.5vw, 6.8rem);
    line-height: 0.98;
    margin: 0;
    color: var(--color-text-primary, #ffffff);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.55);
    text-wrap: balance;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .hero__subheading {
    font-family: var(--font-ui-family, inherit);
    font-size: clamp(0.875rem, 0.8rem + 0.4vw, 1.0625rem);
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: var(--tracking-label, 0.05em);
    text-transform: uppercase;
    color: var(--color-text-primary, #ffffff);
    margin: 0;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  .hero__eyebrow {
    margin: 0;
    font-size: var(--f0);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }

  .hero__body {
    font-size: clamp(0.9375rem, 0.9rem + 0.25vw, 1.0625rem);
    line-height: 1.55;
    color: var(--color-text-secondary, rgba(255, 255, 255, 0.88));
    max-width: 42ch;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }
  .hero__body p { margin: 0 0 6px; }

  /* Botão CTA */
  .hero__cta {
    position: relative;
    z-index: 1;
    min-width: 180px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    transition: all var(--dur-fast) var(--ease-out);
  }

  .hero__cta:hover {
    transform: translateY(-1px);
    background-color: var(--color-button-primary-background-hover);
    border-color: var(--color-button-primary-background-hover);
    color: var(--color-button-primary-text-hover);
  }
  .hero__cta:active { transform: translateY(0); }

  /* ========================================================
     ESTILOS DAS SETAS LATERAIS
     ======================================================== */
  .hero__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: rgba(255, 255, 255, 0.15);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    cursor: pointer;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: background-color 0.2s, transform 0.2s, border-color 0.2s;
  }

  .hero__arrow:hover {
    background-color: rgba(255, 255, 255, 0.3);
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-50%) scale(1.05);
  }

  .hero__arrow svg {
    width: 24px;
    height: 24px;
  }

  .hero__arrow--prev { left: 24px; }
  .hero__arrow--next { right: 24px; }

  /* Ajuste das setas laterais para mobile */
  @media screen and (max-width: 749px) {
    .hero__arrow {
      width: 40px;
      height: 40px;
      /* Se quiser esconder as setas no mobile (pois podem dar swipe com o dedo), ative a linha abaixo: */
      /* display: none; */
    }
    .hero__arrow svg { width: 20px; height: 20px; }
    .hero__arrow--prev { left: 16px; }
    .hero__arrow--next { right: 16px; }
  }


  /* ========================================================
     INDICADOR (Números e setinhas auxiliares)
     ======================================================== */
  .hero__indicator {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hero__counter {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-ui-family, inherit);
    font-size: var(--f1, 1.2rem);
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: var(--tracking-label, 0.05em);
    color: var(--color-text-primary, #ffffff);
    margin: 0;
  }

  .hero__counter-divider { opacity: 0.5; }
  .hero__counter-total { color: var(--color-text-muted, rgba(255, 255, 255, 0.6)); }

  .hero__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--color-text-secondary, rgba(255, 255, 255, 0.8));
    cursor: pointer;
    padding: 8px;
    opacity: 0.8;
    transition: opacity 200ms ease, color 200ms ease;
  }
  .hero__nav:hover, .hero__nav:focus-visible { opacity: 1; color: #ffffff; }

  /* Desktop Indicador */
  @media screen and (min-width: 750px) {
    .hero__indicator {
      right: var(--page-gutter, 24px);
      bottom: clamp(40px, 8vh, 80px);
      flex-direction: column;
      gap: 6px;
    }
    .hero__counter { flex-direction: column; gap: 6px; }
    .hero__counter-divider { display: none; }
    .hero__counter-total::before {
      content: ''; display: block; width: 1px; height: 24px;
      margin: 0 auto 6px; background-color: var(--color-border-strong, rgba(255, 255, 255, 0.25));
    }
    /* Gira as setinhas menores no desktop */
    .hero__indicator [data-hero-prev] svg { transform: rotate(90deg); }
    .hero__indicator [data-hero-next] svg { transform: rotate(90deg); }
  }

  /* Mobile Indicador */
  @media screen and (max-width: 749px) {
    .hero__element--cta { width: 100%; }
    .hero__cta { width: 100%; justify-content: center; }

    .hero__indicator {
      bottom: max(16px, env(safe-area-inset-bottom, 16px));
      right: var(--page-gutter, 16px);
      left: auto;
      background-color: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      padding: 4px 8px;
      border-radius: 30px;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .hero__slide .hero__element { opacity: 1; }
    .js .hero__slide.is-active .hero__element,
    .hero__slide.is-active .hero__image { animation: none; }
    .hero__slide { transition-duration: 0.01ms !important; }
  }
</style>

{%- if slide_count > 1 -%}
  <script>
    (function () {
      var root = document.querySelector('[data-hero-carousel][data-section-id="{{ section.id }}"]');
      if (!root) return;

      var sliderContainer = root.querySelector('.hero__slides');
      var slides = Array.prototype.slice.call(root.querySelectorAll('[data-hero-slide]'));
      var current = root.querySelector('[data-hero-current]');
      var index = 0;
      var autoPlayInterval;

      // Velocidade 5000 = 5 segundos
      var AUTOPLAY_SPEED = 5000;

      function pad(n) { return (n < 10 ? '0' : '') + n; }

      function show(next) {
        index = (next + slides.length) % slides.length;

        sliderContainer.style.transform = 'translateX(-' + (index * 100) + '%)';

        slides.forEach(function (slide, i) {
          var active = i === index;
          if (active) {
            slide.classList.add('is-active');
            slide.removeAttribute('aria-hidden');
            slide.removeAttribute('inert');
          } else {
            slide.classList.remove('is-active');
            slide.setAttribute('aria-hidden', 'true');
            slide.setAttribute('inert', '');
          }
        });
        if (current) current.textContent = pad(index + 1);

        resetAutoplay();
      }

      function startAutoplay() {
        autoPlayInterval = setInterval(function() {
          show(index + 1);
        }, AUTOPLAY_SPEED);
      }

      function resetAutoplay() {
        clearInterval(autoPlayInterval);
        startAutoplay();
      }

      show(0);

      // Usando querySelectorAll para pegar TODAS as setas (laterais e indicador numérico)
      var prevButtons = root.querySelectorAll('[data-hero-prev]');
      var nextButtons = root.querySelectorAll('[data-hero-next]');

      prevButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) { e.preventDefault(); show(index - 1); });
      });
      nextButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) { e.preventDefault(); show(index + 1); });
      });

      root.addEventListener('keydown', function (event) {
        if (event.key === 'ArrowLeft') { show(index - 1); }
        if (event.key === 'ArrowRight') { show(index + 1); }
      });

      var startX = 0, startY = 0;
      root.addEventListener('touchstart', function (event) {
        startX = event.changedTouches[0].clientX;
        startY = event.changedTouches[0].clientY;
        clearInterval(autoPlayInterval);
      }, { passive: true });

      root.addEventListener('touchend', function (event) {
        var dx = event.changedTouches[0].clientX - startX;
        var dy = event.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          show(dx < 0 ? index + 1 : index - 1);
        } else {
          resetAutoplay();
        }
      }, { passive: true });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "options": [
        { "value": "short", "label": "t:sections.hero.settings.height.options__1.label" },
        { "value": "default", "label": "t:sections.hero.settings.height.options__2.label" },
        { "value": "tall", "label": "t:sections.hero.settings.height.options__3.label" }
      ],
      "default": "default",
      "label": "t:sections.hero.settings.height.label"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.hero.blocks.slide.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.hero.blocks.slide.settings.image.label" },
        { "type": "image_picker", "id": "image_mobile", "label": "t:sections.hero.blocks.slide.settings.image_mobile.label", "info": "t:sections.hero.blocks.slide.settings.image_mobile.info" },
        { "type": "text", "id": "eyebrow", "label": "t:sections.hero.blocks.slide.settings.eyebrow.label" },
        { "type": "textarea", "id": "heading", "label": "t:sections.hero.blocks.slide.settings.heading.label", "info": "t:sections.hero.blocks.slide.settings.heading.info" },
        { "type": "text", "id": "subheading", "label": "t:sections.hero.blocks.slide.settings.subheading.label" },
        { "type": "richtext", "id": "text", "label": "t:sections.hero.blocks.slide.settings.text.label" },
        { "type": "text", "id": "button_label", "label": "t:sections.hero.blocks.slide.settings.button_label.label" },
        { "type": "url", "id": "button_link", "label": "t:sections.hero.blocks.slide.settings.button_link.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}