{%- comment -%}
  ============================================================
  HERO — Premium Slider (Totalmente Configurável & Autoplay)
  ============================================================
{%- endcomment -%}
{%- liquid
  assign slides = section.blocks
  assign slide_count = slides.size
  assign autoplay = section.settings.autoplay
  assign autoplay_speed = section.settings.autoplay_speed | times: 1000
-%}
<div
  class="hero scheme-dark hero--{{ section.settings.height }}"
  data-section-id="{{ section.id }}"
  data-header-overlay
  {% if slide_count > 1 %}
    data-hero-carousel
    data-autoplay="{{ autoplay }}"
    data-speed="{{ autoplay_speed }}"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ shop.name | escape }}"
    tabindex="0"
  {% endif %}
>
  <ul class="hero__slides" role="list">
    {%- for block in slides -%}
      {%- liquid
        if forloop.first
          assign slide_loading = 'eager'
          assign slide_priority = 'high'
        else
          assign slide_loading = 'lazy'
          assign slide_priority = 'auto'
        endif

        assign alignment_class = 'hero__content--' | append: block.settings.text_alignment
      -%}
      <li
        class="hero__slide {% if forloop.first %}is-active{% endif %}"
        data-hero-slide
        {% if slide_count > 1 %}
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} / {{ slide_count }}"
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
        {% endif %}
        {{ block.shopify_attributes }}
        style="
          --overlay-color: {{ block.settings.overlay_color }};
          --overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
        "
      >
        <!-- Imagem do Banner -->
        <div class="hero__media">
          {%- if block.settings.image != blank -%}
            {%- if block.settings.image_mobile != blank -%}
              <picture>
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {{ block.settings.image_mobile | image_url: width: 750 }} 750w,
                    {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w
                  "
                  sizes="100vw"
                >
                {{
                  block.settings.image
                  | image_url: width: 3000
                  | image_tag:
                    loading: slide_loading,
                    fetchpriority: slide_priority,
                    class: 'hero__image',
                    widths: '900, 1200, 1600, 2000, 2600, 3000',
                    sizes: '100vw',
                    alt: block.settings.image.alt | default: block.settings.heading | escape
                }}
              </picture>
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 3000
                | image_tag:
                  loading: slide_loading,
                  fetchpriority: slide_priority,
                  class: 'hero__image',
                  widths: '900, 1200, 1600, 2000, 2600, 3000',
                  sizes: '100vw',
                  alt: block.settings.image.alt | default: block.settings.heading | escape
              }}
            {%- endif -%}
          {%- else -%}
            <div class="hero__image hero__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}

          <!-- Camada de Escurecimento Configurável -->
          <div class="hero__overlay"></div>
        </div>

        <!-- Conteúdo do Banner -->
        <div class="hero__content page-width {{ alignment_class }}">
          <div class="hero__text-container">

            <!-- Eyebrow -->
            {%- if block.settings.eyebrow != blank -%}
              <div class="hero__element hero__element--eyebrow">
                <p class="eyebrow hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>
              </div>
            {%- endif -%}

            <!-- Título -->
            {%- if block.settings.heading != blank -%}
              <div class="hero__element hero__element--heading">
                {%- if forloop.first -%}
                  <h1 class="hero__heading">{{ block.settings.heading | newline_to_br }}</h1>
                {%- else -%}
                  <p class="hero__heading" role="heading" aria-level="2">{{ block.settings.heading | newline_to_br }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

            <!-- Subtítulo -->
            {%- if block.settings.subheading != blank -%}
              <div class="hero__element hero__element--subheading">
                <p class="hero__subheading">{{ block.settings.subheading | escape }}</p>
              </div>
            {%- endif -%}

            <!-- Descrição -->
            {%- if block.settings.text != blank -%}
              <div class="hero__element hero__element--body">
                <div class="hero__body rte">{{ block.settings.text }}</div>
              </div>
            {%- endif -%}

            <!-- Botão CTA -->
            {%- if block.settings.button_label != blank -%}
              <div class="hero__element hero__element--cta">
                <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="button hero__cta">
                  <span>{{ block.settings.button_label | escape }}</span>
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 8px;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            {%- endif -%}

          </div>
        </div>
      </li>
    {%- endfor -%}
  </ul>

  {%- if slide_count > 1 -%}
    <!-- SETAS LATERAIS -->
    {%- if section.settings.show_arrows -%}
      <button type="button" class="hero__arrow hero__arrow--prev tap-target" data-hero-prev aria-label="Slide anterior">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button type="button" class="hero__arrow hero__arrow--next tap-target" data-hero-next aria-label="Próximo slide">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    {%- endif -%}

    <!-- INDICADOR NUMÉRICO -->
    {%- if section.settings.show_indicator -%}
      <div class="hero__indicator">
        <button type="button" class="hero__nav tap-target" data-hero-prev aria-label="Anterior">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </button>
        <p class="hero__counter" aria-live="polite">
          <span class="hero__counter-current" data-hero-current>01</span>
          <span class="hero__counter-divider">/</span>
          <span class="hero__counter-total">{{ slide_count | prepend: '0' | slice: -2, 2 }}</span>
        </p>
        <button type="button" class="hero__nav tap-target" data-hero-next aria-label="Próximo">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </button>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

<style>
  .hero {
    margin-top: calc(-1 * var(--header-height, 70px));
    position: relative;
    background-color: var(--color-background, #000000);
    overflow: hidden;
    width: 100%;
  }

  .hero__slides {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    width: 100%;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .hero__slide {
    flex: 0 0 100%;
    min-width: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-sizing: border-box;
  }

  /* Alturas */
  .hero--short .hero__slide { min-height: clamp(420px, 60vh, 600px); }
  .hero--default .hero__slide { min-height: clamp(520px, 80vh, 850px); }
  .hero--tall .hero__slide { min-height: 100vh; min-height: 100dvh; }

  @media screen and (min-width: 1001px) {
    .hero__slide { justify-content: center; }
  }

  .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface, #121212);
  }

  /* Overlay Configurável via Painel */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--overlay-color, #000000);
    opacity: var(--overlay-opacity, 0.3);
    z-index: 1;
    pointer-events: none;
  }

  /* Conteúdo */
  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    box-sizing: border-box;
    padding-top: calc(var(--header-height, 70px) + max(20px, env(safe-area-inset-top, 0px)));
    padding-bottom: clamp(80px, 12vh, 140px);
  }

  @media screen and (min-width: 1001px) {
    .hero__content {
      padding-top: calc(var(--header-height, 70px) + 40px);
      padding-bottom: 60px;
    }
  }

  /* Alinhamentos */
  .hero__content--left { justify-content: flex-start; text-align: left; }
  .hero__content--center { justify-content: center; text-align: center; }
  .hero__content--right { justify-content: flex-end; text-align: right; }

  .hero__text-container {
    position: relative;
    max-width: min(42rem, 100%);
    width: 100%;
  }

  @media screen and (min-width: 1001px) {
    .hero__text-container { max-width: min(42rem, 52vw); }
  }

  /* Elementos de Texto */
  .hero__element {
    position: relative;
    display: block;
    isolation: isolate;
    max-width: 100%;
  }
  .hero__element--eyebrow { margin-bottom: 14px; }
  .hero__element--heading { margin-bottom: 16px; display: block; width: 100%; }
  .hero__element--subheading { margin-bottom: 16px; }
  .hero__element--body { margin-bottom: 28px; }

  .hero__content--left .hero__element--cta { margin-top: 8px; display: inline-flex; width: auto; align-items: center; }
  .hero__content--center .hero__element--cta { margin-top: 8px; display: flex; width: auto; justify-content: center; }
  .hero__content--right .hero__element--cta { margin-top: 8px; display: flex; width: auto; justify-content: flex-end; }

  /* Animações */
  .js .hero__slide .hero__element { opacity: 0; }
  .js .hero__slide.is-active .hero__element {
    animation: heroEntrada var(--dur-reveal, 560ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
    animation-delay: calc(var(--hero-i, 0) * 70ms);
  }
  .hero__element--eyebrow { --hero-i: 0; }
  .hero__element--heading { --hero-i: 1; }
  .hero__element--subheading { --hero-i: 2; }
  .hero__element--body { --hero-i: 3; }
  .hero__element--cta { --hero-i: 4; }

  @keyframes heroEntrada {
    from { opacity: 0; transform: translate3d(0, 14px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  .hero__slide.is-active .hero__image {
    animation: heroFoto 1200ms var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
  }
  @keyframes heroFoto {
    from { transform: scale(1.04); }
    to { transform: scale(1); }
  }

  /* Tipografia */
  .hero__heading {
    font-size: clamp(2.4rem, 8.5vw, 6.8rem);
    line-height: 0.98;
    margin: 0;
    color: var(--color-text-primary, #ffffff);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
    text-wrap: balance;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .hero__subheading {
    font-family: var(--font-ui-family, inherit);
    font-size: clamp(0.875rem, 0.8rem + 0.4vw, 1.0625rem);
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: var(--tracking-label, 0.05em);
    text-transform: uppercase;
    color: var(--color-text-primary, #ffffff);
    margin: 0;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
  }

  .hero__eyebrow {
    margin: 0;
    font-size: var(--f0);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    color: #ffffff;
  }

  .hero__body {
    font-size: clamp(0.9375rem, 0.9rem + 0.25vw, 1.0625rem);
    line-height: 1.55;
    color: var(--color-text-secondary, rgba(255, 255, 255, 0.88));
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
  }
  .hero__content--center .hero__body { margin-left: auto; margin-right: auto; max-width: 42ch; }
  .hero__body p { margin: 0 0 6px; }

  /* Botão CTA */
  .hero__cta {
    position: relative;
    z-index: 1;
    min-width: 180px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    transition:
      transform var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .hero__cta:hover {
    transform: translateY(-1px);
    background-color: var(--color-button-primary-background-hover);
    border-color: var(--color-button-primary-background-hover);
    color: var(--color-button-primary-text-hover);
  }
  .hero__cta:active { transform: translateY(0); }

  /* Setas Laterais */
  .hero__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: rgba(255, 255, 255, 0.15);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  /* O blur ficou so onde ha mouse: no celular a seta esta por cima de
     uma foto que escala e desliza, e cada frame do carrossel obrigaria
     o navegador a refazer o desfoque do que passa atras dela. */
  @media (hover: hover) {
    .hero__arrow { backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
  }
  .hero__arrow:hover {
    background-color: rgba(255, 255, 255, 0.3);
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-50%) scale(1.05);
  }
  .hero__arrow svg { width: 24px; height: 24px; }
  .hero__arrow--prev { left: 24px; }
  .hero__arrow--next { right: 24px; }

  @media screen and (max-width: 749px) {
    .hero__arrow { width: 40px; height: 40px; }
    .hero__arrow svg { width: 20px; height: 20px; }
    .hero__arrow--prev { left: 16px; }
    .hero__arrow--next { right: 16px; }
  }

  /* Indicador */
  .hero__indicator {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hero__counter {
    display: flex; align-items: center; gap: 4px;
    font-family: var(--font-ui-family, inherit); font-size: var(--f1, 1.2rem); font-weight: 500;
    letter-spacing: var(--tracking-label, 0.05em); color: #ffffff; margin: 0;
  }
  .hero__counter-divider { opacity: 0.5; }
  .hero__counter-total { color: rgba(255, 255, 255, 0.6); }
  .hero__nav {
    display: inline-flex; align-items: center; justify-content: center;
    background: none; border: none; color: rgba(255, 255, 255, 0.8);
    cursor: pointer; padding: 8px; opacity: 0.8; transition: opacity 200ms ease, color 200ms ease;
  }
  .hero__nav:hover, .hero__nav:focus-visible { opacity: 1; color: #ffffff; }

  @media screen and (min-width: 750px) {
    .hero__indicator { right: var(--page-gutter, 24px); bottom: clamp(40px, 8vh, 80px); flex-direction: column; gap: 6px; }
    .hero__counter { flex-direction: column; gap: 6px; }
    .hero__counter-divider { display: none; }
    .hero__counter-total::before {
      content: ''; display: block; width: 1px; height: 24px;
      margin: 0 auto 6px; background-color: rgba(255, 255, 255, 0.25);
    }
    .hero__indicator [data-hero-prev] svg { transform: rotate(90deg); }
    .hero__indicator [data-hero-next] svg { transform: rotate(90deg); }
  }

  @media screen and (max-width: 749px) {
    .hero__element--cta { width: 100%; }
    .hero__cta { width: 100%; justify-content: center; }
    .hero__indicator {
      bottom: max(16px, env(safe-area-inset-bottom, 16px)); right: var(--page-gutter, 16px);
      left: auto; background-color: rgba(0, 0, 0, 0.55); padding: 4px 8px; border-radius: var(--radius-pill);
      border: 1px solid rgba(255, 255, 255, 0.15);
    }
  }

  /* ==========================================================
     CELULAR DEITADO — a orientacao que o hero nao previa
     ==========================================================
     O titulo e dimensionado por LARGURA (8.5vw). Deitado, um celular
     tem 844px de largura e 390px de altura: a conta devolvia um
     titulo de ~72px dentro de uma tela de 390px de alto, somado a
     ~160px de padding vertical fixo. O slide crescia e a "tela
     cheia" virava uma tela e meia de rolagem so para passar do hero.

     Aqui a tipografia passa a considerar a ALTURA disponivel e o
     respiro vertical encolhe. O texto de apoio sai — em 390px de
     altura ele e a primeira coisa que sobra. */
  @media (orientation: landscape) and (max-height: 540px) {
    .hero__content {
      padding-top: calc(var(--header-height) + max(12px, env(safe-area-inset-top, 0px)));
      padding-bottom: clamp(28px, 7vh, 48px);
    }
    .hero__heading { font-size: clamp(1.75rem, 4.6vw, 3.25rem); }
    .hero__element--eyebrow { margin-bottom: 8px; }
    .hero__element--heading { margin-bottom: 10px; }
    .hero__element--subheading { margin-bottom: 10px; }
    .hero__body { display: none; }
    /* Deitado ha largura de sobra: o CTA volta a ter a largura do
       proprio rotulo em vez de atravessar a tela inteira. */
    .hero__element--cta { width: auto; }
    .hero__cta { width: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .hero__slide .hero__element { opacity: 1; }
    .js .hero__slide.is-active .hero__element, .hero__slide.is-active .hero__image { animation: none; }
    .hero__slide { transition-duration: 0.01ms !important; }
  }
</style>

{%- if slide_count > 1 -%}
  <script>
    (function () {
      var root = document.querySelector('[data-hero-carousel][data-section-id="{{ section.id }}"]');
      if (!root) return;

      var sliderContainer = root.querySelector('.hero__slides');
      var slides = Array.prototype.slice.call(root.querySelectorAll('[data-hero-slide]'));
      var current = root.querySelector('[data-hero-current]');
      var index = 0;
      var autoPlayInterval;

      // Lê as configurações do painel a partir dos atributos data
      var isAutoplay = root.getAttribute('data-autoplay') === 'true';
      var autoplaySpeed = parseInt(root.getAttribute('data-speed'), 10) || 5000;

      function pad(n) { return (n < 10 ? '0' : '') + n; }

      function show(next) {
        index = (next + slides.length) % slides.length;
        sliderContainer.style.transform = 'translateX(-' + (index * 100) + '%)';

        slides.forEach(function (slide, i) {
          var active = i === index;
          if (active) {
            slide.classList.add('is-active');
            slide.removeAttribute('aria-hidden');
            slide.removeAttribute('inert');
          } else {
            slide.classList.remove('is-active');
            slide.setAttribute('aria-hidden', 'true');
            slide.setAttribute('inert', '');
          }
        });
        if (current) current.textContent = pad(index + 1);
        resetAutoplay();
      }

      function startAutoplay() {
        if (!isAutoplay) return;
        autoPlayInterval = setInterval(function() { show(index + 1); }, autoplaySpeed);
      }

      function resetAutoplay() {
        if (!isAutoplay) return;
        clearInterval(autoPlayInterval);
        startAutoplay();
      }

      show(0);

      var prevButtons = root.querySelectorAll('[data-hero-prev]');
      var nextButtons = root.querySelectorAll('[data-hero-next]');

      prevButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) { e.preventDefault(); show(index - 1); });
      });
      nextButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) { e.preventDefault(); show(index + 1); });
      });

      root.addEventListener('keydown', function (event) {
        if (event.key === 'ArrowLeft') show(index - 1);
        if (event.key === 'ArrowRight') show(index + 1);
      });

      var startX = 0, startY = 0;
      root.addEventListener('touchstart', function (event) {
        startX = event.changedTouches[0].clientX;
        startY = event.changedTouches[0].clientY;
        clearInterval(autoPlayInterval);
      }, { passive: true });

      root.addEventListener('touchend', function (event) {
        var dx = event.changedTouches[0].clientX - startX;
        var dy = event.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          show(dx < 0 ? index + 1 : index - 1);
        } else {
          resetAutoplay();
        }
      }, { passive: true });

      // Integração Profissional com o Editor da Shopify
      if (Shopify.designMode) {
        document.addEventListener('shopify:block:select', function(event) {
          if (event.detail.sectionId !== '{{ section.id }}') return;
          clearInterval(autoPlayInterval); // Pausa autoplay ao editar
          var selectedSlide = slides.find(s => s.dataset.shopifyEditorBlock === JSON.stringify({id: event.detail.blockId}));
          if (selectedSlide) {
            show(slides.indexOf(selectedSlide));
          }
        });
        document.addEventListener('shopify:block:deselect', function(event) {
          if (event.detail.sectionId !== '{{ section.id }}') return;
          resetAutoplay();
        });
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Slider Premium",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Dimensões do Slider"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        { "value": "short", "label": "Pequeno (Min. 420px)" },
        { "value": "default", "label": "Padrão (Min. 520px)" },
        { "value": "tall", "label": "Tela Cheia (100vh)" }
      ],
      "default": "default",
      "label": "Altura do Banner"
    },
    {
      "type": "header",
      "content": "Configurações de Transição"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Ativar rotação automática",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
