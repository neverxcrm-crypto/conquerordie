{%- comment -%}
  ============================================================
  HERO — abertura editorial da home
  ============================================================
{%- endcomment -%}
{%- liquid
  assign slides = section.blocks
  assign slide_count = slides.size
-%}
<div
  class="hero scheme-dark hero--{{ section.settings.height }}"
  data-section-id="{{ section.id }}"
  {%- comment -%} A header fica transparente sobre esta section (ver nav.liquid). {%- endcomment -%}
  data-header-overlay
  {% if slide_count > 1 %}data-hero-carousel role="region" aria-roledescription="carousel" aria-label="{{ shop.name | escape }}" tabindex="0"{% endif %}
>
  <ul class="hero__slides" role="list">
    {%- for block in slides -%}
      <li
        class="hero__slide {% if forloop.first %}is-active{% endif %}"
        data-hero-slide
        {% if slide_count > 1 %}
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} / {{ slide_count }}"
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {%- liquid
          if forloop.first
            assign slide_loading = 'eager'
            assign slide_priority = 'high'
          else
            assign slide_loading = 'lazy'
            assign slide_priority = 'auto'
          endif
        -%}

        <!-- Imagem do Banner -->
        <div class="hero__media">
          {%- if block.settings.image != blank -%}
            {%- if block.settings.image_mobile != blank -%}
              <picture>
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {{ block.settings.image_mobile | image_url: width: 750 }} 750w,
                    {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w
                  "
                  sizes="100vw"
                >
                {{
                  block.settings.image
                  | image_url: width: 3000
                  | image_tag:
                    loading: slide_loading,
                    fetchpriority: slide_priority,
                    class: 'hero__image',
                    widths: '900, 1200, 1600, 2000, 2600, 3000',
                    sizes: '100vw',
                    alt: block.settings.image.alt | default: block.settings.heading | escape
                }}
              </picture>
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 3000
                | image_tag:
                  loading: slide_loading,
                  fetchpriority: slide_priority,
                  class: 'hero__image',
                  widths: '900, 1200, 1600, 2000, 2600, 3000',
                  sizes: '100vw',
                  alt: block.settings.image.alt | default: block.settings.heading | escape
              }}
            {%- endif -%}
          {%- else -%}
            <div class="hero__image hero__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        <!-- Conteúdo do Banner -->
        <div class="hero__content page-width">
          <div class="hero__text-container">
            
            <!-- Eyebrow -->
            {%- if block.settings.eyebrow != blank -%}
              <div class="hero__element hero__element--eyebrow">
                <p class="eyebrow hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>
              </div>
            {%- endif -%}

            <!-- Título com Degradê/Sombra Dedicada -->
            {%- if block.settings.heading != blank -%}
              <div class="hero__element hero__element--heading">
                <div class="hero__heading-shadow" aria-hidden="true"></div>
                {%- if forloop.first -%}
                  <h1 class="hero__heading">{{ block.settings.heading | newline_to_br }}</h1>
                {%- else -%}
                  <p class="hero__heading" role="heading" aria-level="2">{{ block.settings.heading | newline_to_br }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

            <!-- Subtítulo -->
            {%- if block.settings.subheading != blank -%}
              <div class="hero__element hero__element--subheading">
                <p class="hero__subheading">{{ block.settings.subheading | escape }}</p>
              </div>
            {%- endif -%}

            <!-- Descrição -->
            {%- if block.settings.text != blank -%}
              <div class="hero__element hero__element--body">
                <div class="hero__body rte">{{ block.settings.text }}</div>
              </div>
            {%- endif -%}

            <!-- Botão com Degradê/Sombra Dedicada -->
            {%- if block.settings.button_label != blank -%}
              <div class="hero__element hero__element--cta">
                <div class="hero__cta-shadow" aria-hidden="true"></div>
                <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="button hero__cta">
                  <span>{{ block.settings.button_label | escape }}</span>
                  {% render 'icon', name: 'arrow-right' %}
                </a>
              </div>
            {%- endif -%}

          </div>
        </div>
      </li>
    {%- endfor -%}
  </ul>

  {%- if slide_count > 1 -%}
    <div class="hero__indicator">
      <button type="button" class="hero__nav tap-target" data-hero-prev aria-label="{{ 'general.slider.previous' | t }}">
        {% render 'icon', name: 'arrow-right' %}
      </button>
      <p class="hero__counter" aria-live="polite">
        <span class="hero__counter-current" data-hero-current>01</span>
        <span class="hero__counter-total">{{ slide_count | prepend: '0' | slice: -2, 2 }}</span>
      </p>
      <button type="button" class="hero__nav tap-target" data-hero-next aria-label="{{ 'general.slider.next' | t }}">
        {% render 'icon', name: 'arrow-right' %}
      </button>
    </div>
  {%- endif -%}
</div>

<style>
  .hero {
    margin-top: calc(-1 * var(--header-height, 70px));
    position: relative;
    background-color: var(--color-background, #000000);
    overflow: hidden;
  }
  .hero__slides { list-style: none; margin: 0; padding: 0; display: grid; }
  
  .hero__slide {
    grid-area: 1 / 1;
    position: relative;
    display: flex;
    align-items: flex-end;
    opacity: 0;
    visibility: hidden;
    transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1), visibility 600ms;
  }

  .hero--short .hero__slide { min-height: 60vh; }
  .hero--default .hero__slide { min-height: 80vh; }
  .hero--tall .hero__slide { min-height: 100vh; min-height: 100dvh; }

  @media screen and (min-width: 1001px) {
    .hero__slide { align-items: center; }
  }
  .hero__slide.is-active { opacity: 1; visibility: visible; }

  /* Mídia */
  .hero__media { position: absolute; inset: 0; }
  .hero__image { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero__placeholder { display: flex; align-items: center; justify-content: center; background-color: var(--color-surface, #121212); }

  /* Degradê Geral Lateral */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      var(--photo-veil-bottom, linear-gradient(to top, rgba(0, 0, 0, 0.82), transparent 70%)),
      var(--photo-veil-side, linear-gradient(to right, rgba(0, 0, 0, 0.76) 0%, rgba(0, 0, 0, 0.2) 50%, rgba(0, 0, 0, 0) 100%));
    pointer-events: none;
  }

  /* Container do Conteúdo */
  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-bottom: clamp(72px, 11vh, 148px);
  }
  @media screen and (min-width: 1001px) {
    .hero__content { padding-bottom: 0; }
  }

  .hero__text-container {
    position: relative;
    max-width: min(42rem, 52vw);
    width: 100%;
  }

  /* Elementos Individuais */
  .hero__element { position: relative; display: block; isolation: isolate; }
  .hero__element--eyebrow { margin-bottom: 20px; }
  .hero__element--heading { margin-bottom: 20px; display: inline-block; width: 100%; }
  .hero__element--subheading { margin-bottom: 20px; }
  .hero__element--body { margin-bottom: 32px; }
  .hero__element--cta { margin-top: 8px; display: inline-block; }

  /* ==========================================================
     ENTRADA DO HERO — a coreografia da primeira impressão
     ==========================================================
     Os elementos entram na ordem em que se lê: eyebrow, título,
     subtítulo, texto, botão. Cada um sobe 14px e aparece, 70ms
     depois do anterior. A sequência inteira termina em menos de
     0,9s — tempo de uma frase, não de uma abertura de filme.

     POR QUE CSS E NÃO JS:
     a animação começa no primeiro paint, sem esperar script
     nenhum baixar, e o navegador pode rodá-la no compositor. É
     também o que permite que ela se repita na troca de slides de
     graça: quem liga é a classe .is-active, que o carrossel já
     coloca.

     POR QUE animation E NÃO transition:
     transition precisa de um estado inicial pintado e uma troca
     depois; no primeiro paint não há troca nenhuma. A animação
     com fill: both cobre os dois casos com uma regra só.

     SEM JS a regra não existe (depende de .js): o texto nasce
     visível. E o título continua legível para o LCP — o atraso
     máximo antes dele é de 70ms.
     ========================================================== */
  .js .hero__slide .hero__element {
    opacity: 0;
  }
  .js .hero__slide.is-active .hero__element {
    animation: heroEntrada var(--dur-reveal, 560ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
    animation-delay: calc(var(--hero-i, 0) * 70ms);
  }
  .hero__element--eyebrow { --hero-i: 0; }
  .hero__element--heading { --hero-i: 1; }
  .hero__element--subheading { --hero-i: 2; }
  .hero__element--body { --hero-i: 3; }
  .hero__element--cta { --hero-i: 4; }

  @keyframes heroEntrada {
    from { opacity: 0; transform: translate3d(0, 14px, 0); }
    to { opacity: 1; transform: none; }
  }

  /* A foto assenta junto com o texto: começa 4% maior e volta ao
     tamanho real. É transform puro (a GPU resolve sem repintar) e
     acontece UMA vez, na entrada do slide.

     Vale em QUALQUER aparelho. Antes era exclusiva do
     html.motion-full, e o resultado é que a mesma loja abria com
     personalidade num computador e sem nenhuma num outro — sem que
     o segundo ganhasse nada de verdade: é uma única camada já
     composta, animada uma vez, que não repinta pixel nenhum e não
     atrasa o LCP (transform não muda o momento da pintura).

     O que continua restrito ao motion-full é o que custa POR FRAME:
     rolagem suavizada e parallax. */
  .hero__slide.is-active .hero__image {
    animation: heroFoto 1200ms var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
  }
  @keyframes heroFoto {
    from { transform: scale(1.04); }
    to { transform: none; }
  }

  /* ==========================================================
     DEGRADÊS/SOMBRAS ATRÁS DO TEXTO — sem filter: blur()
     ==========================================================
     Os dois halos abaixo usavam radial-gradient + filter: blur().
     Era o efeito mais caro que sobrava no tema, e no pior lugar
     possivel: o hero e a primeira coisa pintada, ocupa a tela toda
     e e quase sempre o elemento de LCP da home.

     filter: blur() nao e um degrade — e um passe de pos-processo:
     o navegador precisa renderizar a camada num buffer separado,
     desfocar esse buffer e so entao compor o resultado. Isso se
     repete a cada repintura da area: na troca de slides, ao girar
     o aparelho, ao voltar para a aba.

     E o que ele estava desfocando ja era suave — um degrade radial.
     Entao a maciez foi passada para o proprio degrade: mais paradas
     de cor, desenhando a mesma queda de luz que o blur produzia. O
     'closest-side' faz o preto chegar a zero exatamente na borda da
     caixa, sem o corte seco que o border-radius deixava e que o
     blur existia, em boa parte, para disfarcar.

     Resultado: mesma sombra suave, pintada de uma vez pelo mesmo
     caminho de um fundo comum — sem buffer, sem passe de blur.
     ========================================================== */

  /* DEGRADÊ/SOMBRA EXCLUSIVA ATRÁS DOS TÍTULOS */
  .hero__heading-shadow {
    position: absolute;
    inset: -44px -58px;
    background: radial-gradient(
      ellipse closest-side at center,
      rgba(0, 0, 0, 0.95) 0%,
      rgba(0, 0, 0, 0.91) 18%,
      rgba(0, 0, 0, 0.8) 34%,
      rgba(0, 0, 0, 0.62) 49%,
      rgba(0, 0, 0, 0.4) 63%,
      rgba(0, 0, 0, 0.21) 76%,
      rgba(0, 0, 0, 0.08) 88%,
      rgba(0, 0, 0, 0) 100%
    );
    z-index: -1;
    pointer-events: none;
  }

  /* DEGRADÊ/SOMBRA EXCLUSIVA ATRÁS DO BOTÃO */
  .hero__cta-shadow {
    position: absolute;
    inset: -30px -42px;
    background: radial-gradient(
      ellipse closest-side at center,
      rgba(0, 0, 0, 0.95) 0%,
      rgba(0, 0, 0, 0.88) 22%,
      rgba(0, 0, 0, 0.72) 40%,
      rgba(0, 0, 0, 0.5) 56%,
      rgba(0, 0, 0, 0.28) 71%,
      rgba(0, 0, 0, 0.11) 85%,
      rgba(0, 0, 0, 0) 100%
    );
    z-index: -1;
    pointer-events: none;
  }

  /* Tipografia */
  .hero__heading {
    max-width: 9ch;
    font-size: clamp(3.2rem, 7.5vw, 7.2rem);
    line-height: 0.9;
    margin: 0;
    color: var(--color-text-primary, #ffffff);
    text-shadow: 0 4px 16px rgba(0, 0, 0, 0.9);
    text-wrap: balance;
  }
  .hero__subheading {
    font-family: var(--font-ui-family);
    font-size: var(--f2);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-primary, #ffffff);
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }
  .hero__eyebrow {
    margin: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }
  .hero__body {
    font-size: var(--f2);
    color: var(--color-text-secondary, rgba(255, 255, 255, 0.85));
    max-width: 34ch;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }
  .hero__body p { margin: 0 0 4px; }

  /* Botão CTA com Hover em Branco Puro */
  .hero__cta {
    position: relative;
    z-index: 1;
    min-width: 180px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
    transition: transform 250ms ease, background-color 250ms ease, border-color 250ms ease, color 250ms ease;
  }

  .hero__cta svg {
    transition: transform 250ms ease, stroke 250ms ease, fill 250ms ease, color 250ms ease;
  }

  .hero__cta:hover {
    transform: translateY(-2px);
    background-color: transparent !important;
    border-color: #ffffff !important;
    color: #ffffff !important;
  }

  .hero__cta:hover span,
  .hero__cta:hover svg {
    color: #ffffff !important;
    stroke: #ffffff !important;
    fill: #ffffff !important;
  }

  /* Indicador */
  .hero__indicator {
    position: absolute;
    right: var(--page-gutter, 20px);
    bottom: clamp(72px, 11vh, 148px);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .hero__counter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-family: var(--font-ui-family);
    font-size: var(--f1);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-primary, #ffffff);
    margin: 0;
  }
  .hero__counter-total { color: var(--color-text-muted, rgba(255, 255, 255, 0.5)); }
  .hero__counter-total::before {
    content: '';
    display: block;
    width: 1px;
    height: 28px;
    margin: 0 auto 6px;
    background-color: var(--color-border-strong, rgba(255, 255, 255, 0.2));
  }
  .hero__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--color-text-secondary, rgba(255, 255, 255, 0.7));
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 200ms ease, color 200ms ease;
  }
  .hero__nav:hover, .hero__nav:focus-visible { opacity: 1; color: var(--color-text-primary, #ffffff); }
  .hero__nav svg { width: 14px; height: 14px; }
  [data-hero-prev] svg { transform: rotate(-90deg); }
  [data-hero-next] svg { transform: rotate(90deg); }

  @media screen and (max-width: 749px) {
    .hero--short .hero__slide { min-height: 50vh; }
    .hero--default .hero__slide { min-height: 70vh; }
    .hero--tall .hero__slide { min-height: 100vh; min-height: 100dvh; }

    .hero__heading { max-width: 10ch; font-size: clamp(3rem, 16vw, 5rem); }
    .hero__heading-shadow { inset: -20px -20px; }
    .hero__cta-shadow { inset: -15px -20px; }
    .hero__text-container { max-width: 100%; }
    .hero__body { max-width: 100%; }
    .hero__element--cta { width: 100%; }
    .hero__cta { width: 100%; }
    .hero__indicator {
      flex-direction: row;
      bottom: max(20px, env(safe-area-inset-bottom, 0px));
      right: var(--page-gutter, 20px);
    }
    .hero__counter { flex-direction: row; gap: 4px; }
    .hero__counter-total::before { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .hero__slide .hero__element { opacity: 1; }
    .js .hero__slide.is-active .hero__element,
    .hero__slide.is-active .hero__image { animation: none; }
    .hero__slide { transition-duration: 0.01ms !important; }
  }
</style>

{%- if slide_count > 1 -%}
  <script>
    (function () {
      var root = document.querySelector('[data-hero-carousel][data-section-id="{{ section.id }}"]');
      if (!root) return;

      var slides = Array.prototype.slice.call(root.querySelectorAll('[data-hero-slide]'));
      var current = root.querySelector('[data-hero-current]');
      var index = 0;

      function pad(n) { return (n < 10 ? '0' : '') + n; }

      function show(next) {
        index = (next + slides.length) % slides.length;
        slides.forEach(function (slide, i) {
          var active = i === index;
          slide.classList.toggle('is-active', active);
          if (active) {
            slide.removeAttribute('aria-hidden');
            slide.removeAttribute('inert');
          } else {
            slide.setAttribute('aria-hidden', 'true');
            slide.setAttribute('inert', '');
          }
        });
        if (current) current.textContent = pad(index + 1);
      }

      show(0);

      var prev = root.querySelector('[data-hero-prev]');
      var next = root.querySelector('[data-hero-next]');
      if (prev) prev.addEventListener('click', function () { show(index - 1); });
      if (next) next.addEventListener('click', function () { show(index + 1); });

      root.addEventListener('keydown', function (event) {
        if (event.key === 'ArrowLeft') { show(index - 1); }
        if (event.key === 'ArrowRight') { show(index + 1); }
      });

      var startX = 0;
      var startY = 0;
      root.addEventListener('touchstart', function (event) {
        startX = event.changedTouches[0].clientX;
        startY = event.changedTouches[0].clientY;
      }, { passive: true });
      root.addEventListener('touchend', function (event) {
        var dx = event.changedTouches[0].clientX - startX;
        var dy = event.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy)) {
          show(dx < 0 ? index + 1 : index - 1);
        }
      }, { passive: true });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "options": [
        { "value": "short", "label": "t:sections.hero.settings.height.options__1.label" },
        { "value": "default", "label": "t:sections.hero.settings.height.options__2.label" },
        { "value": "tall", "label": "t:sections.hero.settings.height.options__3.label" }
      ],
      "default": "default",
      "label": "t:sections.hero.settings.height.label"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.hero.blocks.slide.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.hero.blocks.slide.settings.image.label" },
        { "type": "image_picker", "id": "image_mobile", "label": "t:sections.hero.blocks.slide.settings.image_mobile.label", "info": "t:sections.hero.blocks.slide.settings.image_mobile.info" },
        { "type": "text", "id": "eyebrow", "label": "t:sections.hero.blocks.slide.settings.eyebrow.label" },
        { "type": "textarea", "id": "heading", "label": "t:sections.hero.blocks.slide.settings.heading.label", "info": "t:sections.hero.blocks.slide.settings.heading.info" },
        { "type": "text", "id": "subheading", "label": "t:sections.hero.blocks.slide.settings.subheading.label" },
        { "type": "richtext", "id": "text", "label": "t:sections.hero.blocks.slide.settings.text.label" },
        { "type": "text", "id": "button_label", "label": "t:sections.hero.blocks.slide.settings.button_label.label" },
        { "type": "url", "id": "button_link", "label": "t:sections.hero.blocks.slide.settings.button_link.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}