{%- comment -%}
  ============================================================
  HERO — abertura editorial da home (Versão Otimizada)
  ============================================================
{%- endcomment -%}
{%- liquid
  assign slides = section.blocks
  assign slide_count = slides.size
-%}
<div
  class="hero scheme-dark hero--{{ section.settings.height }}"
  data-section-id="{{ section.id }}"
  data-header-overlay
  {% if slide_count > 1 %}data-hero-carousel role="region" aria-roledescription="carousel" aria-label="{{ shop.name | escape }}" tabindex="0"{% endif %}
>
  <ul class="hero__slides" role="list">
    {%- for block in slides -%}
      <li
        class="hero__slide {% if forloop.first %}is-active{% endif %}"
        data-hero-slide
        {% if slide_count > 1 %}
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} / {{ slide_count }}"
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {%- liquid
          if forloop.first
            assign slide_loading = 'eager'
            assign slide_priority = 'high'
          else
            assign slide_loading = 'lazy'
            assign slide_priority = 'auto'
          endif
        -%}

        <!-- Imagem do Banner -->
        <div class="hero__media">
          {%- if block.settings.image != blank -%}
            {%- if block.settings.image_mobile != blank -%}
              <picture>
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {{ block.settings.image_mobile | image_url: width: 750 }} 750w,
                    {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w
                  "
                  sizes="100vw"
                >
                {{
                  block.settings.image
                  | image_url: width: 3000
                  | image_tag:
                    loading: slide_loading,
                    fetchpriority: slide_priority,
                    class: 'hero__image',
                    widths: '900, 1200, 1600, 2000, 2600, 3000',
                    sizes: '100vw',
                    alt: block.settings.image.alt | default: block.settings.heading | escape
                }}
              </picture>
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 3000
                | image_tag:
                  loading: slide_loading,
                  fetchpriority: slide_priority,
                  class: 'hero__image',
                  widths: '900, 1200, 1600, 2000, 2600, 3000',
                  sizes: '100vw',
                  alt: block.settings.image.alt | default: block.settings.heading | escape
              }}
            {%- endif -%}
          {%- else -%}
            <div class="hero__image hero__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        <!-- Conteúdo do Banner -->
        <div class="hero__content page-width">
          <div class="hero__text-container">
            
            <!-- Eyebrow -->
            {%- if block.settings.eyebrow != blank -%}
              <div class="hero__element hero__element--eyebrow">
                <p class="eyebrow hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>
              </div>
            {%- endif -%}

            <!-- Título -->
            {%- if block.settings.heading != blank -%}
              <div class="hero__element hero__element--heading">
                {%- if forloop.first -%}
                  <h1 class="hero__heading">{{ block.settings.heading | newline_to_br }}</h1>
                {%- else -%}
                  <p class="hero__heading" role="heading" aria-level="2">{{ block.settings.heading | newline_to_br }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

            <!-- Subtítulo -->
            {%- if block.settings.subheading != blank -%}
              <div class="hero__element hero__element--subheading">
                <p class="hero__subheading">{{ block.settings.subheading | escape }}</p>
              </div>
            {%- endif -%}

            <!-- Descrição -->
            {%- if block.settings.text != blank -%}
              <div class="hero__element hero__element--body">
                <div class="hero__body rte">{{ block.settings.text }}</div>
              </div>
            {%- endif -%}

            <!-- Botão CTA -->
            {%- if block.settings.button_label != blank -%}
              <div class="hero__element hero__element--cta">
                <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="button hero__cta">
                  <span>{{ block.settings.button_label | escape }}</span>
                  {% render 'icon', name: 'arrow-right' %}
                </a>
              </div>
            {%- endif -%}

          </div>
        </div>
      </li>
    {%- endfor -%}
  </ul>

  {%- if slide_count > 1 -%}
    <div class="hero__indicator">
      <button type="button" class="hero__nav tap-target" data-hero-prev aria-label="{{ 'general.slider.previous' | t | default: 'Anterior' }}">
        {% render 'icon', name: 'arrow-right' %}
      </button>
      <p class="hero__counter" aria-live="polite">
        <span class="hero__counter-current" data-hero-current>01</span>
        <span class="hero__counter-divider">/</span>
        <span class="hero__counter-total">{{ slide_count | prepend: '0' | slice: -2, 2 }}</span>
      </p>
      <button type="button" class="hero__nav tap-target" data-hero-next aria-label="{{ 'general.slider.next' | t | default: 'Próximo' }}">
        {% render 'icon', name: 'arrow-right' %}
      </button>
    </div>
  {%- endif -%}
</div>

<style>
  .hero {
    margin-top: calc(-1 * var(--header-height, 70px));
    position: relative;
    background-color: var(--color-background, #000000);
    overflow: hidden;
    width: 100%;
  }
  
  .hero__slides { 
    list-style: none; 
    margin: 0; 
    padding: 0; 
    display: grid;
    width: 100%;
  }
  
  .hero__slide {
    grid-area: 1 / 1;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    opacity: 0;
    visibility: hidden;
    transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1), visibility 600ms;
    width: 100%;
    box-sizing: border-box;
  }

  /* Alturas Dinâmicas Responsivas */
  .hero--short .hero__slide { min-height: clamp(420px, 60vh, 600px); }
  .hero--default .hero__slide { min-height: clamp(520px, 80vh, 850px); }
  .hero--tall .hero__slide { min-height: 100vh; min-height: 100dvh; }

  @media screen and (min-width: 1001px) {
    .hero__slide { justify-content: center; }
  }
  
  .hero__slide.is-active { opacity: 1; visibility: visible; }

  /* Mídia */
  .hero__media { 
    position: absolute; 
    inset: 0; 
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  
  .hero__image { 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
    display: block; 
  }
  
  .hero__placeholder { 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    background-color: var(--color-surface, #121212); 
  }

  /* Gradiente e Máscara */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      var(--photo-veil-bottom, linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 40%, transparent 80%)),
      var(--photo-veil-side, linear-gradient(to right, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.25) 50%, transparent 100%));
    pointer-events: none;
  }

  /* Container do Conteúdo com desvio do Header */
  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    box-sizing: border-box;
    padding-top: calc(var(--header-height, 70px) + max(20px, env(safe-area-inset-top, 0px)));
    padding-bottom: clamp(80px, 12vh, 140px);
  }
  
  @media screen and (min-width: 1001px) {
    .hero__content { 
      padding-top: calc(var(--header-height, 70px) + 40px); 
      padding-bottom: 60px; 
    }
  }

  .hero__text-container {
    position: relative;
    max-width: min(42rem, 100%);
    width: 100%;
  }

  @media screen and (min-width: 1001px) {
    .hero__text-container {
      max-width: min(42rem, 52vw);
    }
  }

  /* Elementos Individuais */
  .hero__element { 
    position: relative; 
    display: block; 
    isolation: isolate; 
    max-width: 100%;
  }
  .hero__element--eyebrow { margin-bottom: 14px; }
  .hero__element--heading { margin-bottom: 16px; display: block; width: 100%; }
  .hero__element--subheading { margin-bottom: 16px; }
  .hero__element--body { margin-bottom: 28px; }
  .hero__element--cta { margin-top: 8px; display: inline-block; width: auto; }

  /* Animações de Entrada */
  .js .hero__slide .hero__element {
    opacity: 0;
  }
  .js .hero__slide.is-active .hero__element {
    animation: heroEntrada var(--dur-reveal, 560ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
    animation-delay: calc(var(--hero-i, 0) * 70ms);
  }
  .hero__element--eyebrow { --hero-i: 0; }
  .hero__element--heading { --hero-i: 1; }
  .hero__element--subheading { --hero-i: 2; }
  .hero__element--body { --hero-i: 3; }
  .hero__element--cta { --hero-i: 4; }

  @keyframes heroEntrada {
    from { opacity: 0; transform: translate3d(0, 14px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  .hero__slide.is-active .hero__image {
    animation: heroFoto 1200ms var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
  }
  @keyframes heroFoto {
    from { transform: scale(1.04); }
    to { transform: scale(1); }
  }

  /* ==========================================================
     LEGIBILIDADE SOBRE A FOTO — uma camada, nao quatro
     ==========================================================
     Antes o texto era protegido por QUATRO escurecimentos
     empilhados: os dois veus do .hero__media::after, um
     text-shadow forte e ainda duas manchas radiais pretas
     (.hero__heading-shadow / .hero__cta-shadow) desenhadas atras
     do titulo e do botao.

     Somados, transformavam o centro da foto num borrao preto: a
     campanha que o lojista subiu desaparecia justamente onde a
     pessoa olha. E as manchas eram visiveis como borroes ovais
     assim que a foto tinha qualquer area clara.

     Fica UMA camada, a do .hero__media::after, e um text-shadow
     curto o bastante para segurar o contraste numa foto ruim sem
     empastar a tipografia. A foto volta a aparecer. */

  /* Tipografia Ajustada */
  .hero__heading {
    max-width: 12ch;
    font-size: clamp(2.4rem, 8.5vw, 6.8rem);
    line-height: 0.98;
    margin: 0;
    color: var(--color-text-primary, #ffffff);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.55);
    text-wrap: balance;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  
  .hero__subheading {
    font-family: var(--font-ui-family, inherit);
    /* Era clamp(1.2rem, 3vw, var(--f2)). --f2 tem teto de 1rem, ou
       seja: o MINIMO era maior que o MAXIMO. Quando isso acontece o
       clamp() devolve sempre o minimo — o subtitulo ficava preso em
       1.2rem em toda tela, sem nenhuma fluidez, e ainda maior que
       um subtitulo deve ser. */
    font-size: clamp(0.875rem, 0.8rem + 0.4vw, 1.0625rem);
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: var(--tracking-label, 0.05em);
    text-transform: uppercase;
    color: var(--color-text-primary, #ffffff);
    margin: 0;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }
  
  /* O eyebrow e um rotulo de secao, nao um segundo titulo. Estava em
     1.1–1.4rem: maior que o subtitulo E que o texto de apoio, o que
     invertia a hierarquia inteira do hero (o olho batia no rotulo
     antes da manchete). Volta para a escala de microcopy do tema,
     que e onde .eyebrow vive em todas as outras secoes. */
  .hero__eyebrow {
    margin: 0;
    font-size: var(--f0);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }
  
  .hero__body {
    /* Mesmo clamp invertido do subtitulo: travava em 1.3rem, o que
       deixava o texto de APOIO maior que o subtitulo acima dele. */
    font-size: clamp(0.9375rem, 0.9rem + 0.25vw, 1.0625rem);
    line-height: 1.55;
    color: var(--color-text-secondary, rgba(255, 255, 255, 0.88));
    max-width: 42ch;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }
  .hero__body p { margin: 0 0 6px; }

  /* Botão CTA */
  .hero__cta {
    position: relative;
    z-index: 1;
    min-width: 180px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    transition:
      transform var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  /* O hover NAO esvazia mais o botao.
     Antes ele virava fantasma (fundo transparente, borda branca) por
     cima da fotografia — perdia contraste exatamente no gesto em que
     a pessoa esta prestes a clicar, e precisava de seis !important
     para vencer o .button do base.css. Agora ele apenas firma: fundo
     branco cheio, como manda o botao primario do sistema. */
  .hero__cta:hover {
    transform: translateY(-1px);
    background-color: var(--color-button-primary-background-hover);
    border-color: var(--color-button-primary-background-hover);
    color: var(--color-button-primary-text-hover);
  }

  .hero__cta:active {
    transform: translateY(0);
  }

  /* Indicador e Controles */
  .hero__indicator {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hero__counter {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-ui-family, inherit);
    font-size: var(--f1, 1.2rem);
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: var(--tracking-label, 0.05em);
    color: var(--color-text-primary, #ffffff);
    margin: 0;
  }

  .hero__counter-divider {
    opacity: 0.5;
  }

  .hero__counter-total { 
    color: var(--color-text-muted, rgba(255, 255, 255, 0.6)); 
  }

  .hero__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--color-text-secondary, rgba(255, 255, 255, 0.8));
    cursor: pointer;
    padding: 8px;
    opacity: 0.8;
    transition: opacity 200ms ease, color 200ms ease;
  }
  .hero__nav:hover, .hero__nav:focus-visible { opacity: 1; color: #ffffff; }
  .hero__nav svg { width: 16px; height: 16px; }

  /* Desktop Layout Controles */
  @media screen and (min-width: 750px) {
    .hero__indicator {
      right: var(--page-gutter, 24px);
      bottom: clamp(40px, 8vh, 80px);
      flex-direction: column;
      gap: 6px;
    }
    .hero__counter {
      flex-direction: column;
      gap: 6px;
    }
    .hero__counter-divider { display: none; }
    .hero__counter-total::before {
      content: '';
      display: block;
      width: 1px;
      height: 24px;
      margin: 0 auto 6px;
      background-color: var(--color-border-strong, rgba(255, 255, 255, 0.25));
    }
    [data-hero-prev] svg { transform: rotate(-90deg); }
    [data-hero-next] svg { transform: rotate(90deg); }
  }

  /* Mobile Layout Controles */
  @media screen and (max-width: 749px) {
    .hero__element--cta { width: 100%; }
    .hero__cta { width: 100%; justify-content: center; }
    
    .hero__indicator {
      bottom: max(16px, env(safe-area-inset-bottom, 16px));
      right: var(--page-gutter, 16px);
      left: auto;
      background-color: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      padding: 4px 8px;
      border-radius: 30px;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }
    
    [data-hero-prev] svg { transform: rotate(180deg); }
    [data-hero-next] svg { transform: rotate(0deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .hero__slide .hero__element { opacity: 1; }
    .js .hero__slide.is-active .hero__element,
    .hero__slide.is-active .hero__image { animation: none; }
    .hero__slide { transition-duration: 0.01ms !important; }
  }
</style>

{%- if slide_count > 1 -%}
  <script>
    (function () {
      var root = document.querySelector('[data-hero-carousel][data-section-id="{{ section.id }}"]');
      if (!root) return;

      var slides = Array.prototype.slice.call(root.querySelectorAll('[data-hero-slide]'));
      var current = root.querySelector('[data-hero-current]');
      var index = 0;

      function pad(n) { return (n < 10 ? '0' : '') + n; }

      function show(next) {
        index = (next + slides.length) % slides.length;
        slides.forEach(function (slide, i) {
          var active = i === index;
          slide.classList.toggle('is-active', active);
          if (active) {
            slide.removeAttribute('aria-hidden');
            slide.removeAttribute('inert');
          } else {
            slide.setAttribute('aria-hidden', 'true');
            slide.setAttribute('inert', '');
          }
        });
        if (current) current.textContent = pad(index + 1);
      }

      show(0);

      var prev = root.querySelector('[data-hero-prev]');
      var next = root.querySelector('[data-hero-next]');
      if (prev) prev.addEventListener('click', function (e) { e.preventDefault(); show(index - 1); });
      if (next) next.addEventListener('click', function (e) { e.preventDefault(); show(index + 1); });

      root.addEventListener('keydown', function (event) {
        if (event.key === 'ArrowLeft') { show(index - 1); }
        if (event.key === 'ArrowRight') { show(index + 1); }
      });

      /* Touch Suave para Mobile sem Travar Scroll Vertical */
      var startX = 0, startY = 0;
      root.addEventListener('touchstart', function (event) {
        startX = event.changedTouches[0].clientX;
        startY = event.changedTouches[0].clientY;
      }, { passive: true });

      root.addEventListener('touchend', function (event) {
        var dx = event.changedTouches[0].clientX - startX;
        var dy = event.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          show(dx < 0 ? index + 1 : index - 1);
        }
      }, { passive: true });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "options": [
        { "value": "short", "label": "t:sections.hero.settings.height.options__1.label" },
        { "value": "default", "label": "t:sections.hero.settings.height.options__2.label" },
        { "value": "tall", "label": "t:sections.hero.settings.height.options__3.label" }
      ],
      "default": "default",
      "label": "t:sections.hero.settings.height.label"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.hero.blocks.slide.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.hero.blocks.slide.settings.image.label" },
        { "type": "image_picker", "id": "image_mobile", "label": "t:sections.hero.blocks.slide.settings.image_mobile.label", "info": "t:sections.hero.blocks.slide.settings.image_mobile.info" },
        { "type": "text", "id": "eyebrow", "label": "t:sections.hero.blocks.slide.settings.eyebrow.label" },
        { "type": "textarea", "id": "heading", "label": "t:sections.hero.blocks.slide.settings.heading.label", "info": "t:sections.hero.blocks.slide.settings.heading.info" },
        { "type": "text", "id": "subheading", "label": "t:sections.hero.blocks.slide.settings.subheading.label" },
        { "type": "richtext", "id": "text", "label": "t:sections.hero.blocks.slide.settings.text.label" },
        { "type": "text", "id": "button_label", "label": "t:sections.hero.blocks.slide.settings.button_label.label" },
        { "type": "url", "id": "button_link", "label": "t:sections.hero.blocks.slide.settings.button_link.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}