  {
    "name": "t:settings_schema.product_cards.name",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "options": [
          {
            "value": "adapt",
            "label": "t:settings_schema.product_cards.settings.card_image_ratio.options__1.label"
          },
          {
            "value": "portrait",
            "label": "t:settings_schema.product_cards.settings.card_image_ratio.options__2.label"
          },
          {
            "value": "square",
            "label": "t:settings_schema.product_cards.settings.card_image_ratio.options__3.label"
          }
        ],
        "default": "portrait",
        "label": "t:settings_schema.product_cards.settings.card_image_ratio.label"
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "default": false,
        "label": "t:settings_schema.product_cards.settings.card_show_vendor.label"
      },
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "default": true,
        "label": "t:settings_schema.product_cards.settings.card_show_second_image.label"
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "default": true,
        "label": "t:settings_schema.product_cards.settings.card_quick_add.label",
        "info": "t:settings_schema.product_cards.settings.card_quick_add.info"
      }
    ]
  },
  {
    "name": "t:settings_schema.cart.name",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "options": [
          {
            "value": "drawer",
            "label": "t:settings_schema.cart.settings.cart_type.options__1.label"
          },
          {
            "value": "page",
            "label": "t:settings_schema.cart.settings.cart_type.options__2.label"
          }
        ],
        "default": "drawer",
        "label": "t:settings_schema.cart.settings.cart_type.label"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "default": true,
        "label": "t:settings_schema.cart.settings.cart_show_note.label"
      },
      {
        "type": "header",
        "content": "Frete grátis"
      },
      {
        "type": "paragraph",
        "content": "Vale para o carrinho lateral E para a página do carrinho — os dois leem daqui, para não mostrarem contas diferentes."
      },
      {
        "type": "checkbox",
        "id": "show_free_shipping",
        "default": true,
        "label": "Mostrar barra de progresso de frete grátis"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "default": 399,
        "label": "Valor para frete grátis",
        "info": "Em reais, sem centavos. Zero desliga a barra."
      }
    ]
  },
