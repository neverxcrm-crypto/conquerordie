{%- comment -%}
  ============================================================
  product-variant-selection — seleção de variante (client-side)
  ============================================================

  O QUE FAZ:
  Script que controla a seleção de variante na página de produto, sem
  depender de app: atualiza o id da variante (input hidden), o preço
  (HTML pré-renderizado por variante), o estado do botão "adicionar ao
  carrinho", troca a mídia em destaque e mantém ?variant na URL.
  Também controla os botões +/- do seletor de quantidade.

  COMO USAR:
  {% render 'product-variant-selection', section_id: section.id, product_form_id: product_form_id %}

  PARÂMETROS:
  - section_id: id da section (para achar [data-section-id] e a galeria).
  - product_form_id: id do <form> de compra do produto.

  OBSERVAÇÕES:
  Depende de marcações no HTML da section: [data-variant-json] com o JSON
  das variantes, .product__option com radios, .product-variant-id,
  .product__add-to-cart, .product__price e a galeria #ProductMedia-{section_id}.
{%- endcomment -%}
<script>
  (function () {
    var section = document.querySelector('[data-section-id="{{ section_id }}"]');
    if (!section) return;
    var form = document.getElementById('{{ product_form_id }}');
    var jsonEl = section.querySelector('[data-variant-json]');
    if (!form || !jsonEl) return;

    var menosMovimento = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var variants;
    try { variants = JSON.parse(jsonEl.textContent); } catch (e) { return; }

    var idInput = form.querySelector('.product-variant-id');
    var addButton = form.querySelector('.product__add-to-cart');
    var addButtonText = addButton ? addButton.querySelector('span') : null;
    var priceContainer = section.querySelector('.product__price');
    var gallery = document.getElementById('ProductMedia-{{ section_id }}');

    /* A barra fixa de compra do celular vive FORA da section (ver
       main-product.liquid), por isso a busca é no documento. */
    var barra = document.querySelector('[data-sticky-buy="{{ section_id }}"]');
    var barraPreco = barra ? barra.querySelector('[data-sticky-preco]') : null;
    var barraAdd = barra ? barra.querySelector('[data-sticky-add]') : null;

    var estoque = section.querySelector('[data-estoque]');
    var estoqueTexto = section.querySelector('[data-estoque-texto]');
    var qtdInput = section.querySelector('.quantity__input');

    var ADD = '{{ 'products.product.add_to_cart' | t }}';
    var SOLD_OUT = '{{ 'products.product.sold_out' | t }}';
    var UNAVAILABLE = '{{ 'products.product.unavailable' | t }}';

    function selectedOptions() {
      var opts = [];
      section.querySelectorAll('.product__option').forEach(function (fieldset) {
        var checked = fieldset.querySelector('input[type="radio"]:checked');
        if (checked) opts.push(checked.value);
      });
      return opts;
    }

    function findVariant(opts) {
      return variants.find(function (v) {
        return v.options.length === opts.length && v.options.every(function (o, i) { return o === opts[i]; });
      });
    }

    /* Os DOIS botões de compra mudam juntos.

       A barra fixa do celular era renderizada pelo servidor e nunca
       mais tocada: escolher um tamanho esgotado deixava o botão
       principal desabilitado e o da barra — que é o que o dedo
       alcança — continuava dizendo "adicionar ao carrinho". */
    function setButton(disabled, text) {
      [addButton, barraAdd].forEach(function (botao) {
        if (!botao) return;
        if (disabled) { botao.setAttribute('disabled', 'disabled'); }
        else { botao.removeAttribute('disabled'); }
        if (!text) return;
        var alvo = botao === addButton ? addButtonText : botao;
        if (alvo) alvo.textContent = text;
      });
    }

    /* ---------------------------------------------------------
       Disponibilidade por combinação — recalculada a cada escolha.

       O servidor marca um valor como esgotado quando NENHUMA
       variante com ele está disponível. Isso responde à pergunta
       errada depois do primeiro clique: escolhida a cor Preto, o
       tamanho P só interessa se existir "Preto / P" em estoque. Sem
       recalcular, a pessoa escolhia um tamanho aparentemente
       disponível e o botão morria sem explicar por quê.

       A regra é a mesma que as lojas grandes usam: um valor é
       testado mantendo o que já foi escolhido nas opções ANTERIORES
       e ignorando as posteriores — assim a fileira de cima nunca se
       tranca sozinha.
    --------------------------------------------------------- */
    function atualizarDisponibilidade() {
      var escolhidas = selectedOptions();

      section.querySelectorAll('.product__option').forEach(function (fieldset, indiceOpcao) {
        fieldset.querySelectorAll('input[type="radio"]').forEach(function (input) {
          var combinacao = escolhidas.slice();
          combinacao[indiceOpcao] = input.value;

          var existe = variants.some(function (v) {
            if (!v.available) return false;
            for (var i = 0; i <= indiceOpcao; i++) {
              if (combinacao[i] != null && v.options[i] !== combinacao[i]) return false;
            }
            return true;
          });

          var label = input.closest('.product__swatch');
          if (label) label.classList.toggle('is-unavailable', !existe);
          /* aria-disabled, não disabled: o valor continua escolhível
             (o cliente precisa saber que a peça existe), mas o leitor
             de tela avisa que aquela combinação está esgotada. */
          input.setAttribute('aria-disabled', existe ? 'false' : 'true');
        });
      });
    }

    function updateUI() {
      var variant = findVariant(selectedOptions());

      if (!variant) {
        setButton(true, UNAVAILABLE);
        if (idInput) { idInput.setAttribute('disabled', 'disabled'); }
        return;
      }

      if (idInput) { idInput.value = variant.id; idInput.removeAttribute('disabled'); }
      setButton(!variant.available, variant.available ? ADD : SOLD_OUT);

      /* Replace the whole price block with the store-formatted HTML.

         A troca era instantanea: o valor antigo virava o novo no
         mesmo quadro, sem nada dizendo que ALGO MUDOU. Quem troca de
         tamanho e ve um preco diferente precisa perceber a mudanca —
         e quem troca e ve o MESMO preco precisa perceber que a
         interface respondeu ao toque.

         A classe entra num no RECEM-CRIADO, entao a animacao dispara
         sozinha na insercao e nunca precisa ser removida: cada troca
         fabrica um elemento novo. Sem timers, sem estado preso. */
      if (priceContainer && variant.price_html) {
        var existing = priceContainer.querySelector('.price');
        if (existing) {
          var tmp = document.createElement('div');
          tmp.innerHTML = variant.price_html;
          var fresh = tmp.querySelector('.price');
          if (fresh) {
            if (!menosMovimento) fresh.classList.add('price--trocou');
            existing.replaceWith(fresh);
          }
        }
      }

      // O mesmo preço vai para a barra fixa do celular.
      if (barraPreco && variant.price_html) {
        barraPreco.innerHTML = variant.price_html;
        if (!menosMovimento) {
          var precoBarra = barraPreco.querySelector('.price');
          if (precoBarra) precoBarra.classList.add('price--trocou');
        }
      }

      /* Estoque: quem tem 2 peças é a VARIANTE, não o produto. O
         texto de cada uma já vem pronto do servidor (com plural
         resolvido pelo filtro `t`), então aqui é só trocar. */
      if (estoque) {
        if (variant.low_stock_html) {
          if (estoqueTexto) estoqueTexto.textContent = variant.low_stock_html;
          estoque.hidden = false;
        } else {
          estoque.hidden = true;
          if (estoqueTexto) estoqueTexto.textContent = '';
        }
      }

      /* O teto da quantidade acompanha a variante escolhida, e um
         valor já digitado acima do novo teto é puxado para baixo —
         senão a pessoa trocaria de tamanho e levaria um erro do
         Shopify no add, sem nada na tela explicando por quê. */
      if (qtdInput) {
        if (variant.max && variant.max > 0) {
          qtdInput.max = variant.max;
          qtdInput.setAttribute('data-max', variant.max);
          if ((parseInt(qtdInput.value, 10) || 1) > variant.max) qtdInput.value = variant.max;
        } else {
          qtdInput.removeAttribute('max');
          qtdInput.removeAttribute('data-max');
        }
      }

      // Parcelamento: o texto de cada variante vem pronto do servidor.
      var parcelas = section.querySelector('[data-parcelas]');
      if (parcelas && variant.installments_html) { parcelas.innerHTML = variant.installments_html; }

      /* Leva a galeria até a mídia da variante.
         'inline' entrou junto com 'block' porque no celular a galeria
         rola na HORIZONTAL: sem ele, escolher outra cor não mexia a
         foto — o eixo pedido não era o eixo que rola. */
      if (gallery && variant.featured_media_id) {
        var target = gallery.querySelector('[data-media-id="' + variant.featured_media_id + '"]');
        if (target) {
          try {
            target.scrollIntoView({
              behavior: menosMovimento ? 'auto' : 'smooth',
              block: 'nearest',
              inline: 'nearest'
            });
          } catch (e) {
            target.scrollIntoView();
          }
        }
      }

      // Keep the URL shareable.
      if (window.history && history.replaceState) {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        history.replaceState({}, '', url.toString());
      }
    }

    section.querySelectorAll('.product__option input[type="radio"]').forEach(function (input) {
      input.addEventListener('change', function () {
        var option = input.closest('.product__option');
        option.querySelectorAll('.product__swatch').forEach(function (l) { l.classList.remove('is-selected'); });
        var label = input.closest('.product__swatch');
        if (label) label.classList.add('is-selected');

        /* O nome do valor escolhido, ao lado do rótulo ("Cor: Preto").
           Num swatch de cor o círculo não diz o nome, e é o nome que a
           pessoa confere antes de comprar. */
        var indice = input.getAttribute('data-option-index');
        var rotulo = option.querySelector('[data-opcao-valor="' + indice + '"]');
        if (rotulo) rotulo.textContent = input.value;

        updateUI();
        atualizarDisponibilidade();
      });
    });

    // Primeira passada: alinha o que o servidor marcou com a
    // combinação realmente selecionada na abertura da página.
    atualizarDisponibilidade();

    section.querySelectorAll('.quantity-selector').forEach(function (sel) {
      var input = sel.querySelector('.quantity__input');
      var plus = sel.querySelector('[name="plus"]');
      var minus = sel.querySelector('[name="minus"]');
      /* dispatchEvent: sem ele o campo mudava de valor "por fora" e
         nada mais na página ficava sabendo — nem a validação nativa
         do próprio input. */
      function ajustar(delta) {
        var atual = parseInt(input.value || '1', 10);
        if (isNaN(atual)) atual = 1;
        var alvo = Math.max(1, atual + delta);
        // O "+" respeita o estoque da variante (data-max). Sem o
        // teto aqui, o botão passava do saldo sem nenhum atrito.
        var teto = parseInt(input.getAttribute('data-max'), 10);
        if (!isNaN(teto) && teto > 0) alvo = Math.min(alvo, teto);
        if (alvo === atual) return;
        input.value = alvo;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
      if (plus) plus.addEventListener('click', function () { ajustar(1); });
      if (minus) minus.addEventListener('click', function () { ajustar(-1); });
    });
  })();
</script>
