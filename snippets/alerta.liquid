{%- comment -%}
  ============================================================
  alerta — notificação global (toast) de sucesso/erro
  ============================================================

  O QUE FAZ:
  Renderiza o toast global fixo no canto da tela (HTML + CSS + JS) e expõe
  as funções globais mostrarAlerta() e fecharAlerta() no window. Suporta
  tipo positivo/negativo, auto-fechamento e fechar com ESC.

  COMO USAR:
  {% render 'alerta' %}   (inclua uma vez no layout, ex: theme.liquid)
  No JS da loja, dispare:
    mostrarAlerta('Produto adicionado!', 'positivo')
    mostrarAlerta('Algo deu errado', 'negativo', 5000)

  PARÂMETROS:
  Nenhum — renderizado diretamente. A interação é via funções JS globais:
  - mostrarAlerta(mensagem, tipo = 'positivo', duracao = 4000)
  - fecharAlerta()

  OBSERVAÇÕES:
  duracao em ms; use 0 para não fechar sozinho. Usa as variáveis de cor
  tokens semanticos --color-success, --color-error e --color-surface
  (definidos em css-variables).
{%- endcomment -%}
{%- comment -%}
  SEM aria-hidden: uma regiao aria-live marcada como aria-hidden nao
  e anunciada por leitor de tela nenhum. O JS tirava o atributo no
  mesmo instante em que escrevia o texto — tarde demais, porque a
  mutacao que dispara o anuncio ja tinha acontecido dentro de uma
  regiao escondida. Na pratica, NENHUM erro de carrinho era falado.

  Agora a regiao esta sempre na arvore de acessibilidade. Quem
  esconde o toast visualmente e o .conteudo (opacidade + transform),
  nao a regiao — e o texto so e escrito depois de a caixa estar
  visivel, que e a ordem que o leitor de tela espera.
{%- endcomment -%}
<div id="alerta" class="alerta-global" role="status" aria-live="polite" aria-atomic="true">
  <div class="conteudo">
    <div class="icone"></div>
    <div class="mensagem"></div>
    <button type="button" class="fechar" data-alerta-fechar aria-label="{{ 'accessibility.close' | t }}">&times;</button>
  </div>
</div>

<style>
  .alerta-global {
    position: fixed;
    /* Abaixo da pilha fixa do topo: com `top: 50px` o toast subia por
       cima da propria header. */
    top: calc(var(--header-height, 72px) + var(--aviso-altura, 0px) + var(--space-xs));
    right: var(--space-sm);
    z-index: 10001;
    opacity: 0;
    visibility: hidden;
    transform: translateX(calc(100% + 20px));
    /* `all` obrigava o navegador a vigiar TODA propriedade
       computada da caixa em busca de mudanca. Duas bastam. */
    transition:
      opacity var(--dur-emphasis) var(--ease-out),
      transform var(--dur-emphasis) var(--ease-out),
      visibility 0s linear var(--dur-emphasis);
    max-width: 400px;
    width: 90%;
  }

  .alerta-global.visivel {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    transition-delay: 0s;
  }

  .alerta-global .conteudo {
    display: flex;
    align-items: center;
    padding: var(--space-sm);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    box-shadow: 0 10px 30px var(--color-scrim);
    position: relative;
    overflow: hidden;
  }

  .alerta-global.positivo .conteudo {
    background-color: var(--color-surface);
    border-left: 2px solid var(--color-success);
    color: var(--color-text-primary);
  }

  .alerta-global.negativo .conteudo {
    background-color: var(--color-surface);
    border-left: 2px solid var(--color-error);
    color: var(--color-text-primary);
  }

  /* Havia aqui um ::before que atravessava a caixa animando `left`
     de -100% a 100%. Ele tinha `background: none` — ou seja, era
     invisivel — e `left` e propriedade de LAYOUT: o navegador
     recalculava a caixa a cada quadro durante 800ms para desenhar
     nada. Removido. */

  .alerta-global .icone {
    width: 24px;
    height: 24px;
    margin-right: var(--space-xs);
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }

  .alerta-global.positivo .icone::before {
    content: '✓';
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--color-success);
    background-color: var(--color-accent-muted);
    border-radius: 50%;
    font-family: var(--font-ui-family);
    font-size: var(--f2);
    font-weight: var(--font-weight-semibold);
  }

  .alerta-global.negativo .icone::before {
    content: '⚠';
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--color-error);
    background-color: var(--color-accent-muted);
    border-radius: 50%;
    font-family: var(--font-ui-family);
    font-size: var(--f2);
    font-weight: var(--font-weight-semibold);
  }

  .alerta-global .mensagem {
    flex: 1;
    font-family: var(--font-ui-family);
    font-size: var(--f2);
    line-height: 1.4;
    position: relative;
    z-index: 2;
  }

  .alerta-global .fechar {
    width: 30px;
    height: 30px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-text-secondary);
    font-family: var(--font-ui-family);
    font-size: var(--f3);
    line-height: 1;
    cursor: pointer;
    margin-left: var(--space-xs);
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    transition:
      background-color var(--dur-normal) var(--ease-out),
      border-color var(--dur-normal) var(--ease-out),
      color var(--dur-normal) var(--ease-out);
  }

  .alerta-global .fechar:hover {
    background: var(--color-surface-elevated);
    border-color: var(--color-border-strong);
    color: var(--color-text-primary);
  }

  /* (Havia @keyframes slideIn e slideOut declarados aqui. Nenhuma
     regra os aplicava: a entrada e a saida sempre foram feitas pela
     transition de .visivel. Codigo morto, removido.) */

  /* Responsivo */
  @media (max-width: 768px) {
    .alerta-global {
      top: calc(var(--header-height, 64px) + var(--aviso-altura, 0px) + var(--space-2xs));
      right: var(--space-xs);
      left: var(--space-xs);
      width: auto;
      max-width: none;
    }

    .alerta-global .conteudo {
      padding: var(--space-xs) var(--space-sm);
    }

    .alerta-global .mensagem {
      font-size: var(--f1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .alerta-global { transition-duration: 0.01ms; }
  }
</style>

<script>
  var alertaTimeout = null;

  function mostrarAlerta(mensagem, tipo, duracao) {
    tipo = tipo || 'positivo';
    duracao = typeof duracao === 'number' ? duracao : 4000;
    var alerta = document.getElementById('alerta');
    if (!alerta) return;
    var mensagemEl = alerta.querySelector('.mensagem');

    // Limpar timeout anterior se existir
    if (alertaTimeout) {
      clearTimeout(alertaTimeout);
    }

    // Fechar alerta atual se estiver visível
    if (alerta.classList.contains('visivel')) {
      fecharAlerta();
      // Aguardar a animação de fechamento antes de mostrar o novo
      setTimeout(function () {
        exibirNovoAlerta(alerta, mensagemEl, mensagem, tipo, duracao);
      }, 400);
    } else {
      exibirNovoAlerta(alerta, mensagemEl, mensagem, tipo, duracao);
    }
  }

  function exibirNovoAlerta(alerta, mensagemEl, mensagem, tipo, duracao) {
    // Remover classes anteriores
    alerta.classList.remove('positivo', 'negativo');

    // Adicionar classe do tipo
    alerta.classList.add(tipo);

    /* Mostrar PRIMEIRO, escrever DEPOIS.
       O leitor de tela anuncia a mudança de texto de uma região
       aria-live; se o texto muda enquanto a região ainda está
       invisível, o anúncio se perde. Por isso a caixa aparece e o
       texto entra no quadro seguinte. */
    alerta.classList.add('visivel');
    requestAnimationFrame(function () {
      mensagemEl.textContent = mensagem;
    });

    // Auto-fechar após a duração especificada
    if (duracao > 0) {
      alertaTimeout = setTimeout(function () {
        fecharAlerta();
      }, duracao);
    }
  }

  function fecharAlerta() {
    var alerta = document.getElementById('alerta');
    if (!alerta) return;
    alerta.classList.remove('visivel');

    // Limpar timeout se existir
    if (alertaTimeout) {
      clearTimeout(alertaTimeout);
      alertaTimeout = null;
    }
  }

  // Fechar com tecla ESC — só quando há algo aberto, para não
  // competir com o Esc do carrinho e do menu.
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    var alerta = document.getElementById('alerta');
    if (alerta && alerta.classList.contains('visivel')) fecharAlerta();
  });

  var botaoFechar = document.querySelector('[data-alerta-fechar]');
  if (botaoFechar) botaoFechar.addEventListener('click', fecharAlerta);

  // Tornar função global
  window.mostrarAlerta = mostrarAlerta;
  window.fecharAlerta = fecharAlerta;
</script>
