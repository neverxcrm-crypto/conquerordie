{% doc %}
  @prompt
    Crie uma seção de instagram, com posts e um reels de destaque
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-instagram-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_spacing }}px 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.body_font.family }};
  }

  .ai-instagram-{{ ai_gen_id }}__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }

  .ai-instagram-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 8px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .ai-instagram-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.display_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
  }

  .ai-instagram-{{ ai_gen_id }}__follow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 18px;
    border: 1px solid {{ block.settings.accent_color }};
    border-radius: {{ block.settings.button_radius }}px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: 13px;
    white-space: nowrap;
  }

  .ai-instagram-{{ ai_gen_id }}__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 16px;
  }

  .ai-instagram-{{ ai_gen_id }}__reel,
  .ai-instagram-{{ ai_gen_id }}__post {
    position: relative;
    display: block;
    overflow: hidden;
    background: {{ block.settings.surface_color }};
    border-radius: {{ block.settings.media_radius }}px;
  }

  .ai-instagram-{{ ai_gen_id }}__reel { min-height: 100%; }
  .ai-instagram-{{ ai_gen_id }}__reel img,
  .ai-instagram-{{ ai_gen_id }}__post img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ai-instagram-{{ ai_gen_id }}__reel img { aspect-ratio: 4 / 5; }
  .ai-instagram-{{ ai_gen_id }}__post img { aspect-ratio: 1; }

  .ai-instagram-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 220px;
    color: {{ block.settings.muted_color }};
  }
  .ai-instagram-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; max-height: 420px; }

  .ai-instagram-{{ ai_gen_id }}__posts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .ai-instagram-{{ ai_gen_id }}__reel-label {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: rgba(0, 0, 0, .78);
    border-radius: 999px;
    color: #fff;
    font-size: 12px;
  }

  .ai-instagram-{{ ai_gen_id }}__play {
    width: 0;
    height: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 7px solid {{ block.settings.accent_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-instagram-{{ ai_gen_id }} { width: 100%; padding: 28px 16px; }
    .ai-instagram-{{ ai_gen_id }}__header { align-items: flex-start; flex-direction: column; }
    .ai-instagram-{{ ai_gen_id }}__layout { grid-template-columns: 1fr; }
  }
{% endstyle %}

<div class="ai-instagram-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-instagram-{{ ai_gen_id }}__header">
    <div>
      {% if block.settings.eyebrow != blank %}<p class="ai-instagram-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
      <h2 class="ai-instagram-{{ ai_gen_id }}__title">{{ block.settings.title }}</h2>
    </div>
    {% if block.settings.instagram_link != blank %}<a class="ai-instagram-{{ ai_gen_id }}__follow" href="{{ block.settings.instagram_link }}" target="_blank" rel="noopener">{{ block.settings.button_label }}</a>{% endif %}
  </div>

  <div class="ai-instagram-{{ ai_gen_id }}__layout">
    <a class="ai-instagram-{{ ai_gen_id }}__reel" href="{{ block.settings.reel_link | default: block.settings.instagram_link }}" target="_blank" rel="noopener">
      {% if block.settings.reel_image %}
        <img src="{{ block.settings.reel_image | image_url: width: 1200 }}" alt="{{ block.settings.reel_image.alt | escape }}" loading="lazy" width="{{ block.settings.reel_image.width }}" height="{{ block.settings.reel_image.height }}">
      {% else %}
        <div class="ai-instagram-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {% endif %}
      <span class="ai-instagram-{{ ai_gen_id }}__reel-label"><span class="ai-instagram-{{ ai_gen_id }}__play"></span>{{ block.settings.reel_label }}</span>
    </a>

    <div class="ai-instagram-{{ ai_gen_id }}__posts">
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'post_' | append: i | append: '_image'
          assign link_key = 'post_' | append: i | append: '_link'
          assign post_image = block.settings[image_key]
          assign post_link = block.settings[link_key]
        %}
        <a class="ai-instagram-{{ ai_gen_id }}__post" href="{{ post_link | default: block.settings.instagram_link }}" target="_blank" rel="noopener">
          {% if post_image %}
            <img src="{{ post_image | image_url: width: 700 }}" alt="{{ post_image.alt | escape }}" loading="lazy" width="{{ post_image.width }}" height="{{ post_image.height }}">
          {% else %}
            <div class="ai-instagram-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Instagram com reels",
  "settings": [
    { "type": "header", "content": "Conteúdo" },
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Siga nosso universo" },
    { "type": "text", "id": "title", "label": "Título", "default": "Da nossa comunidade" },
    { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Seguir no Instagram" },
    { "type": "url", "id": "instagram_link", "label": "Link do Instagram" },
    { "type": "image_picker", "id": "reel_image", "label": "Imagem do reels" },
    { "type": "text", "id": "reel_label", "label": "Etiqueta do reels", "default": "Reels em destaque" },
    { "type": "url", "id": "reel_link", "label": "Link do reels" },
    { "type": "header", "content": "Posts" },
    { "type": "image_picker", "id": "post_1_image", "label": "Post 1" },
    { "type": "url", "id": "post_1_link", "label": "Link do post 1" },
    { "type": "image_picker", "id": "post_2_image", "label": "Post 2" },
    { "type": "url", "id": "post_2_link", "label": "Link do post 2" },
    { "type": "image_picker", "id": "post_3_image", "label": "Post 3" },
    { "type": "url", "id": "post_3_link", "label": "Link do post 3" },
    { "type": "image_picker", "id": "post_4_image", "label": "Post 4" },
    { "type": "url", "id": "post_4_link", "label": "Link do post 4" },
    { "type": "header", "content": "Estilo" },
    { "type": "range", "id": "desktop_width_percent", "label": "Largura no desktop", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "section_spacing", "label": "Espaçamento vertical", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "heading_size", "label": "Tamanho do título", "min": 20, "max": 56, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "media_radius", "label": "Arredondamento das imagens", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "button_radius", "label": "Arredondamento do botão", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 6 },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Destaque", "default": "#C9A24D" },
    { "type": "color", "id": "surface_color", "label": "Fundo das imagens", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Texto auxiliar", "default": "#C4C4C0" },
    { "type": "font_picker", "id": "display_font", "label": "Fonte do título", "default": "playfair_display_n4" },
    { "type": "font_picker", "id": "body_font", "label": "Fonte do texto", "default": "inter_n4" }
  ],
  "presets": [{ "name": "Instagram com reels" }],
  "tag": null,
  "class": "instagram-feature-block"
}
{% endschema %}