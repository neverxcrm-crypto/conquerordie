{% doc %}
  @prompt
    crie um liquid personalizado com as seguintes APIS:
    
    <div data-neverx-reviews data-mode="full" data-channel="shopify" data-external="{{ product.id }}" data-placement="product_page" data-nx-source="snippet"></div>
    <script>window.__nxReviewsLoader||(window.__nxReviewsLoader=1,document.head.appendChild(Object.assign(document.createElement("script"),{src:"https://app.neverxcrm.online/api/public/reviews/feed/u9etWTHEwp28nOEx85T-aqpb/widget",async:!0})));</script>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-neverx-reviews-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #0A0A0A;
  }
{% endstyle %}

<div class="ai-neverx-reviews-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if product != blank %}
    <div
      data-neverx-reviews
      data-mode="full"
      data-channel="shopify"
      data-external="{{ product.id }}"
      data-placement="product_page"
      data-nx-source="snippet"
    ></div>
  {% endif %}
</div>

<script>
  (function() {
    if (!window.__nxReviewsLoader) {
      window.__nxReviewsLoader = 1;
      var loader = document.createElement('script');
      loader.src = 'https://app.neverxcrm.online/api/public/reviews/feed/u9etWTHEwp28nOEx85T-aqpb/widget';
      loader.async = true;
      document.head.appendChild(loader);
    }
  })();
</script>

{% schema %}
{
  "name": "NeverX product reviews",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "NeverX product reviews"
    }
  ],
  "tag": null,
  "class": "neverx-reviews-block"
}
{% endschema %}